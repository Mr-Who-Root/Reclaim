        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在此 Mac 上思考…"
          }
        }
      }
    },
    "This folder is empty or everything in it is unreadable.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا المجلد فارغ أو أن كل ما فيه غير قابل للقراءة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ordner ist leer oder sein gesamter Inhalt ist nicht lesbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta carpeta está vacía o no se puede leer nada de su contenido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier est vide ou tout son contenu est illisible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ोल्डर ख़ाली है या इसकी कोई भी चीज़ पढ़ी नहीं जा सकती।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder ini kosong atau semua isinya tidak dapat dibaca."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa cartella è vuota o il suo contenuto non è leggibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダは空か、中身をすべて読み取れません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더는 비어 있거나 안의 모든 항목을 읽을 수 없습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫോൾഡർ ശൂന്യമാണ്, അല്ലെങ്കിൽ ഇതിലുള്ളതൊന്നും വായിക്കാനാകില്ല."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze map is leeg of alles erin is onleesbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten katalog jest pusty lub nie można odczytać niczego, co zawiera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pasta está vazia ou tudo nela está ilegível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта папка пуста, или все ее содержимое недоступно для чтения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappen är tom eller så går inget i den att läsa."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் கோப்புறை காலியாக உள்ளது, அல்லது இதில் உள்ள எதையும் படிக்க முடியவில்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โฟลเดอร์นี้ว่างเปล่า หรืออ่านสิ่งที่อยู่ข้างในไม่ได้ทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu klasör boş veya içindeki her şey okunamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця папка порожня, або весь її вміст недоступний для читання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư mục này trống hoặc không đọc được nội dung bên trong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件夹为空，或其中所有内容都无法读取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案夾是空的，或其中的內容都無法讀取。"
          }
        }
      }
    },
    "This is the final confirmation and begins only the actions in your plan.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا هو التأكيد النهائي، ولن يبدأ إلا الإجراءات الواردة في خطتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist die abschließende Bestätigung und startet nur die Aktionen in deinem Plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es la confirmación final e inicia solo las acciones de tu plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il s'agit de la confirmation finale ; elle lance uniquement les actions de votre plan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह अंतिम पुष्टि है और केवल आपकी योजना की कार्रवाइयाँ शुरू करती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini adalah konfirmasi akhir dan hanya memulai tindakan dalam rencana Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa è la conferma finale e avvia solo le azioni del piano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは最終確認です。プラン内の操作のみを開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최종 확인 단계이며, 계획에 포함된 작업만 시작합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതാണ് അന്തിമ സ്ഥിരീകരണം, ഇത് നിങ്ങളുടെ പ്ലാനിലെ പ്രവർത്തനങ്ങൾ മാത്രം ആരംഭിക്കുന്നു."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is de laatste bevestiging en start alleen de acties in je plan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To ostateczne potwierdzenie — rozpoczyna wyłącznie czynności z planu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é a confirmação final e inicia apenas as ações do seu plano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это окончательное подтверждение; будут выполнены только действия из плана."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta är den slutliga bekräftelsen och startar bara åtgärderna i din plan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது இறுதி உறுதிப்படுத்தல், உங்கள் திட்டத்தில் உள்ள செயல்களை மட்டுமே தொடங்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือการยืนยันขั้นสุดท้าย และจะเริ่มเฉพาะการดำเนินการในแผนของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu son onaydır ve yalnızca planınızdaki işlemleri başlatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це остаточне підтвердження; буде виконано лише дії з плану."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là bước xác nhận cuối cùng và chỉ bắt đầu các thao tác trong kế hoạch của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是最终确认，只会开始执行你计划中的操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是最終確認，只會開始執行您計畫中的動作。"
          }
        }
      }
    },
    "This moves the whole folder, including %@. It stays recoverable in the Trash until you empty it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى نقل المجلد بأكمله، بما في ذلك %@. يبقى قابلًا للاسترداد في سلة المهملات حتى تفرغها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird der gesamte Ordner verschoben, einschließlich %@. Er bleibt im Papierkorb wiederherstellbar, bis du ihn entleerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se trasladará toda la carpeta, incluidos %@. Se podrá recuperar de la Papelera hasta que la vacíes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela déplace le dossier entier, y compris %@. Il reste récupérable dans la Corbeille jusqu'à ce que vous la vidiez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे %@ सहित पूरा फ़ोल्डर ट्रैश में चला जाता है। जब तक आप ट्रैश ख़ाली नहीं करते, इसे वहाँ से वापस पाया जा सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan memindahkan seluruh folder, termasuk %@. Folder tetap dapat dipulihkan di Tong Sampah hingga Anda mengosongkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene spostata l'intera cartella, incluso %@. Resta recuperabile nel Cestino finché non lo svuoti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を含むフォルダ全体を移動します。ゴミ箱を空にするまで復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 포함한 폴더 전체가 이동됩니다. 휴지통을 비우기 전까지 복구할 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് %@ ഉൾപ്പെടെ മുഴുവൻ ഫോൾഡറും നീക്കുന്നു. നിങ്ങൾ ട്രാഷ് ശൂന്യമാക്കുന്നത് വരെ ഇത് അവിടെ നിന്ന് വീണ്ടെടുക്കാനാകും."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt de hele map verplaatst, inclusief %@. Deze blijft herstelbaar in de prullenmand totdat je die leegt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to przeniesienie całego katalogu, w tym %@. Będzie można go odzyskać z Kosza, dopóki Kosz nie zostanie opróżniony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso move a pasta inteira, incluindo %@. Ela pode ser recuperada no Lixo até você esvaziá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будет перемещена вся папка, включая %@. Папку можно восстановить из Корзины, пока Вы ее не очистите."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta flyttar hela mappen, inklusive %@. Mappen kan återställas från papperskorgen tills du tömmer den."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது %@ உட்பட முழுக் கோப்புறையையும் நகர்த்தும். நீங்கள் காலியாக்கும் வரை இது குப்பைத் தொட்டியில் மீட்டெடுக்கக்கூடியதாக இருக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะย้ายทั้งโฟลเดอร์ รวมถึง %@ ซึ่งยังกู้คืนได้จากถังขยะจนกว่าคุณจะล้างถังขยะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem, %@ dahil tüm klasörü taşır. Siz boşaltana kadar Çöp Sepetinde kurtarılabilir durumda kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Буде переміщено всю папку, зокрема %@. Її можна відновити зі Смітника, доки ви його не спорожните."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này di chuyển toàn bộ thư mục, bao gồm %@. Thư mục vẫn có thể khôi phục từ Thùng rác cho đến khi bạn dọn sạch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会移动整个文件夹，包括 %@。在你清倒废纸篓之前，它都可以从废纸篓中恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會移動整個檔案夾，包括 %@。在您清空垃圾桶之前，都可以從垃圾桶回復。"
          }
        }
      }
    },
    "This permanently deletes everything in the Trash, including items other apps put there. It can't be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف كل ما في سلة المهملات نهائيًا، بما في ذلك العناصر التي وضعتها تطبيقات أخرى. لا يمكن التراجع عن ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird alles im Papierkorb endgültig gelöscht, auch Objekte, die andere Apps dort abgelegt haben. Dies kann nicht widerrufen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará de forma permanente todo lo que hay en la Papelera, incluidos los elementos que pusieron otras apps. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement tout le contenu de la Corbeille, y compris les éléments placés par d'autres apps. Cette action est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे ट्रैश की हर चीज़ स्थायी रूप से डिलीट हो जाती है, अन्य ऐप्स द्वारा वहाँ रखे गए आइटम सहित। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menghapus secara permanen semua isi Tong Sampah, termasuk item yang dimasukkan app lain. Tindakan ini tidak dapat diurungkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina definitivamente tutto il contenuto del Cestino, inclusi gli elementi inseriti da altre app. L'operazione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの App が入れた項目も含め、ゴミ箱内のすべてを完全に削除します。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱이 넣은 항목을 포함하여 휴지통의 모든 항목이 영구적으로 삭제됩니다. 이 작업은 실행 취소할 수 없습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മറ്റ് ആപ്പുകൾ ഇട്ട ഇനങ്ങൾ ഉൾപ്പെടെ, ട്രാഷിലുള്ളതെല്ലാം ഇത് ശാശ്വതമായി ഇല്ലാതാക്കുന്നു. ഇത് പഴയപടിയാക്കാനാകില്ല."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt alles in de prullenmand definitief verwijderd, ook onderdelen die andere apps daar hebben geplaatst. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to trwałe usunięcie całej zawartości Kosza, w tym rzeczy umieszczonych tam przez inne aplikacje. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso apaga permanentemente tudo o que está no Lixo, incluindo itens colocados por outros apps. Não é possível desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все содержимое Корзины, включая объекты, помещенные туда другими приложениями, будет удалено навсегда. Это действие нельзя отменить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta raderar permanent allt i papperskorgen, inklusive objekt som andra appar har lagt där. Det går inte att ångra."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது பிற ஆப்ஸ் வைத்த உருப்படிகள் உட்பட, குப்பைத் தொட்டியில் உள்ள அனைத்தையும் நிரந்தரமாக நீக்கும். இதைச் செயல்தவிர்க்க முடியாது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะลบทุกอย่างในถังขยะอย่างถาวร รวมถึงรายการที่แอปอื่นใส่ไว้ และไม่สามารถเลิกทำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem, diğer uygulamaların koyduğu öğeler dahil Çöp Sepetindeki her şeyi kalıcı olarak siler. Geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увесь вміст Смітника, зокрема елементи, які туди помістили інші програми, буде видалено назавжди. Цю дію не можна відмінити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này xóa vĩnh viễn mọi thứ trong Thùng rác, kể cả các mục do ứng dụng khác đặt vào. Bạn không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会永久删除废纸篓中的所有内容，包括其他应用放入的项目。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會永久刪除垃圾桶中的所有項目，包括其他 App 放入的項目。此動作無法還原。"
          }
        }
      }
    },
    "This permanently deletes the data inside these volumes. It doesn't go to the Trash and can't be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف البيانات داخل وحدات التخزين هذه نهائيًا. لن تنتقل إلى سلة المهملات ولا يمكن التراجع عن ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden die Daten in diesen Volumes endgültig gelöscht. Sie landen nicht im Papierkorb. Dies kann nicht widerrufen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán de forma permanente los datos de estos volúmenes. No pasan por la Papelera y no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement les données de ces volumes. Elles ne passent pas par la Corbeille et l'opération est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे इन वॉल्यूम के अंदर का डेटा स्थायी रूप से डिलीट हो जाता है। यह ट्रैश में नहीं जाता और इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menghapus data di dalam volume ini secara permanen. Data tidak masuk ke Tong Sampah dan tidak dapat diurungkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati contenuti in questi volumi verranno eliminati definitivamente. Non finiscono nel Cestino e l'operazione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのボリューム内のデータを完全に削除します。ゴミ箱には入らず、取り消すこともできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 볼륨 안의 데이터가 영구적으로 삭제됩니다. 휴지통으로 이동하지 않으며 실행 취소할 수 없습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ വോള്യങ്ങൾക്കുള്ളിലെ ഡാറ്റ ഇത് ശാശ്വതമായി ഇല്ലാതാക്കുന്നു. അത് ട്രാഷിലേക്ക് പോകില്ല, പഴയപടിയാക്കാനുമാകില്ല."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden de gegevens in deze volumes definitief verwijderd. Ze gaan niet naar de prullenmand en dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to trwałe usunięcie danych z tych wolumenów. Nie trafią one do Kosza i tej operacji nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso apaga permanentemente os dados desses volumes. Eles não vão para o Lixo e não é possível desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные внутри этих томов будут удалены навсегда. Они не попадут в Корзину, и это действие нельзя отменить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta raderar datan i de här volymerna permanent. Den hamnar inte i papperskorgen och det går inte att ångra."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது இந்த வால்யூம்களுக்குள் உள்ள தரவை நிரந்தரமாக நீக்கும். அது குப்பைத் தொட்டிக்குச் செல்லாது, செயல்தவிர்க்கவும் முடியாது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะลบข้อมูลภายในวอลุ่มเหล่านี้อย่างถาวร ข้อมูลจะไม่ไปที่ถังขยะและไม่สามารถเลิกทำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem, bu volume'ların içindeki verileri kalıcı olarak siler. Veriler Çöp Sepetine gitmez ve işlem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані всередині цих томів буде видалено назавжди. Вони не потраплять у Смітник, і цю дію не можна відмінити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này xóa vĩnh viễn dữ liệu bên trong các volume này. Dữ liệu không vào Thùng rác và không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会永久删除这些卷中的数据。数据不会进入废纸篓，且无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會永久刪除這些磁碟區中的資料。資料不會移到垃圾桶，也無法還原。"
          }
        }
      }
    },
    "Tidy up your photos": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رتّب صورك"
          }
        },
        "de": {

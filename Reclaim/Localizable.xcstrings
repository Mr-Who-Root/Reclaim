        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കാഷെകളും ലോഗുകളും ഇപ്പോൾ എല്ലാം ചെറുതാണ്. %@ സ്കാൻ ചെയ്തു."
          }
        },
        "nl": {

    "Keeper, never removed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محتفَظ بها، لا تُزال أبدًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird behalten, nie entfernt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conserva, nunca se elimina"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservé, jamais supprimé"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रखी जाने वाली कॉपी, कभी नहीं हटाई जाती"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disimpan, tidak pernah dihapus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da conservare, mai rimosso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残すファイル（削除されません）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유지 항목, 제거되지 않음"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സൂക്ഷിക്കുന്നത്, ഒരിക്കലും നീക്കം ചെയ്യില്ല"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt bewaard, nooit verwijderd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopia zachowywana, nigdy nieusuwana"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cópia mantida, nunca removida"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняется, никогда не удаляется"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behålls, tas aldrig bort"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வைத்திருக்கும் நகல், ஒருபோதும் அகற்றப்படாது"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำเนาที่เก็บไว้ จะไม่ถูกเอาออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saklanacak, asla kaldırılmaz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишається, ніколи не видаляється"
          }
        },

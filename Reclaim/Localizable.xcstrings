        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara när den hittar minst"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குறைந்தது இவ்வளவு கண்டறிந்தால் மட்டும்"
          }
        },
        "th": {

    "Python packages pip downloaded or built. pip fetches them again when needed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Python-Pakete, die pip geladen oder erstellt hat. pip lädt sie bei Bedarf erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paquetes de Python que pip descargó o compiló. pip los vuelve a descargar cuando hace falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paquets Python téléchargés ou compilés par pip. pip les récupère à nouveau au besoin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "pip द्वारा डाउनलोड या बिल्ड किए गए Python पैकेज। ज़रूरत पड़ने पर pip इन्हें फिर से ले आता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "pip がダウンロードまたはビルドした Python パッケージです。必要に応じて pip が再取得します。"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "pip ഡൗൺലോഡ് ചെയ്തതോ ബിൽഡ് ചെയ്തതോ ആയ Python പാക്കേജുകൾ. ആവശ്യമുള്ളപ്പോൾ pip അവ വീണ്ടും ലഭ്യമാക്കും."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "pip பதிவிறக்கிய அல்லது உருவாக்கிய Python தொகுப்புகள். தேவைப்படும்போது pip அவற்றை மீண்டும் பெறும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "pip 下载或构建的 Python 软件包。需要时 pip 会重新获取。"
          }
        }
      }
    },

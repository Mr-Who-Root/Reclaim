            "value": "このレビューについて質問"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ അവലോകനത്തെക്കുറിച്ച് ചോദിക്കുക"
          }
        },
        "ta": {
          "stringUnit": {

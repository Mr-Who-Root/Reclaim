    "Aider's index of this repository. It's rebuilt automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiders Index dieses Repositorys. Er wird automatisch neu erstellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El índice de Aider de este repositorio. Se regenera automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'index de ce dépôt créé par Aider. Il est reconstruit automatiquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस रिपॉज़िटरी का Aider इंडेक्स। यह अपने आप फिर से बन जाता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Aider が作成したこのリポジトリのインデックスです。自動的に再作成されます。"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ റിപ്പോസിറ്ററിയുടെ Aider ഇൻഡക്സ്. ഇത് സ്വയമേവ പുനർനിർമ്മിക്കപ്പെടും."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் களஞ்சியத்துக்கான Aider இன் அட்டவணை (index). இது தானாகவே மீண்டும் உருவாக்கப்படும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Aider 为此仓库建立的索引，会自动重建。"
          }
        }
      }
    },

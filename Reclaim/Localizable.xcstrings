    "No look-alikes, screenshots, recordings or blurry shots in %@. Scanned %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد صور متشابهة أو لقطات شاشة أو تسجيلات أو صور ضبابية في %@. تم الفحص %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine ähnlichen Aufnahmen, Bildschirmfotos, Bildschirmaufnahmen oder unscharfen Fotos in %@. Letzter Scan %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "No look-alikes, screenshots, recordings or blurry shots in %1$@. Scanned %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay fotos similares, capturas, grabaciones ni fotos borrosas en %@. Analizado %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune photo similaire, capture d'écran, aucun enregistrement ni aucune photo floue dans %@. Dernière analyse %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ में कोई मिलती-जुलती फ़ोटो, स्क्रीनशॉट, रिकॉर्डिंग या धुंधली तस्वीर नहीं। %@ स्कैन किया गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada foto mirip, jepretan layar, rekaman, atau foto buram di %@. Dipindai %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna foto simile, istantanea, registrazione o scatto sfocato in %@. Ultima scansione: %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 内に類似写真、スクリーンショット、画面収録、ぼやけた写真はありません（スキャン: %@）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 유사한 사진, 스크린샷, 화면 기록 또는 흐릿한 사진이 없습니다. %@ 스캔함."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-ൽ സമാന ചിത്രങ്ങളോ സ്ക്രീൻഷോട്ടുകളോ റെക്കോർഡിംഗുകളോ മങ്ങിയ ഷോട്ടുകളോ ഇല്ല. %@ സ്കാൻ ചെയ്തു."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen gelijkende foto's, schermafbeeldingen, opnamen of onscherpe foto's in %@. Gescand %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak podobnych ujęć, zrzutów ekranu, nagrań ani rozmazanych zdjęć w: %@. Przeskanowano %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma foto semelhante, captura de tela, gravação ou foto desfocada em %@. Analisado %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: нет похожих фото, снимков и записей экрана или размытых фото. Просканировано %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga liknande bilder, skärmavbilder, inspelningar eller suddiga bilder i %@. Skannades %@."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ இல் ஒத்த படங்கள், ஸ்கிரீன்ஷாட்கள், பதிவுகள் அல்லது மங்கலான படங்கள் இல்லை. %@ ஸ்கேன் செய்யப்பட்டது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีภาพที่คล้ายกัน ภาพหน้าจอ การบันทึก หรือภาพเบลอใน %@ สแกนเมื่อ %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ içinde benzer, ekran görüntüsü, kayıt veya bulanık çekim yok. %@ tarandı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: немає схожих фото, знімків і записів екрана чи розмитих фото. Проскановано %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có ảnh tương tự, ảnh chụp màn hình, bản ghi hay ảnh mờ trong %@. Đã quét %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 中没有相似照片、截屏、录屏或模糊照片。上次扫描：%@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 中沒有相似照片、截圖、錄影或模糊照片。掃描於 %@。"
          }
        }
      }
    },

          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "AI கருவிகள் விட்டுச்சென்றவற்றில் எதற்கும் உங்கள் கவனம் தேவையில்லை. %@ ஸ்கேன் செய்யப்பட்டது."

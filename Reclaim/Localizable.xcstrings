    "Compiled kernels PyTorch rebuilds on demand.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نوى مُصرَّفة يعيد PyTorch إنشاءها عند الحاجة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompilierte Kernel, die PyTorch bei Bedarf neu erstellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kernels compilados que PyTorch regenera cuando los necesita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noyaux compilés que PyTorch reconstruit à la demande."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंपाइल किए गए कर्नेल, जिन्हें PyTorch ज़रूरत पड़ने पर फिर से बनाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kernel terkompilasi yang dibuat ulang PyTorch sesuai kebutuhan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Kernel compilati che PyTorch ricrea quando servono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PyTorch が必要に応じて再作成するコンパイル済みカーネルです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PyTorch가 필요할 때 다시 빌드하는 컴파일된 커널입니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആവശ്യാനുസരണം PyTorch പുനർനിർമ്മിക്കുന്ന കംപൈൽ ചെയ്ത കേർണലുകൾ."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gecompileerde kernels die PyTorch zo nodig opnieuw opbouwt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skompilowane jądra, które PyTorch odtwarza na żądanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Kernels compilados que o PyTorch recria quando necessário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скомпилированные ядра, которые PyTorch пересобирает по требованию."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompilerade kärnor som PyTorch bygger om vid behov."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "PyTorch தேவைக்கேற்ப மீண்டும் உருவாக்கும் தொகுக்கப்பட்ட kernels."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เคอร์เนลที่คอมไพล์แล้วซึ่ง PyTorch สร้างใหม่เมื่อต้องการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PyTorch'un gerektiğinde yeniden oluşturduğu derlenmiş çekirdekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скомпільовані ядра, які PyTorch перезбирає за потреби."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kernel đã biên dịch mà PyTorch tạo lại khi cần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PyTorch 按需重建的已编译内核。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PyTorch 會視需要重建的已編譯核心。"
          }
        }
      }
    },

            "value": "İmajlar, konteynerler, volume'lar ve derleme önbelleği"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Образи, контейнери, томи й кеш збірки"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",

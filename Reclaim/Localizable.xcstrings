    "Results appear as each tool finishes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر النتائج عند انتهاء كل أداة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ergebnisse erscheinen, sobald ein Werkzeug fertig ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resultados aparecen a medida que termina cada herramienta."
          }

    "Couldn't check %@. Everything that finished is ready to review.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحقق من %@. كل ما اكتمل جاهز للمراجعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte nicht geprüft werden. Alles, was fertig ist, kann jetzt geprüft werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido comprobar %@. Todo lo que ha terminado está listo para revisar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier %@. Tout ce qui est terminé est prêt à être examiné."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ की जाँच नहीं हो सकी। जो कुछ पूरा हुआ, वह समीक्षा के लिए तैयार है।"

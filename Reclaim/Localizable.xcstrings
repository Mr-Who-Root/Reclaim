    "Off keeps the original Reclaim icon.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند الإيقاف، تبقى أيقونة Reclaim الأصلية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei „Aus“ bleibt das ursprüngliche Reclaim-Symbol erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se desactiva, se mantiene el icono original de Reclaim."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé, l'icône d'origine de Reclaim est conservée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद रखने पर मूल Reclaim आइकन बना रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika nonaktif, ikon Reclaim asli tetap digunakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se disattivato, resta l'icona originale di Reclaim."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると、元の Reclaim アイコンのままになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 원래 Reclaim 아이콘이 유지됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓഫ് ആണെങ്കിൽ യഥാർത്ഥ Reclaim ഐക്കൺ നിലനിർത്തും."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij ‘Uit’ blijft het oorspronkelijke Reclaim-symbool behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po wyłączeniu pozostaje oryginalna ikona Reclaim."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado, mantém o ícone original do Reclaim."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если выключено, остается исходный значок Reclaim."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Av behåller den ursprungliga Reclaim-symbolen."
          }
        },

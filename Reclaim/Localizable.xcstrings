    "Byte-for-byte identical copies. The suggested keeper is always left untouched.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخ متطابقة بايتًا ببايت. تبقى النسخة المقترح الاحتفاظ بها دون مساس دائمًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Byte für Byte identische Kopien. Die zum Behalten vorgeschlagene Kopie bleibt immer unangetastet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copias idénticas byte a byte. La copia que se sugiere conservar nunca se toca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies identiques octet par octet. L'exemplaire suggéré à conserver n'est jamais touché."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाइट-दर-बाइट एक जैसी कॉपियाँ। रखने के लिए सुझाई गई कॉपी को कभी नहीं छुआ जाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salinan identik byte demi byte. Salinan yang disarankan untuk disimpan tidak pernah diubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie identiche byte per byte. La copia suggerita da conservare non viene mai toccata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バイト単位で完全に同一のコピーです。残す候補のファイルには一切手を加えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바이트 단위로 동일한 사본입니다. 보관하도록 제안된 사본은 항상 그대로 둡니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബൈറ്റ്-ബൈ-ബൈറ്റ് സമാനമായ പകർപ്പുകൾ. സൂക്ഷിക്കാൻ നിർദ്ദേശിച്ച പകർപ്പ് ഒരിക്കലും തൊടില്ല."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Byte voor byte identieke kopieën. Het voorgestelde exemplaar dat je bewaart, blijft altijd onaangeroerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopie identyczne co do bajtu. Sugerowana kopia do zachowania nigdy nie jest ruszana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cópias idênticas byte a byte. A cópia sugerida para manter nunca é alterada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Побайтно идентичные копии. Копия, предложенная для сохранения, никогда не трогается."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopior som är identiska byte för byte. Den föreslagna kopian som behålls lämnas alltid orörd."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பைட்டுக்குப் பைட் ஒரே மாதிரியான நகல்கள். பரிந்துரைக்கப்பட்ட வைத்திருக்கும் நகல் எப்போதும் தொடப்படாது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำเนาที่เหมือนกันทุกไบต์ สำเนาที่แนะนำให้เก็บไว้จะไม่ถูกแตะต้องเสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayt bayt aynı kopyalar. Saklanması önerilen kopyaya asla dokunulmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Побайтово ідентичні копії. Копія, запропонована для збереження, завжди залишається недоторканою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bản sao giống hệt nhau đến từng byte. Bản được đề xuất giữ lại luôn được giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐字节完全相同的副本。建议保留的副本始终不会被改动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "逐位元組完全相同的副本。建議保留的副本一律不會更動。"
          }
        }
      }
    },

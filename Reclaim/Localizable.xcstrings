          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instaladores antigos, arquivos compactados e arquivos esquecidos nos seus Downloads"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старые установщики, архивы и давние файлы в папке «Загрузки»"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamla installerare, arkiv och inaktuella filer i Hämtade filer"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பதிவிறக்கங்களில் உள்ள பழைய நிறுவிகள், காப்பகங்கள் மற்றும் தேங்கிய கோப்புகள்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวติดตั้ง ไฟล์บีบอัดเก่า และไฟล์ที่ค้างนานในดาวน์โหลด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",

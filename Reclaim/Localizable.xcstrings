    "Quick Look any file before deciding": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ألقِ نظرة سريعة على أي ملف قبل اتخاذ القرار"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh dir vor der Entscheidung jede Datei in der Übersicht an"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Vista rápida con cualquier archivo antes de decidir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetez un coup d'œil à n'importe quel fichier avant de décider"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ैसला करने से पहले किसी भी फ़ाइल को Quick Look से देखें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat Cepat file apa pun sebelum memutuskan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualizza qualsiasi file con Quick Look prima di decidere"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "判断する前に、どのファイルもクイックルックで確認できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결정하기 전에 어떤 파일이든 훑어보기"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തീരുമാനിക്കുന്നതിന് മുമ്പ് ഏത് ഫയലും Quick Look ഉപയോഗിച്ച് കാണുക"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik Snel bekijken voor elk bestand voordat je beslist"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szybki przegląd dowolnego pliku przed podjęciem decyzji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a Visualização Rápida em qualquer arquivo antes de decidir"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просматривайте любой файл в режиме быстрого просмотра, прежде чем решить"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Snabbtitta på valfri fil innan du bestämmer dig"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முடிவெடுக்கும் முன் எந்தக் கோப்பையும் Quick Look இல் பாருங்கள்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูไฟล์ใดก็ได้แบบรวดเร็วก่อนตัดสินใจ"
          }
        },
        "tr": {
          "stringUnit": {

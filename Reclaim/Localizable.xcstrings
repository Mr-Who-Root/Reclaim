    "Chunk cache that speeds up repeat downloads. Downloaded models are kept.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ذاكرة تخزين مؤقت للأجزاء تُسرّع التنزيلات المتكررة. يتم الاحتفاظ بالنماذج التي تم تنزيلها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chunk-Cache, der wiederholte Downloads beschleunigt. Geladene Modelle bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caché de fragmentos que acelera las descargas repetidas. Los modelos descargados se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache de fragments qui accélère les téléchargements répétés. Les modèles téléchargés sont conservés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चंक कैश, जो दोबारा डाउनलोड को तेज़ करता है। डाउनलोड किए गए मॉडल रखे जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache potongan yang mempercepat unduhan berulang. Model yang diunduh tetap disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache dei blocchi che velocizza i download ripetuti. I modelli scaricati vengono conservati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再ダウンロードを高速化するチャンクキャッシュです。ダウンロード済みのモデルは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반복 다운로드 속도를 높이는 청크 캐시입니다. 다운로드한 모델은 유지됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആവർത്തിച്ചുള്ള ഡൗൺലോഡുകൾ വേഗത്തിലാക്കുന്ന ചങ്ക് കാഷെ. ഡൗൺലോഡ് ചെയ്ത മോഡലുകൾ സൂക്ഷിക്കും."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chunkcache die herhaalde downloads versnelt. Gedownloade modellen blijven bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamięć podręczna fragmentów przyspieszająca ponowne pobieranie. Pobrane modele są zachowywane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache de blocos que acelera downloads repetidos. Os modelos baixados são mantidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэш фрагментов, ускоряющий повторные загрузки. Загруженные модели сохраняются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Segmentcache som snabbar upp upprepade hämtningar. Hämtade modeller behålls."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீண்டும் பதிவிறக்குவதை வேகப்படுத்தும் துண்டுக் கேச். பதிவிறக்கப்பட்ட மாடல்கள் வைக்கப்படும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แคชแบบแบ่งส่วนที่ช่วยให้ดาวน์โหลดซ้ำได้เร็วขึ้น โมเดลที่ดาวน์โหลดแล้วจะยังคงอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrarlanan indirmeleri hızlandıran parça önbelleği. İndirilen modeller korunur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кеш фрагментів, що пришвидшує повторні викачування. Викачані моделі зберігаються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ nhớ đệm phân đoạn giúp tăng tốc các lần tải lại. Các mô hình đã tải về được giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于加快重复下载的分块缓存。已下载的模型会被保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可加快重複下載速度的區塊快取。已下載的模型會保留。"
          }
        }
      }
    },

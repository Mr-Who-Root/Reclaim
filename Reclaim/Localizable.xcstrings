          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamięć podręczna i dzienniki są obecnie niewielkie. Przeskanowano %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",

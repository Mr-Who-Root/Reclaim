        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude या Claude Code की अस्थायी फ़ाइलें, जैसे अपडेट स्टेजिंग और स्क्रैच आउटपुट।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",

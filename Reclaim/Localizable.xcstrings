            "state": "translated",
            "value": "Запрос данных у Docker…"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Frågar Docker vad det lagrar…"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker இல் என்ன சேமிக்கப்பட்டுள்ளது எனக் கேட்கிறது…"
          }
        },
        "th": {

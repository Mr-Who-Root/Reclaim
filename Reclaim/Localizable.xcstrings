          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചില ഇനങ്ങൾ തിരഞ്ഞെടുത്തിട്ടുണ്ട്. ഈ നിയമത്തിലെ എല്ലാ ഇനങ്ങളും തിരഞ്ഞെടുക്കുന്നു"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Enkele onderdelen geselecteerd. Selecteert alle onderdelen in deze regel"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznaczono niektóre rzeczy. Zaznacza wszystkie rzeczy w tej regule"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns itens selecionados. Seleciona todos os itens desta regra"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбраны некоторые объекты. Выбирает все объекты этого правила"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vissa objekt markerade. Markerar alla objekt i den här regeln"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சில உருப்படிகள் தேர்ந்தெடுக்கப்பட்டுள்ளன. இந்த விதியில் உள்ள அனைத்து உருப்படிகளையும் தேர்ந்தெடுக்கும்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกบางรายการแล้ว เลือกทุกรายการในกฎนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı öğeler seçili. Bu kuraldaki tüm öğeleri seçer"

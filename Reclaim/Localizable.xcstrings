        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрано деякі елементи. Вибирає всі елементи цього правила"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã chọn một số mục. Chọn mọi mục trong quy tắc này"

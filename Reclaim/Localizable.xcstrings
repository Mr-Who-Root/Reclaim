    "Mapping %@": {},
    "Mapping the whole disk is slower, and folders macOS protects will show as unknown.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Erfassen der gesamten Festplatte dauert länger, und von macOS geschützte Ordner werden als unbekannt angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapear todo el disco es más lento, y las carpetas que macOS protege aparecerán como desconocidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartographie du disque entier est plus lente, et les dossiers protégés par macOS apparaîtront comme inconnus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरी डिस्क का मैप बनाने में ज़्यादा समय लगता है, और macOS द्वारा सुरक्षित फ़ोल्डर अज्ञात के रूप में दिखेंगे।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスク全体のマップには時間がかかり、macOS が保護しているフォルダは不明として表示されます。"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മുഴുവൻ ഡിസ്കും മാപ്പ് ചെയ്യാൻ കൂടുതൽ സമയമെടുക്കും, macOS സംരക്ഷിക്കുന്ന ഫോൾഡറുകൾ അജ്ഞാതമായി കാണിക്കും."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முழு வட்டையும் வரைபடமாக்குவது மெதுவானது, macOS பாதுகாக்கும் கோப்புறைகள் அறியப்படாதவையாகக் காட்டப்படும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "映射整个磁盘会比较慢，且受 macOS 保护的文件夹将显示为未知。"
          }
        }
      }
    },

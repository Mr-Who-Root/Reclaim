          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Старі інсталятори, архіви й давні файли в папці «Викачане»"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trình cài đặt, tệp nén cũ và tệp lâu ngày trong Tải về"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“下载”文件夹中的旧安装器、归档文件和过期文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「下載項目」中的舊安裝程式、壓縮檔和過時檔案"
          }
        }
      }
    },
    "Old sessions, checkpoints, snapshots and worktrees from Claude Code, Codex, Gemini, Cursor and Aider. Histories you might still resume are marked Caution.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جلسات قديمة ونقاط حفظ ولقطات وأشجار عمل من Claude Code وCodex وGemini وCursor وAider. السجلات التي قد تستأنفها مصنّفة «حذر»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alte Sitzungen, Checkpoints, Snapshots und Worktrees von Claude Code, Codex, Gemini, Cursor und Aider. Verläufe, die du eventuell noch fortsetzen möchtest, sind mit „Vorsicht“ markiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiones, puntos de control, instantáneas y worktrees antiguos de Claude Code, Codex, Gemini, Cursor y Aider. Los historiales que aún podrías reanudar se marcan con Precaución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anciennes sessions, points de contrôle, instantanés et worktrees de Claude Code, Codex, Gemini, Cursor et Aider. Les historiques que vous pourriez encore reprendre sont marqués « Prudence »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Codex, Gemini, Cursor और Aider के पुराने सत्र, चेकपॉइंट, स्नैपशॉट और वर्कट्री। जिन इतिहासों को आप शायद फिर से शुरू करना चाहें, उन्हें सावधानी चिह्नित किया गया है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi, titik periksa, snapshot, dan worktree lama dari Claude Code, Codex, Gemini, Cursor, dan Aider. Riwayat yang mungkin masih Anda lanjutkan ditandai Hati-hati."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vecchie sessioni, checkpoint, snapshot e worktree di Claude Code, Codex, Gemini, Cursor e Aider. Le cronologie che potresti ancora riprendere sono contrassegnate con Attenzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code、Codex、Gemini、Cursor、Aider の古いセッション、チェックポイント、スナップショット、worktree。再開する可能性のある履歴には「注意」が付きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Codex, Gemini, Cursor 및 Aider의 이전 세션, 체크포인트, 스냅샷 및 worktree입니다. 다시 이어서 사용할 수도 있는 기록은 ‘주의’로 표시됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Codex, Gemini, Cursor, Aider എന്നിവയിൽ നിന്നുള്ള പഴയ സെഷനുകൾ, ചെക്ക്‌പോയിന്റുകൾ, സ്നാപ്പ്ഷോട്ടുകൾ, worktree-കൾ. നിങ്ങൾ ഇനിയും തുടർന്നേക്കാവുന്ന ചരിത്രങ്ങൾ ജാഗ്രത എന്ന് അടയാളപ്പെടുത്തിയിരിക്കുന്നു."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oude sessies, checkpoints, snapshots en worktrees van Claude Code, Codex, Gemini, Cursor en Aider. Geschiedenissen die je misschien nog hervat, zijn gemarkeerd met ‘Voorzichtig’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stare sesje, punkty kontrolne, migawki i worktree z Claude Code, Codex, Gemini, Cursor i Aider. Historie, które możesz jeszcze wznowić, są oznaczone jako Ostrożnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessões antigas, checkpoints, snapshots e worktrees do Claude Code, Codex, Gemini, Cursor e Aider. Históricos que você ainda pode retomar são marcados como Cuidado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старые сеансы, контрольные точки, снимки и рабочие деревья Claude Code, Codex, Gemini, Cursor и Aider. Истории, которые Вы можете продолжить, помечены «Осторожно»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamla sessioner, kontrollpunkter, ögonblicksbilder och worktrees från Claude Code, Codex, Gemini, Cursor och Aider. Historik som du kanske vill återuppta markeras med Försiktighet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Codex, Gemini, Cursor மற்றும் Aider இன் பழைய அமர்வுகள், சோதனைப்புள்ளிகள், ஸ்னாப்ஷாட்கள் மற்றும் worktrees. நீங்கள் இன்னும் தொடரக்கூடிய வரலாறுகள் எச்சரிக்கை எனக் குறிக்கப்பட்டுள்ளன."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซสชันเก่า จุดตรวจ สแนปช็อต และ worktree จาก Claude Code, Codex, Gemini, Cursor และ Aider ประวัติที่คุณอาจยังกลับไปทำต่อจะทำเครื่องหมายว่าระวัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Codex, Gemini, Cursor ve Aider'dan eski oturumlar, denetim noktaları, anlık görüntüler ve worktree'ler. Hâlâ sürdürebileceğiniz geçmişler Dikkat olarak işaretlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Старі сеанси, контрольні точки, знімки й робочі дерева Claude Code, Codex, Gemini, Cursor та Aider. Історії, які ви ще можете продовжити, позначено «Обережно»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên cũ, điểm kiểm tra, ảnh chụp nhanh và worktree từ Claude Code, Codex, Gemini, Cursor và Aider. Lịch sử bạn có thể vẫn muốn tiếp tục được đánh dấu Thận trọng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自 Claude Code、Codex、Gemini、Cursor 和 Aider 的旧会话、检查点、快照和工作树。你可能仍会恢复的历史记录会标记为“谨慎”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自 Claude Code、Codex、Gemini、Cursor 和 Aider 的舊工作階段、檢查點、快照和 worktree。您可能還會繼續使用的記錄會標示為「注意」。"
          }
        }
      }
    },

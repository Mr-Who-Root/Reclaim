    "GitHub didn't answer as expected. Try again later.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يستجب GitHub كما هو متوقع. حاول مرة أخرى لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hat nicht wie erwartet geantwortet. Versuche es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub no respondió como se esperaba. Inténtalo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub n'a pas répondu comme prévu. Réessayez plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ने अपेक्षा के अनुसार जवाब नहीं दिया। बाद में फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub tidak merespons seperti yang diharapkan. Coba lagi nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub non ha risposto come previsto. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub から想定どおりの応答がありませんでした。後でもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub에서 예상과 다른 응답을 받았습니다. 나중에 다시 시도하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub പ്രതീക്ഷിച്ചതുപോലെ പ്രതികരിച്ചില്ല. പിന്നീട് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub antwoordde niet zoals verwacht. Probeer het later opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwis GitHub nie odpowiedział zgodnie z oczekiwaniami. Spróbuj ponownie później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GitHub não respondeu como esperado. Tente novamente mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub ответил не так, как ожидалось. Повторите попытку позже."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub svarade inte som väntat. Försök igen senare."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub எதிர்பார்த்தபடி பதிலளிக்கவில்லை. பிறகு மீண்டும் முயலவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",

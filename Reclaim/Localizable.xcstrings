    "App caches, logs and developer leftovers that rebuild themselves.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ذاكرة التخزين المؤقت للتطبيقات والسجلات وبقايا المطوّرين التي يُعاد إنشاؤها تلقائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Caches, Protokolle und Entwicklerreste, die sich selbst neu aufbauen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cachés de apps, registros y restos de desarrollo que se regeneran solos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches d'apps, journaux et résidus de développement qui se reconstruisent d'eux-mêmes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप कैश, लॉग और डेवलपर अवशेष, जो अपने आप फिर से बन जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache app, log, dan sisa pengembang yang dibuat ulang dengan sendirinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache delle app, log e residui di sviluppo che si ricreano da soli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動的に再作成される App のキャッシュ、ログ、開発用の残存ファイル。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동으로 다시 생성되는 앱 캐시, 로그 및 개발자 잔여 파일입니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്വയം പുനർനിർമ്മിക്കപ്പെടുന്ന ആപ്പ് കാഷെകൾ, ലോഗുകൾ, ഡെവലപ്പർ അവശേഷിപ്പുകൾ."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Appcaches, logbestanden en ontwikkelaarsrestanten die zichzelf opnieuw opbouwen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamięć podręczna aplikacji, dzienniki i pozostałości deweloperskie, które same się odbudowują."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches de apps, registros e sobras de desenvolvimento que se recriam sozinhos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэши и журналы приложений, а также остатки инструментов разработчика, которые создаются заново сами."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appars cacheminnen, loggar och utvecklarrester som byggs upp igen av sig själva."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தானாகவே மீண்டும் உருவாகும் ஆப் கேச்கள், பதிவுகள் மற்றும் டெவலப்பர் எஞ்சியவை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แคช บันทึกของแอป และไฟล์ตกค้างของนักพัฒนาที่สร้างใหม่ได้เอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendiliğinden yeniden oluşturulan uygulama önbellekleri, günlükler ve geliştirici artıkları."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кеші й журнали програм, а також залишки інструментів розробника, які відтворюються самі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ nhớ đệm, nhật ký ứng dụng và tệp sót lại của công cụ phát triển, có thể tự tạo lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会自动重建的应用缓存、日志和开发残留文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可自行重建的 App 快取、記錄檔與開發者殘留檔案。"
          }
        }
      }
    },

    "Android virtual devices deployed by Genymotion. Removing one deletes that device and its data.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أجهزة Android افتراضية نشرها Genymotion. تؤدي إزالة أحدها إلى حذف ذلك الجهاز وبياناته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtuelle Android-Geräte, die mit Genymotion bereitgestellt wurden. Das Entfernen löscht das jeweilige Gerät und seine Daten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivos virtuales de Android creados con Genymotion. Al eliminar uno se borra ese dispositivo y sus datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appareils virtuels Android déployés par Genymotion. En supprimer un efface cet appareil et ses données."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Genymotion द्वारा बनाए गए Android वर्चुअल डिवाइस। किसी एक को हटाने से वह डिवाइस और उसका डेटा डिलीट हो जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat virtual Android yang di-deploy oleh Genymotion. Menghapusnya akan menghapus perangkat tersebut beserta datanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivi virtuali Android distribuiti da Genymotion. Rimuoverne uno elimina il dispositivo e i suoi dati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Genymotion で作成された Android 仮想デバイスです。削除するとそのデバイスとデータも削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Genymotion으로 배포한 Android 가상 기기입니다. 제거하면 해당 기기와 데이터가 삭제됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Genymotion സൃഷ്ടിച്ച Android വെർച്വൽ ഉപകരണങ്ങൾ. ഒന്ന് നീക്കം ചെയ്താൽ ആ ഉപകരണവും അതിന്റെ ഡാറ്റയും ഇല്ലാതാകും."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtuele Android-apparaten die door Genymotion zijn geïmplementeerd. Als je er een verwijdert, worden dat apparaat en de gegevens ervan verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wirtualne urządzenia z Androidem wdrożone przez Genymotion. Usunięcie urządzenia usuwa je wraz z danymi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivos virtuais Android implantados pelo Genymotion. Remover um apaga esse dispositivo e seus dados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Виртуальные устройства Android, развернутые Genymotion. Удаление устройства удаляет его вместе с данными."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtuella Android-enheter som har distribuerats av Genymotion. Om du tar bort en raderas enheten och dess data."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Genymotion உருவாக்கிய Android மெய்நிகர் சாதனங்கள். ஒன்றை அகற்றினால் அந்தச் சாதனமும் அதன் தரவும் நீக்கப்படும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์เสมือน Android ที่ Genymotion ติดตั้งใช้งานไว้ การเอาออกจะลบอุปกรณ์นั้นพร้อมข้อมูล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genymotion tarafından dağıtılan Android sanal aygıtları. Birini kaldırmak o aygıtı ve verilerini siler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Віртуальні пристрої Android, розгорнуті Genymotion. Видалення пристрою видаляє його разом із даними."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị ảo Android do Genymotion triển khai. Gỡ bỏ một thiết bị sẽ xóa thiết bị đó cùng dữ liệu của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由 Genymotion 部署的 Android 虚拟设备。移除后会删除该设备及其数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由 Genymotion 部署的 Android 虛擬裝置。移除後會刪除該裝置及其資料。"
          }
        }
      }
    },

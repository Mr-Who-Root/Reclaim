          }
        }
      }
    },
    "Nothing is being changed. Reclaim is only looking.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتم تغيير أي شيء. Reclaim يفحص فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird nichts geändert. Reclaim sieht nur nach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se está cambiando nada. Reclaim solo está mirando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est modifié. Reclaim se contente d'observer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी बदला नहीं जा रहा। Reclaim केवल देख रहा है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang diubah. Reclaim hanya melihat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non viene modificato nulla. Reclaim sta solo guardando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も変更していません。Reclaim は調べているだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 변경되지 않습니다. Reclaim은 살펴보기만 합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒന്നും മാറ്റുന്നില്ല. Reclaim നോക്കുക മാത്രമാണ് ചെയ്യുന്നത്."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt niets gewijzigd. Reclaim kijkt alleen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie jest zmieniane. Reclaim tylko sprawdza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada está sendo alterado. O Reclaim está apenas olhando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не изменяется. Reclaim только просматривает."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget ändras. Reclaim tittar bara."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எதுவும் மாற்றப்படுவதில்லை. Reclaim பார்க்க மட்டுமே செய்கிறது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีสิ่งใดถูกเปลี่ยนแปลง Reclaim แค่ดูเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey değiştirilmiyor. Reclaim yalnızca bakıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не змінюється. Reclaim лише переглядає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì bị thay đổi. Reclaim chỉ đang xem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会更改任何内容。Reclaim 只是在查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會更改任何內容。Reclaim 只是在查看。"
          }
        }
      }
    },
    "Nothing is selected for you": {

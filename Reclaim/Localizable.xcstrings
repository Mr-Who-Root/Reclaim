    "Carrying out only the actions you confirmed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ تنفيذ الإجراءات التي أكدتها فقط"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die von dir bestätigten Aktionen werden ausgeführt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecutando solo las acciones que has confirmado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécution des seules actions que vous avez confirmées"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल वही कार्रवाइयाँ की जा रही हैं, जिनकी आपने पुष्टि की"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya menjalankan tindakan yang Anda konfirmasi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esecuzione delle sole azioni confermate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確定した操作のみを実行中"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인한 작업만 실행하는 중"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ സ്ഥിരീകരിച്ച പ്രവർത്തനങ്ങൾ മാത്രം നടപ്പിലാക്കുന്നു"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de acties die je hebt bevestigd worden uitgevoerd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykonywanie tylko potwierdzonych czynności"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Executando apenas as ações que você confirmou"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполняются только подтвержденные Вами действия"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utför bara de åtgärder du har bekräftat"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் உறுதிசெய்த செயல்கள் மட்டுமே செயல்படுத்தப்படுகின்றன"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังดำเนินการเฉพาะสิ่งที่คุณยืนยัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca onayladığınız işlemler gerçekleştiriliyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виконуються лише підтверджені вами дії"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ thực hiện các thao tác bạn đã xác nhận"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在仅执行你确认过的操作"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只執行您確認過的動作"
          }
        }
      }
    },

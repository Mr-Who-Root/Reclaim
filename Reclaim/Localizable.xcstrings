          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca en az şu kadarını bulduğunda"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише якщо знайдено щонайменше"
          }
        },
        "vi": {
          "stringUnit": {

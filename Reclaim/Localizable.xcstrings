    "There's nothing in your Downloads folder. Scanned %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد شيء في مجلد التنزيلات. تم الفحص %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Downloads-Ordner ist leer. Letzter Scan %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu carpeta Descargas está vacía. Analizado %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre dossier Téléchargements est vide. Dernière analyse %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके डाउनलोड फ़ोल्डर में कुछ नहीं है। %@ स्कैन किया गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada apa pun di folder Unduhan Anda. Dipindai %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella Download è vuota. Ultima scansione: %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードフォルダには何もありません（スキャン: %@）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드 폴더에 아무것도 없습니다. %@ 스캔함."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഡൗൺലോഡുകൾ ഫോൾഡറിൽ ഒന്നുമില്ല. %@ സ്കാൻ ചെയ്തു."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er staat niets in je map Downloads. Gescand %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Katalog Pobrane rzeczy jest pusty. Przeskanowano %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há nada na pasta Downloads. Analisado %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В папке «Загрузки» ничего нет. Просканировано %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns inget i mappen Hämtade filer. Skannades %@."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பதிவிறக்கங்கள் கோப்புறையில் எதுவும் இல்லை. %@ ஸ்கேன் செய்யப்பட்டது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีสิ่งใดในโฟลเดอร์ดาวน์โหลดของคุณ สแกนเมื่อ %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilenler klasörünüzde hiçbir şey yok. %@ tarandı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У папці «Викачане» нічого немає. Проскановано %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư mục Tải về của bạn đang trống. Đã quét %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的“下载”文件夹中没有任何内容。上次扫描：%@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的「下載項目」檔案夾中沒有任何內容。掃描於 %@。"
          }
        }
      }
    },
    "These are the only actions Reclaim will request. Close this window to make no changes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه هي الإجراءات الوحيدة التي سيطلبها Reclaim. أغلق هذه النافذة لعدم إجراء أي تغييرات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur diese Aktionen wird Reclaim anfordern. Schließe dieses Fenster, um nichts zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas son las únicas acciones que solicitará Reclaim. Cierra esta ventana para no hacer cambios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sont les seules actions que Reclaim demandera. Fermez cette fenêtre pour ne rien modifier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim केवल यही कार्रवाइयाँ अनुरोधित करेगा। कोई बदलाव न करने के लिए यह विंडो बंद करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya tindakan inilah yang akan diminta Reclaim. Tutup jendela ini untuk tidak membuat perubahan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste sono le uniche azioni che Reclaim richiederà. Chiudi questa finestra per non apportare modifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim が要求するのはこれらの操作のみです。何も変更しない場合は、このウインドウを閉じてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim이 요청할 작업은 이것뿐입니다. 변경하지 않으려면 이 윈도우를 닫으세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim അഭ്യർത്ഥിക്കുന്ന പ്രവർത്തനങ്ങൾ ഇവ മാത്രമാണ്. മാറ്റങ്ങളൊന്നും വരുത്താതിരിക്കാൻ ഈ വിൻഡോ അടയ്ക്കുക."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit zijn de enige acties die Reclaim zal aanvragen. Sluit dit venster om niets te wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To jedyne czynności, o które poprosi Reclaim. Zamknij to okno, aby niczego nie zmieniać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas são as únicas ações que o Reclaim solicitará. Feche esta janela para não fazer alterações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim запросит только эти действия. Закройте окно, чтобы ничего не менять."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta är de enda åtgärder som Reclaim kommer att begära. Stäng fönstret om du inte vill göra några ändringar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim கோரும் செயல்கள் இவை மட்டுமே. எந்த மாற்றமும் செய்யாமல் இருக்க இந்தச் சாளரத்தை மூடவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือการดำเนินการทั้งหมดที่ Reclaim จะร้องขอ ปิดหน้าต่างนี้หากไม่ต้องการเปลี่ยนแปลงใดๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim'in isteyeceği işlemler yalnızca bunlardır. Hiçbir değişiklik yapmamak için bu pencereyi kapatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim запитає лише ці дії. Закрийте вікно, щоб нічого не змінювати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là những thao tác duy nhất Reclaim sẽ yêu cầu. Đóng cửa sổ này để không thay đổi gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些是 Reclaim 将请求的全部操作。关闭此窗口则不做任何更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim 只會請求這些動作。關閉此視窗即可不做任何更改。"
          }
        }
      }
    },
    "Thinking on this Mac…": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ التفكير على جهاز Mac هذا…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Denkt auf diesem Mac nach …"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensando en este Mac…"
          }
        },
        "fr": {

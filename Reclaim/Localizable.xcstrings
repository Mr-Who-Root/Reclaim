    "Old installers, archives & stale downloads": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدوات تثبيت وأرشيفات قديمة وتنزيلات مهملة"
          }
        },
        "de": {

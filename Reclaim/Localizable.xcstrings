            "value": "Menyelesaikan audit ini tanpa memindahkan atau mengubah apa pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina questa verifica senza spostare né modificare nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も移動・変更せずにこの点検を終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 이동하거나 변경하지 않고 이 점검을 마칩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒന്നും നീക്കുകയോ മാറ്റുകയോ ചെയ്യാതെ ഈ ഓഡിറ്റ് പൂർത്തിയാക്കുന്നു."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltooit deze audit zonder iets te verplaatsen of te wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kończy ten audyt bez przenoszenia ani zmieniania czegokolwiek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclui esta auditoria sem mover nem alterar nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершает этот аудит, ничего не перемещая и не изменяя."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avslutar den här genomgången utan att flytta eller ändra något."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எதையும் நகர்த்தாமலும் மாற்றாமலும் இந்தத் தணிக்கையை முடிக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จบการตรวจทานนี้โดยไม่ย้ายหรือเปลี่ยนแปลงสิ่งใด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şeyi taşımadan veya değiştirmeden bu denetimi bitirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершує цей аудит, нічого не переміщуючи й не змінюючи."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết thúc lần rà soát này mà không di chuyển hay thay đổi gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束此次审查，不移动或更改任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束此稽核，不移動或更改任何項目。"
          }
        }
      }
    },

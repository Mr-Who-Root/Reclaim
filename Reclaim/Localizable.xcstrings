        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ പരിശോധിക്കാനായില്ല. പൂർത്തിയായതെല്ലാം അവലോകനത്തിന് തയ്യാറാണ്."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan %@ niet controleren. Alles wat wel is voltooid, kun je nu beoordelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można sprawdzić: %@. Wszystko, co zostało ukończone, jest gotowe do przejrzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar %@. Tudo o que foi concluído está pronto para revisão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить: %@. Все завершенное готово к просмотру."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att kontrollera %@. Allt som slutfördes är klart att granska."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ஐச் சரிபார்க்க முடியவில்லை. முடிந்தவை அனைத்தும் மதிப்பாய்வுக்குத் தயார்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบ %@ ไม่ได้ ทุกส่วนที่เสร็จแล้วพร้อมให้ตรวจทาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ denetlenemedi. Tamamlanan her şey incelemeye hazır."

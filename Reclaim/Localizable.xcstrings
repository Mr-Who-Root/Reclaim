        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ നിയമത്തിലെ എല്ലാ ഇനങ്ങളുടെയും തിരഞ്ഞെടുപ്പ് മാറ്റുക"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த விதியில் உள்ள அனைத்து உருப்படிகளையும் தேர்வுநீக்கு"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消选择此规则中的所有项目"
          }
        }
      }
    },

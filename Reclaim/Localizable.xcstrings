    "Distributed through the Mac App Store, so Apple reviewed it and it runs sandboxed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم توزيعه عبر Mac App Store، لذا راجعته Apple ويعمل في بيئة معزولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über den Mac App Store vertrieben, daher von Apple geprüft und in einer Sandbox ausgeführt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se distribuye a través de la Mac App Store, así que Apple lo ha revisado y se ejecuta en un entorno aislado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribué via le Mac App Store : Apple l'a donc examiné et il s'exécute en sandbox."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac App Store के ज़रिए वितरित, इसलिए Apple ने इसकी समीक्षा की है और यह सैंडबॉक्स में चलता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Didistribusikan melalui Mac App Store, jadi Apple telah meninjaunya dan app berjalan dalam sandbox."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribuita tramite il Mac App Store: Apple l'ha esaminata e viene eseguita in sandbox."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac App Store で配布されているため、Apple の審査を受けており、サンドボックス内で動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac App Store를 통해 배포되어 Apple의 심사를 거쳤으며 샌드박스에서 실행됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac App Store വഴി വിതരണം ചെയ്തതാണ്, അതിനാൽ Apple ഇത് അവലോകനം ചെയ്തിട്ടുണ്ട്, ഇത് സാൻഡ്‌ബോക്സിൽ പ്രവർത്തിക്കുന്നു."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verspreid via de Mac App Store, dus Apple heeft het beoordeeld en het draait in een sandbox."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dystrybuowana przez Mac App Store, więc Apple ją sprawdziło i działa w piaskownicy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribuído pela Mac App Store, então foi revisado pela Apple e é executado em sandbox."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распространяется через Mac App Store: Apple проверила его, и оно работает в песочнице."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribueras via Mac App Store, så Apple har granskat den och den körs i en sandlåda."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac App Store மூலம் விநியோகிக்கப்பட்டது, எனவே Apple இதை மதிப்பாய்வு செய்துள்ளது, இது sandbox இல் இயங்குகிறது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เผยแพร่ผ่าน Mac App Store จึงผ่านการตรวจสอบจาก Apple และทำงานในแซนด์บ็อกซ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac App Store üzerinden dağıtıldığı için Apple tarafından incelendi ve korumalı alanda çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розповсюджується через Mac App Store: Apple перевірила її, і вона працює в пісочниці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được phân phối qua Mac App Store, nên đã được Apple xem xét và chạy trong sandbox."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 Mac App Store 分发，因此经过了 Apple 审核，并在沙盒中运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 Mac App Store 發佈，因此經過 Apple 審查，並在沙盒中執行。"
          }
        }
      }
    },

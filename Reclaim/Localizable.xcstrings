    "Every camera photo looks sharp enough.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدو كل صور الكاميرا حادة بما يكفي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Kamerafotos wirken scharf genug."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las fotos de cámara son lo bastante nítidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les photos d'appareil photo semblent suffisamment nettes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर कैमरा फ़ोटो पर्याप्त शार्प दिखती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua foto kamera terlihat cukup tajam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le foto della fotocamera sono abbastanza nitide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのカメラ写真が十分にシャープです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 카메라 사진이 충분히 선명합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാ ക്യാമറ ഫോട്ടോകളും ആവശ്യത്തിന് വ്യക്തമാണ്."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle camerafoto's zien er scherp genoeg uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie zdjęcia z aparatu są wystarczająco ostre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as fotos de câmera parecem nítidas o suficiente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все фото с камеры выглядят достаточно резкими."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla kamerabilder ser tillräckligt skarpa ut."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு கேமரா புகைப்படமும் போதுமான அளவு கூர்மையாக உள்ளது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปจากกล้องทุกรูปดูคมชัดพอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm kamera fotoğrafları yeterince net görünüyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі фото з камери виглядають достатньо різкими."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi ảnh chụp từ máy ảnh đều đủ nét."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",

        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim-നുള്ള അറിയിപ്പുകൾ ഓഫാണ്. സിസ്റ്റം ക്രമീകരണം › അറിയിപ്പുകൾ എന്നതിൽ അവ ഓണാക്കുക."

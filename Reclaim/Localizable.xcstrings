    },
    "An accent used across the app, the widget and the Dock icon.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Akzentfarbe für die App, das Widget und das Dock-Symbol."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un color de acentuación para la app, el widget y el icono del Dock."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une couleur d'accentuation utilisée dans l'app, le widget et l'icône du Dock."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप, विजेट और Dock आइकन में उपयोग होने वाला ऐक्सेंट रंग।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App 全体、ウィジェット、Dock アイコンで使われるアクセントカラーです。"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആപ്പിലും വിജറ്റിലും Dock ഐക്കണിലും ഉപയോഗിക്കുന്ന ആക്സന്റ് നിറം."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆப், விட்ஜெட், Dock ஐகான் முழுவதும் பயன்படுத்தப்படும் அக்சென்ட் நிறம்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在整个应用、小组件和程序坞图标中使用的强调色。"
          }
        }
      }
    },
    "An older version kept after an update. The newest is %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine ältere Version, die nach einem Update behalten wurde. Die neueste ist %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una versión anterior que se conservó tras una actualización. La más reciente es %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une ancienne version conservée après une mise à jour. La plus récente est %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपडेट के बाद रखा गया पुराना संस्करण। नवीनतम संस्करण %@ है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデート後に残された古いバージョンです。最新は %@ です。"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അപ്‌ഡേറ്റിന് ശേഷം സൂക്ഷിച്ച ഒരു പഴയ പതിപ്പ്. ഏറ്റവും പുതിയത് %@ ആണ്."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புதுப்பித்த பிறகு வைக்கப்பட்ட பழைய பதிப்பு. புதியது %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新后保留的旧版本。最新版本为 %@。"
          }
        }
      }
    },

            "state": "translated",
            "value": "योजना में जोड़ें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランに追加"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്ലാനിലേക്ക് ചേർക്കുക"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",

    "Open reclaim://scan to start Smart Scan, or reclaim://junk, reclaim://ai, reclaim://guided and so on to jump to a tool.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح reclaim://scan لبدء الفحص الذكي، أو reclaim://junk أو reclaim://ai أو reclaim://guided وغيرها للانتقال إلى أداة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne reclaim://scan, um Smart Scan zu starten, oder reclaim://junk, reclaim://ai, reclaim://guided usw., um direkt zu einem Werkzeug zu springen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre reclaim://scan para iniciar el Análisis inteligente, o reclaim://junk, reclaim://ai, reclaim://guided, etc., para ir directamente a una herramienta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez reclaim://scan pour lancer l'analyse intelligente, ou reclaim://junk, reclaim://ai, reclaim://guided, etc. pour accéder directement à un outil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्मार्ट स्कैन शुरू करने के लिए reclaim://scan खोलें, या किसी टूल पर सीधे जाने के लिए reclaim://junk, reclaim://ai, reclaim://guided आदि खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka reclaim://scan untuk memulai Pindai Cerdas, atau reclaim://junk, reclaim://ai, reclaim://guided, dan seterusnya untuk langsung ke suatu alat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri reclaim://scan per avviare la scansione intelligente, oppure reclaim://junk, reclaim://ai, reclaim://guided e così via per passare a uno strumento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "reclaim://scan を開くとスマートスキャンが始まり、reclaim://junk、reclaim://ai、reclaim://guided などを開くと各ツールに移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "reclaim://scan을 열면 스마트 스캔이 시작되고, reclaim://junk, reclaim://ai, reclaim://guided 등을 열면 해당 도구로 바로 이동합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്മാർട്ട് സ്കാൻ ആരംഭിക്കാൻ reclaim://scan തുറക്കുക, അല്ലെങ്കിൽ ഒരു ടൂളിലേക്ക് നേരിട്ട് പോകാൻ reclaim://junk, reclaim://ai, reclaim://guided തുടങ്ങിയവ തുറക്കുക."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open reclaim://scan om Smart Scan te starten, of reclaim://junk, reclaim://ai, reclaim://guided enzovoort om direct naar een tool te gaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz reclaim://scan, aby rozpocząć inteligentne skanowanie, albo reclaim://junk, reclaim://ai, reclaim://guided itd., aby przejść do narzędzia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra reclaim://scan para iniciar a Análise Inteligente, ou reclaim://junk, reclaim://ai, reclaim://guided e outros para ir direto a uma ferramenta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте reclaim://scan, чтобы запустить умное сканирование, или reclaim://junk, reclaim://ai, reclaim://guided и т. д., чтобы перейти к инструменту."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna reclaim://scan för att starta Smart Scan, eller reclaim://junk, reclaim://ai, reclaim://guided och så vidare för att gå direkt till ett verktyg."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்மார்ட் ஸ்கேனைத் தொடங்க reclaim://scan ஐத் திறக்கவும், அல்லது ஒரு கருவிக்கு நேரடியாகச் செல்ல reclaim://junk, reclaim://ai, reclaim://guided போன்றவற்றைத் திறக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด reclaim://scan เพื่อเริ่มสแกนอัจฉริยะ หรือ reclaim://junk, reclaim://ai, reclaim://guided และอื่นๆ เพื่อไปยังเครื่องมือ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akıllı Tarama'yı başlatmak için reclaim://scan bağlantısını, bir araca geçmek için reclaim://junk, reclaim://ai, reclaim://guided vb. bağlantıları açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте reclaim://scan, щоб запустити розумне сканування, або reclaim://junk, reclaim://ai, reclaim://guided тощо, щоб перейти до інструмента."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở reclaim://scan để bắt đầu Quét thông minh, hoặc reclaim://junk, reclaim://ai, reclaim://guided, v.v. để chuyển đến một công cụ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 reclaim://scan 以开始智能扫描，或打开 reclaim://junk、reclaim://ai、reclaim://guided 等直接跳转到某个工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開 reclaim://scan 以開始智慧型掃描，或打開 reclaim://junk、reclaim://ai、reclaim://guided 等以直接前往工具。"
          }
        }
      }
    },

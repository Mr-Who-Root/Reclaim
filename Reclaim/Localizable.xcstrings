            "value": "需要完全磁盘访问权限"
          }
        }
      }
    },
    "Needs approval in System Settings › General › Login Items.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Muss in Systemeinstellungen › Allgemein › Anmeldeobjekte genehmigt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere aprobación en Ajustes del Sistema › General › Ítems de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite une autorisation dans Réglages Système › Général › Ouverture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम सेटिंग्ज़ › सामान्य › लॉगिन आइटम में स्वीकृति चाहिए।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 › 一般 › ログイン項目で承認が必要です。"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സിസ്റ്റം ക്രമീകരണം › പൊതുവായവ › ലോഗിൻ ഇനങ്ങൾ എന്നതിൽ അനുമതി ആവശ്യമാണ്."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "System Settings › General › Login Items இல் ஒப்புதல் தேவை."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要在“系统设置” › “通用” › “登录项”中批准。"
          }
        }
      }
    },
    "Needs attention": {},
    "Never deletes permanently — you empty the Trash yourself": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht nie endgültig – du entleerst den Papierkorb selbst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca elimina nada de forma permanente: tú vacías la Papelera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne supprime jamais définitivement : c'est vous qui videz la Corbeille"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कभी स्थायी रूप से डिलीट नहीं करता — ट्रैश आप ख़ुद ख़ाली करते हैं"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全に削除することはありません。ゴミ箱を空にするのはあなた自身です"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരിക്കലും ശാശ്വതമായി ഇല്ലാതാക്കില്ല — ട്രാഷ് ശൂന്യമാക്കുന്നത് നിങ്ങൾ തന്നെ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒருபோதும் நிரந்தரமாக நீக்காது — குப்பைத் தொட்டியை நீங்களே காலியாக்குவீர்கள்"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永不永久删除——由你自己清倒废纸篓"
          }
        }
      }
    },
    "Never removes anything on a schedule": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt nie etwas nach Zeitplan"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca elimina nada de forma programada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne supprime jamais rien de façon planifiée"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शेड्यूल के अनुसार कभी कुछ नहीं हटाता"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スケジュールで何かを削除することはありません"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഷെഡ്യൂൾ അനുസരിച്ച് ഒരിക്കലും ഒന്നും നീക്കം ചെയ്യില്ല"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கால அட்டவணைப்படி எதையும் ஒருபோதும் அகற்றாது"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永远不会按计划自动移除任何内容"
          }
        }
      }
    },

    "Moved to the Trash so far. Empty the Trash to free it for good.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما تم نقله إلى سلة المهملات حتى الآن. أفرغ سلة المهملات لتحرير المساحة نهائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisher in den Papierkorb gelegt. Entleere den Papierkorb, um den Speicher endgültig freizugeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasladado a la Papelera hasta ahora. Vacía la Papelera para liberarlo definitivamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placé dans la Corbeille jusqu'à présent. Videz la Corbeille pour libérer définitivement cet espace."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब तक ट्रैश में ले जाया गया। यह जगह हमेशा के लिए ख़ाली करने के लिए ट्रैश ख़ाली करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipindahkan ke Tong Sampah sejauh ini. Kosongkan Tong Sampah untuk membebaskan ruangnya secara permanen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spostati nel Cestino finora. Svuota il Cestino per liberare lo spazio definitivamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これまでにゴミ箱に移動した容量です。ゴミ箱を空にすると完全に解放されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금까지 휴지통으로 이동한 용량입니다. 휴지통을 비우면 공간이 완전히 확보됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതുവരെ ട്രാഷിലേക്ക് നീക്കിയത്. ഈ സ്ഥലം എന്നേക്കുമായി ഒഴിവാക്കാൻ ട്രാഷ് ശൂന്യമാക്കുക."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot nu toe naar de prullenmand verplaatst. Leeg de prullenmand om de ruimte definitief vrij te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotychczas przeniesiono do Kosza. Opróżnij Kosz, aby trwale zwolnić to miejsce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Movido para o Lixo até agora. Esvazie o Lixo para liberar o espaço de vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже перемещено в Корзину. Очистите Корзину, чтобы окончательно освободить место."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyttat till papperskorgen hittills. Töm papperskorgen för att frigöra utrymmet för gott."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இதுவரை குப்பைத் தொட்டிக்கு நகர்த்தப்பட்டவை. இந்த இடத்தை நிரந்தரமாக விடுவிக்கக் குப்பைத் தொட்டியைக் காலியாக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ย้ายไปที่ถังขยะแล้วจนถึงตอนนี้ ล้างถังขยะเพื่อเพิ่มพื้นที่อย่างถาวร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu ana kadar Çöp Sepetine taşınan. Alanı kalıcı olarak boşaltmak için Çöp Sepetini boşaltın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже переміщено в Смітник. Спорожніть Смітник, щоб остаточно звільнити місце."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã chuyển vào Thùng rác đến nay. Hãy dọn sạch Thùng rác để giải phóng vĩnh viễn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "迄今已移到废纸篓。清倒废纸篓即可永久释放这些空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前已移到垃圾桶的大小。清空垃圾桶即可永久釋放空間。"
          }
        }
      }
    },
    "Movies": {
      "localizations": {
        "ar": {

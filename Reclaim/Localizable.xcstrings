          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇമേജുകൾ, കണ്ടെയ്‌നറുകൾ, വോള്യങ്ങൾ, ബിൽഡ് കാഷെ"

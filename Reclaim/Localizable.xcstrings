        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt hamnar i papperskorgen, så du kan ångra"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அனைத்தும் குப்பைத் தொட்டிக்குச் செல்வதால் செயல்தவிர்க்கலாம்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างไปที่ถังขยะ คุณจึงเลิกทำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey Çöp Sepetine gider, yani geri alabilirsiniz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе потрапляє в Смітник, тож дію можна відмінити"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ đều vào Thùng rác nên bạn có thể hoàn tác"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有内容都会进入废纸篓，因此可以撤销"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有項目都會移到垃圾桶，因此可以還原"
          }
        }
      }
    },
    "Everything stays recoverable in the Trash until you empty it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى كل شيء قابلًا للاسترداد في سلة المهملات حتى تفرغها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bleibt im Papierkorb wiederherstellbar, bis du ihn entleerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se puede recuperar de la Papelera hasta que la vacíes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste récupérable dans la Corbeille jusqu'à ce que vous la vidiez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक आप ट्रैश ख़ाली नहीं करते, सब कुछ उसमें से वापस पाया जा सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua tetap dapat dipulihkan di Tong Sampah hingga Anda mengosongkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto resta recuperabile nel Cestino finché non lo svuoti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱を空にするまで、すべて復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통을 비우기 전까지 모든 항목을 복구할 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ട്രാഷ് ശൂന്യമാക്കുന്നത് വരെ എല്ലാം അവിടെ നിന്ന് വീണ്ടെടുക്കാനാകും."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles blijft herstelbaar in de prullenmand totdat je die leegt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko można odzyskać z Kosza, dopóki go nie opróżnisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo pode ser recuperado no Lixo até você esvaziá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все можно восстановить из Корзины, пока Вы ее не очистите."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt kan återställas från papperskorgen tills du tömmer den."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் காலியாக்கும் வரை அனைத்தும் குப்பைத் தொட்டியில் மீட்டெடுக்கக்கூடியதாக இருக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างยังกู้คืนได้จากถังขยะจนกว่าคุณจะล้างถังขยะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz boşaltana kadar her şey Çöp Sepetinde kurtarılabilir durumda kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе можна відновити зі Смітника, доки ви його не спорожните."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ vẫn có thể khôi phục từ Thùng rác cho đến khi bạn dọn sạch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你清倒废纸篓之前，所有内容都可以从废纸篓中恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在您清空垃圾桶之前，所有項目都可以從垃圾桶回復。"
          }
        }
      }
    },
    "Everything stays recoverable in the Trash until you empty it. You can also undo right after.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى كل شيء قابلًا للاسترداد في سلة المهملات حتى تفرغها. يمكنك أيضًا التراجع مباشرةً بعد ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bleibt im Papierkorb wiederherstellbar, bis du ihn entleerst. Du kannst es auch direkt danach widerrufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se puede recuperar de la Papelera hasta que la vacíes. También puedes deshacerlo justo después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste récupérable dans la Corbeille jusqu'à ce que vous la vidiez. Vous pouvez aussi annuler juste après."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक आप ट्रैश ख़ाली नहीं करते, सब कुछ उसमें से वापस पाया जा सकता है। आप तुरंत बाद पूर्ववत भी कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua tetap dapat dipulihkan di Tong Sampah hingga Anda mengosongkannya. Anda juga dapat langsung mengurungkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto resta recuperabile nel Cestino finché non lo svuoti. Puoi anche annullare subito dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱を空にするまで、すべて復元できます。直後であれば取り消すこともできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통을 비우기 전까지 모든 항목을 복구할 수 있습니다. 바로 실행 취소할 수도 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ട്രാഷ് ശൂന്യമാക്കുന്നത് വരെ എല്ലാം അവിടെ നിന്ന് വീണ്ടെടുക്കാനാകും. ഉടൻ തന്നെ പഴയപടിയാക്കാനും കഴിയും."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles blijft herstelbaar in de prullenmand totdat je die leegt. Je kunt het ook direct daarna ongedaan maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko można odzyskać z Kosza, dopóki go nie opróżnisz. Możesz też od razu cofnąć zmiany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo pode ser recuperado no Lixo até você esvaziá-lo. Também é possível desfazer logo em seguida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все можно восстановить из Корзины, пока Вы ее не очистите. Можно также сразу отменить действие."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt kan återställas från papperskorgen tills du tömmer den. Du kan också ångra direkt efteråt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் காலியாக்கும் வரை அனைத்தும் குப்பைத் தொட்டியில் மீட்டெடுக்கக்கூடியதாக இருக்கும். உடனடியாகச் செயல்தவிர்க்கவும் முடியும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างยังกู้คืนได้จากถังขยะจนกว่าคุณจะล้างถังขยะ และคุณยังเลิกทำได้ทันทีหลังจากนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz boşaltana kadar her şey Çöp Sepetinde kurtarılabilir durumda kalır. Hemen ardından geri de alabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе можна відновити зі Смітника, доки ви його не спорожните. Також можна одразу відмінити дію."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ vẫn có thể khôi phục từ Thùng rác cho đến khi bạn dọn sạch. Bạn cũng có thể hoàn tác ngay sau đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你清倒废纸篓之前，所有内容都可以从废纸篓中恢复。你也可以随即撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在您清空垃圾桶之前，所有項目都可以從垃圾桶回復。您也可以立即還原。"
          }
        }
      }
    },
    "Exclude": {
      "localizations": {
        "ar": {
          "stringUnit": {

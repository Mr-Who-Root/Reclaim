            "value": "திறக்க கோப்புறையைக் கிளிக் செய்யவும் · செயல்களுக்கு வலது-கிளிக் செய்யவும் · திரும்பிச் செல்ல ⌘["
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิกโฟลเดอร์เพื่อเปิด · คลิกขวาเพื่อดูคำสั่ง · ⌘[ เพื่อย้อนกลับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açmak için bir klasörü tıklayın · İşlemler için sağ tıklayın · Geri gitmek için ⌘["
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацніть папку, щоб відкрити її · Клацання правою кнопкою — дії · ⌘[ — назад"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm vào thư mục để mở · Bấm chuột phải để xem thao tác · ⌘[ để quay lại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按文件夹以打开 · 右键点按以执行操作 · ⌘[ 返回"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下檔案夾即可打開 · 按右鍵執行動作 · 按 ⌘[ 返回"
          }
        }
      }
    },

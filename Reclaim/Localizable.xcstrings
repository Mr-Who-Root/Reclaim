    "Package tarballs npm downloaded. npm fetches them again when a project needs them.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرشيفات الحِزم (tarballs) التي نزّلها npm. يجلبها npm مجددًا عندما يحتاج إليها مشروع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket-Tarballs, die npm geladen hat. npm lädt sie erneut, wenn ein Projekt sie braucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarballs de paquetes que descargó npm. npm los vuelve a descargar cuando un proyecto los necesita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Archives tar de paquets téléchargées par npm. npm les récupère à nouveau quand un projet en a besoin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "npm द्वारा डाउनलोड किए गए पैकेज टारबॉल। किसी प्रोजेक्ट को ज़रूरत होने पर npm इन्हें फिर से ले आता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarball paket yang diunduh npm. npm akan mengambilnya lagi saat proyek memerlukannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarball dei pacchetti scaricati da npm. npm li scarica di nuovo quando un progetto ne ha bisogno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "npm がダウンロードしたパッケージの tarball です。プロジェクトで必要になると npm が再取得します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "npm이 다운로드한 패키지 tarball입니다. 프로젝트에 필요할 때 npm이 다시 가져옵니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "npm ഡൗൺലോഡ് ചെയ്ത പാക്കേജ് tarball-കൾ. ഒരു പ്രോജക്റ്റിന് ആവശ്യമുള്ളപ്പോൾ npm അവ വീണ്ടും ലഭ്യമാക്കും."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakket-tarballs die npm heeft gedownload. npm haalt ze opnieuw op wanneer een project ze nodig heeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiwa tarball pakietów pobrane przez npm. npm pobierze je ponownie, gdy projekt będzie ich potrzebował."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarballs de pacotes que o npm baixou. O npm os baixa novamente quando um projeto precisa deles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Архивы пакетов, загруженные npm. npm загрузит их снова, когда они понадобятся проекту."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Paketarkiv (tarballs) som npm har hämtat. npm hämtar dem igen när ett projekt behöver dem."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "npm பதிவிறக்கிய தொகுப்பு tarballs. ஒரு புராஜெக்ட்டுக்குத் தேவைப்படும்போது npm அவற்றை மீண்டும் பெறும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "tarball ของแพ็กเกจที่ npm ดาวน์โหลดไว้ npm จะดึงมาใหม่เมื่อโปรเจกต์ต้องการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "npm'in indirdiği paket tarball'ları. Bir proje ihtiyaç duyduğunda npm bunları yeniden indirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Архіви пакетів, викачані npm. npm викачає їх знову, коли вони знадобляться проєкту."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tarball gói mà npm đã tải về. npm sẽ tải lại khi dự án cần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "npm 下载的软件包 tarball。项目需要时 npm 会重新获取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "npm 下載的套件 tarball。專案需要時，npm 會重新取得。"
          }
        }
      }
    },

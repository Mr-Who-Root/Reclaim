    "App bundles and photo libraries are never split apart": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتم تقسيم حِزم التطبيقات ومكتبات الصور أبدًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Bundles und Fotomediatheken werden nie aufgeteilt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los paquetes de apps y las fototecas nunca se dividen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les bundles d'apps et les photothèques ne sont jamais décomposés"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप बंडल और फ़ोटो लाइब्रेरी को कभी अलग-अलग नहीं किया जाता"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundel app dan perpustakaan foto tidak pernah dipisahkan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I pacchetti delle app e le librerie di foto non vengono mai divisi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App バンドルや写真ライブラリが分割されることはありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 번들과 사진 보관함은 절대 분리되지 않습니다"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആപ്പ് ബണ്ടിലുകളും ഫോട്ടോ ലൈബ്രറികളും ഒരിക്കലും വേർപെടുത്തില്ല"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Appbundels en fotobibliotheken worden nooit opgesplitst"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakiety aplikacji i biblioteki zdjęć nigdy nie są rozdzielane"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pacotes de apps e fototecas nunca são divididos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакеты приложений и медиатеки фото никогда не разделяются"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Programpaket och bildbibliotek delas aldrig upp"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆப் தொகுப்புகளும் புகைப்பட நூலகங்களும் ஒருபோதும் பிரிக்கப்படாது"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันเดิลแอปและคลังรูปภาพจะไม่ถูกแยกออกจากกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama paketleri ve fotoğraf arşivleri asla bölünmez"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакети програм і фотомедіатеки ніколи не розділяються"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói ứng dụng và thư viện ảnh không bao giờ bị tách rời"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用包和照片图库绝不会被拆分"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 套件和照片圖庫絕不會被拆開"
          }
        }
      }
    },

          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看是什麼佔用了空間"
          }
        }
      }
    },
    "See who made what runs on your Mac": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرف من صنع ما يعمل على جهاز Mac"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, wer erstellt hat, was auf deinem Mac läuft"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubre quién creó lo que se ejecuta en tu Mac"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvrez qui a créé ce qui s'exécute sur votre Mac"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देखें कि आपके Mac पर चलने वाली चीज़ें किसने बनाईं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat siapa pembuat apa yang berjalan di Mac Anda"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scopri chi ha creato ciò che viene eseguito sul Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac で動作しているものの作成元を確認"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 실행되는 항목을 누가 만들었는지 보기"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ Mac-ൽ പ്രവർത്തിക്കുന്നവ ആരാണ് നിർമ്മിച്ചതെന്ന് കാണുക"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk wie heeft gemaakt wat er op je Mac draait"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz, kto stworzył to, co działa na Macu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja quem criou o que é executado no seu Mac"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узнайте, кто создал то, что работает на Вашем Mac"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vem som har gjort det som körs på din Mac"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் Mac இல் இயங்குபவற்றை யார் உருவாக்கினார்கள் என்று பாருங்கள்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูว่าใครสร้างสิ่งที่ทำงานบน Mac ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'inizde çalışanları kimin yaptığını görün"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дізнайтеся, хто створив те, що працює на вашому Mac"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem ai tạo ra những gì đang chạy trên Mac của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看在你的 Mac 上运行的内容由谁制作"

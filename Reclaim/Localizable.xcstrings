            "state": "translated",
            "value": "Mọi mục đang hiển thị"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有显示的项目"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有顯示的項目"
          }
        }
      }
    },
    "Everything goes to the Trash, so it's recoverable": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء ينتقل إلى سلة المهملات، لذا يمكن استرداده"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles landet im Papierkorb und bleibt so wiederherstellbar"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo va a la Papelera, así que se puede recuperar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout va dans la Corbeille, donc tout est récupérable"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब कुछ ट्रैश में जाता है, इसलिए उसे वापस पाया जा सकता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua masuk ke Tong Sampah, jadi dapat dipulihkan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto finisce nel Cestino, quindi è recuperabile"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてゴミ箱に入るので復元できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 항목은 휴지통으로 이동하므로 복구할 수 있습니다"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാം ട്രാഷിലേക്ക് പോകുന്നതിനാൽ വീണ്ടെടുക്കാനാകും"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles gaat naar de prullenmand, dus het is te herstellen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko trafia do Kosza, więc można to odzyskać"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo vai para o Lixo, então pode ser recuperado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все попадает в Корзину, и это можно восстановить"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt hamnar i papperskorgen och kan återställas"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அனைத்தும் குப்பைத் தொட்டிக்குச் செல்வதால் மீட்டெடுக்கலாம்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างไปที่ถังขยะ จึงกู้คืนได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey Çöp Sepetine gider, yani kurtarılabilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе потрапляє в Смітник, тож його можна відновити"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ đều vào Thùng rác nên có thể khôi phục"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有内容都会进入废纸篓，因此可以恢复"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有項目都會移到垃圾桶，因此可以回復"
          }
        }
      }
    },
    "Everything goes to the Trash, so you can undo": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء ينتقل إلى سلة المهملات، لذا يمكنك التراجع"

    "%@ can only be measured with Full Disk Access.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن قياس %@ إلا مع الوصول الكامل إلى القرص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann nur mit Festplattenvollzugriff gemessen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ solo se puede medir con acceso total al disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mesure de %@ nécessite l'accès complet au disque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को केवल पूर्ण डिस्क ऐक्सेस से मापा जा सकता है।"
          }
        },
        "id": {

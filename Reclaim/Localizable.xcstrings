        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてゴミ箱に入るので取り消せます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 항목은 휴지통으로 이동하므로 실행 취소할 수 있습니다"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാം ട്രാഷിലേക്ക് പോകുന്നതിനാൽ പഴയപടിയാക്കാം"
          }

    "Selects files that match a rule, or clears the current selection": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählt Dateien aus, die einer Regel entsprechen, oder hebt die aktuelle Auswahl auf"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona los archivos que cumplen una regla o borra la selección actual"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionne les fichiers correspondant à une règle, ou efface la sélection actuelle"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी नियम से मेल खाने वाली फ़ाइलें चुनता है, या मौजूदा चयन साफ़ करता है"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールに一致するファイルを選択するか、現在の選択を解除します"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു നിയമവുമായി പൊരുത്തപ്പെടുന്ന ഫയലുകൾ തിരഞ്ഞെടുക്കുന്നു, അല്ലെങ്കിൽ നിലവിലെ തിരഞ്ഞെടുപ്പ് മായ്ക്കുന്നു"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு விதிக்குப் பொருந்தும் கோப்புகளைத் தேர்ந்தெடுக்கும், அல்லது தற்போதைய தேர்வை அழிக்கும்"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择符合规则的文件，或清除当前选择"
          }
        }
      }

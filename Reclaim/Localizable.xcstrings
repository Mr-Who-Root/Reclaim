    "Every file in %@ is unique. Scanned %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ملف في %@ فريد. تم الفحص %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Dateien in %@ sind einzigartig. Letzter Scan %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Every file in %1$@ is unique. Scanned %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los archivos de %@ son únicos. Analizado %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les fichiers de %@ sont uniques. Dernière analyse %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ की हर फ़ाइल अद्वितीय है। %@ स्कैन किया गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap file di %@ unik. Dipindai %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni file in %@ è unico. Ultima scansione: %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 内のファイルはすべて固有です（スキャン: %@）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 모든 파일이 고유합니다. %@ 스캔함."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-ലെ എല്ലാ ഫയലുകളും വ്യത്യസ്തമാണ്. %@ സ്കാൻ ചെയ്തു."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk bestand in %@ is uniek. Gescand %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie pliki w: %@ są unikatowe. Przeskanowano %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os arquivos em %@ são únicos. Analisado %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: все файлы уникальны. Просканировано %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla filer i %@ är unika. Skannades %@."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ இல் உள்ள ஒவ்வொரு கோப்பும் தனித்துவமானது. %@ ஸ்கேன் செய்யப்பட்டது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกไฟล์ใน %@ ไม่ซ้ำกัน สแกนเมื่อ %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ içindeki tüm dosyalar benzersiz. %@ tarandı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: усі файли унікальні. Проскановано %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi tệp trong %@ đều là duy nhất. Đã quét %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 中的每个文件都是唯一的。上次扫描：%@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 中的每個檔案都是唯一的。掃描於 %@。"
          }
        }
      }
    },
    "Every month": {

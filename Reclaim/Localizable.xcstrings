          "stringUnit": {
            "state": "translated",
            "value": "Python-Pakete, die pip geladen oder erstellt hat. pip lädt sie bei Bedarf erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paquetes de Python que pip descargó o compiló. pip los vuelve a descargar cuando hace falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paquets Python téléchargés ou compilés par pip. pip les récupère à nouveau au besoin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "pip द्वारा डाउनलोड या बिल्ड किए गए Python पैकेज। ज़रूरत पड़ने पर pip इन्हें फिर से ले आता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket Python yang diunduh atau dibuat oleh pip. pip akan mengambilnya lagi saat diperlukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pacchetti Python scaricati o compilati da pip. pip li scarica di nuovo quando servono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "pip がダウンロードまたはビルドした Python パッケージです。必要に応じて pip が再取得します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "pip이 다운로드하거나 빌드한 Python 패키지입니다. 필요할 때 pip이 다시 가져옵니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "pip ഡൗൺലോഡ് ചെയ്തതോ ബിൽഡ് ചെയ്തതോ ആയ Python പാക്കേജുകൾ. ആവശ്യമുള്ളപ്പോൾ pip അവ വീണ്ടും ലഭ്യമാക്കും."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Python-pakketten die pip heeft gedownload of gebouwd. pip haalt ze zo nodig opnieuw op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakiety Pythona pobrane lub zbudowane przez pip. pip pobierze je ponownie w razie potrzeby."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pacotes Python que o pip baixou ou compilou. O pip os baixa novamente quando necessário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакеты Python, загруженные или собранные pip. pip загрузит их снова при необходимости."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Python-paket som pip har hämtat eller byggt. pip hämtar dem igen vid behov."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "pip பதிவிறக்கிய அல்லது உருவாக்கிய Python தொகுப்புகள். தேவைப்படும்போது pip அவற்றை மீண்டும் பெறும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แพ็กเกจ Python ที่ pip ดาวน์โหลดหรือบิลด์ไว้ pip จะดึงมาใหม่เมื่อต้องการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "pip'in indirdiği veya derlediği Python paketleri. pip gerektiğinde bunları yeniden indirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакети Python, викачані або зібрані pip. pip викачає їх знову за потреби."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các gói Python mà pip đã tải về hoặc build. pip sẽ tải lại khi cần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "pip 下载或构建的 Python 软件包。需要时 pip 会重新获取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "pip 下載或建置的 Python 套件。需要時 pip 會重新取得。"
          }
        }
      }
    },

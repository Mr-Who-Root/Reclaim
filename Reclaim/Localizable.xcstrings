    "A reviewed, step-by-step clean you approve": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنظيف مُراجَع خطوة بخطوة بموافقتك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine geprüfte Bereinigung Schritt für Schritt, die du freigibst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una limpieza revisada, paso a paso, que tú apruebas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nettoyage pas à pas, que vous approuvez"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समीक्षा की गई, चरण-दर-चरण सफ़ाई, जिसे आप स्वीकृत करते हैं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembersihan bertahap yang ditinjau dan Anda setujui"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pulizia passo passo, verificata e approvata da te"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認しながら、承認した項目だけを順番にクリーンアップ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 승인하는 단계별 검토 정리"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ അംഗീകരിക്കുന്ന, ഘട്ടം ഘട്ടമായി അവലോകനം ചെയ്ത ക്ലീനപ്പ്"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een gecontroleerde opschoning, stap voor stap door jou goedgekeurd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzone porządki krok po kroku, które zatwierdzasz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma limpeza revisada, passo a passo, aprovada por você"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пошаговая очистка, которую Вы проверяете и одобряете"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En granskad rensning steg för steg som du godkänner"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் அங்கீகரிக்கும், மதிப்பாய்வு செய்யப்பட்ட படிப்படியான சுத்தம்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การล้างข้อมูลทีละขั้นตอนที่ตรวจทานแล้วและคุณอนุมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onayladığınız, gözden geçirilmiş adım adım temizlik"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покрокове очищення, яке ви переглядаєте й схвалюєте"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dọn dẹp từng bước, được xem xét và do bạn phê duyệt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经过审阅、由你批准的分步清理"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "經您核准、逐步檢閱的清理"
          }
        }
      }
    },
    "A running app has this open. Quit it, then scan again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك تطبيق قيد التشغيل يفتح هذا العنصر. قم بإنهائه، ثم افحص مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine laufende App hat dies geöffnet. Beende sie und scanne dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una app abierta lo está usando. Sal de ella y vuelve a analizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une app en cours d'exécution utilise cet élément. Quittez-la, puis relancez l'analyse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक चल रहे ऐप ने इसे खोला हुआ है। उसे बंद करें, फिर दोबारा स्कैन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "App yang sedang berjalan membuka item ini. Keluar dari app tersebut, lalu pindai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È aperto in un'app in esecuzione. Esci dall'app, poi esegui di nuovo la scansione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中の App がこれを開いています。App を終了してから、もう一度スキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 중인 앱이 이 항목을 열고 있습니다. 앱을 종료한 다음 다시 스캔하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്രവർത്തിക്കുന്ന ഒരു ആപ്പ് ഇത് തുറന്നിട്ടുണ്ട്. അത് അടച്ച ശേഷം വീണ്ടും സ്കാൻ ചെയ്യുക."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een actieve app heeft dit geopend. Stop de app en scan opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działająca aplikacja ma to otwarte. Zakończ ją, a następnie przeskanuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um app em execução está usando isto. Encerre-o e analise novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это открыто в запущенном приложении. Завершите его и снова запустите сканирование."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En app som körs har detta öppet. Avsluta appen och skanna sedan igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இயங்கும் ஓர் ஆப் இதைத் திறந்து வைத்துள்ளது. அதிலிருந்து வெளியேறி, மீண்டும் ஸ்கேன் செய்யவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปที่กำลังทำงานเปิดรายการนี้อยู่ ออกจากแอปนั้น แล้วสแกนอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışan bir uygulama bunu açık tutuyor. Uygulamadan çıkın, ardından yeniden tarayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це відкрито в запущеній програмі. Завершіть її та проскануйте знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một ứng dụng đang chạy đang mở mục này. Hãy thoát ứng dụng đó, rồi quét lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某个正在运行的应用打开了此项。请退出该应用，然后重新扫描。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有執行中的 App 正在使用此項目。請結束該 App，然後再掃描一次。"
          }
        }
      }
    },

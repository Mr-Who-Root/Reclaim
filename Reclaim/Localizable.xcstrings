    "Merged small items can't be acted on individually": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تنفيذ إجراءات على العناصر الصغيرة المدمجة بشكل فردي"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammengefasste kleine Objekte können nicht einzeln bearbeitet werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos pequeños agrupados no se pueden gestionar individualmente"

          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillfälliga filer från Claude eller Claude Code, till exempel uppdateringsfiler och arbetsutdata."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புதுப்பிப்பு ஆயத்தக் கோப்புகள், தற்காலிக வெளியீடு போன்ற Claude அல்லது Claude Code இன் தற்காலிகக் கோப்புகள்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",

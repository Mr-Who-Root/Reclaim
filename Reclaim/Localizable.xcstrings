    "Temporary files from llama.cpp, vLLM or a similar local model runner.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporäre Dateien von llama.cpp, vLLM oder einem ähnlichen lokalen Modell-Runner."
          }

    "Review each suggestion. Adding to the plan doesn't carry it out.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع كل اقتراح. الإضافة إلى الخطة لا تعني تنفيذه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe jeden Vorschlag. Das Hinzufügen zum Plan führt ihn noch nicht aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa cada sugerencia. Añadirla al plan no la ejecuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Examinez chaque suggestion. L'ajouter au plan ne l'exécute pas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर सुझाव की समीक्षा करें। योजना में जोड़ने से वह लागू नहीं होता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinjau setiap saran. Menambahkan ke rencana tidak langsung menjalankannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esamina ogni suggerimento. Aggiungerlo al piano non lo esegue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各提案を確認してください。プランに追加しただけでは実行されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 제안을 검토하세요. 계획에 추가해도 바로 실행되지는 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ നിർദ്ദേശവും അവലോകനം ചെയ്യുക. പ്ലാനിലേക്ക് ചേർത്തതുകൊണ്ട് അത് നടപ്പിലാക്കില്ല."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beoordeel elke suggestie. Toevoegen aan het plan voert die nog niet uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejrzyj każdą sugestię. Dodanie do planu nie powoduje jej wykonania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise cada sugestão. Adicionar ao plano não a executa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просмотрите каждое предложение. Добавление в план не означает его выполнения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Granska varje förslag. Att lägga till det i planen innebär inte att det utförs."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு பரிந்துரையையும் மதிப்பாய்வு செய்யவும். திட்டத்தில் சேர்ப்பதால் அது செயல்படுத்தப்படாது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจทานแต่ละคำแนะนำ การเพิ่มไปยังแผนไม่ใช่การดำเนินการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her öneriyi inceleyin. Plana eklemek onu uygulamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перегляньте кожну пропозицію. Додавання до плану не означає її виконання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem lại từng đề xuất. Thêm vào kế hoạch không có nghĩa là thực hiện ngay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请审阅每条建议。添加到计划并不会执行它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢閱每項建議。加入計畫並不會執行它。"
          }
        }
      }
    },
    "Right-click a tile and choose Add to Collector to gather items, then remove them together.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر بزر الماوس الأيمن على مربع واختر «إضافة إلى المجمِّع» لجمع العناصر، ثم أزلها معًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke mit der rechten Maustaste auf eine Kachel und wähle „Zur Sammelablage hinzufügen“, um Objekte zu sammeln und dann gemeinsam zu entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic derecho en un bloque y elige «Añadir al recopilador» para reunir elementos y luego eliminarlos juntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez avec le bouton droit sur une tuile et choisissez Ajouter au collecteur pour rassembler des éléments, puis supprimez-les ensemble."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आइटम इकट्ठा करने के लिए किसी टाइल पर राइट-क्लिक करें और “संग्राहक में जोड़ें” चुनें, फिर उन्हें एक साथ हटाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik kanan petak dan pilih Tambahkan ke Pengumpul untuk mengumpulkan item, lalu hapus sekaligus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic con il tasto destro su un riquadro e scegli “Aggiungi al Raccoglitore” per raccogliere gli elementi, poi rimuovili insieme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイルを右クリックして「コレクターに追加」を選ぶと項目を集められ、まとめて削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타일을 오른쪽 클릭하고 ‘모음함에 추가’를 선택하여 항목을 모은 다음 한꺼번에 제거하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇനങ്ങൾ ശേഖരിക്കാൻ ഒരു ടൈലിൽ റൈറ്റ്-ക്ലിക്ക് ചെയ്ത് കളക്ടറിലേക്ക് ചേർക്കുക തിരഞ്ഞെടുക്കുക, തുടർന്ന് അവ ഒരുമിച്ച് നീക്കം ചെയ്യുക."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik met de rechtermuisknop op een tegel en kies ‘Voeg toe aan verzamelbak’ om onderdelen te verzamelen, en verwijder ze daarna in één keer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij kafelek prawym przyciskiem i wybierz Dodaj do zbioru, aby gromadzić rzeczy, a następnie usuń je razem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique com o botão direito em um bloco e escolha Adicionar ao Coletor para reunir itens e depois removê-los de uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите плитку правой кнопкой мыши и выберите «Добавить в подборку», чтобы собрать объекты, а затем удалите их вместе."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Högerklicka på en ruta och välj Lägg till i samlingskorgen för att samla objekt, och ta sedan bort dem tillsammans."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உருப்படிகளைச் சேகரிக்க ஒரு டைலை வலது-கிளிக் செய்து சேகரிப்பானில் சேர் என்பதைத் தேர்வுசெய்யவும், பிறகு அவற்றை ஒன்றாக அகற்றவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิกขวาที่ช่องแล้วเลือก เพิ่มไปยังถาดรวบรวม เพื่อรวบรวมรายการ แล้วเอาออกพร้อมกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğeleri toplamak için bir kutucuğu sağ tıklayıp Toplayıcıya Ekle'yi seçin, ardından hepsini birlikte kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацніть плитку правою кнопкою й виберіть «Додати до добірки», щоб зібрати елементи, а потім видаліть їх разом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm chuột phải vào một ô và chọn Thêm vào Khay gom để gom các mục, rồi gỡ bỏ chúng cùng lúc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右键点按一个方块并选择“添加到收集器”来收集项目，然后一起移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在區塊上按右鍵並選擇「加入收集器」來收集項目，然後一併移除。"
          }
        }
      }
    },
    "Right-click any tile to reveal, preview or trash it": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر بزر الماوس الأيمن على أي مربع لإظهاره أو معاينته أو نقله إلى سلة المهملات"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke mit der rechten Maustaste auf eine Kachel, um sie im Finder zu zeigen, eine Vorschau zu sehen oder sie in den Papierkorb zu legen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic derecho en cualquier bloque para mostrarlo, previsualizarlo o trasladarlo a la Papelera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez avec le bouton droit sur une tuile pour l'afficher dans le Finder, la prévisualiser ou la placer dans la Corbeille"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी टाइल को दिखाने, प्रीव्यू करने या ट्रैश में ले जाने के लिए उस पर राइट-क्लिक करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik kanan petak mana pun untuk menampilkan, melihat pratinjau, atau membuangnya ke Tong Sampah"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic con il tasto destro su un riquadro per mostrarlo, visualizzarne l'anteprima o spostarlo nel Cestino"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイルを右クリックすると、Finder での表示、プレビュー、ゴミ箱への移動ができます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타일을 오른쪽 클릭하여 보기, 미리보기 또는 휴지통으로 이동"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഏത് ടൈലും കാണിക്കാനോ പ്രിവ്യൂ ചെയ്യാനോ ട്രാഷിലേക്ക് നീക്കാനോ അതിൽ റൈറ്റ്-ക്ലിക്ക് ചെയ്യുക"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik met de rechtermuisknop op een tegel om die te tonen, te bekijken of naar de prullenmand te verplaatsen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij prawym przyciskiem dowolny kafelek, aby go pokazać, wyświetlić podgląd lub przenieść do Kosza"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique com o botão direito em um bloco para mostrá-lo, pré-visualizá-lo ou movê-lo para o Lixo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите любую плитку правой кнопкой мыши, чтобы показать ее, просмотреть или переместить в Корзину"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Högerklicka på en ruta för att visa, förhandsvisa eller slänga den"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எந்த டைலையும் காட்ட, முன்னோட்டமிட அல்லது குப்பைத் தொட்டிக்கு நகர்த்த அதை வலது-கிளிக் செய்யவும்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิกขวาที่ช่องใดก็ได้เพื่อแสดง ดูตัวอย่าง หรือย้ายไปที่ถังขยะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Göstermek, önizlemek veya Çöp Sepetine atmak için herhangi bir kutucuğu sağ tıklayın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацніть будь-яку плитку правою кнопкою, щоб показати, переглянути чи перемістити її в Смітник"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm chuột phải vào ô bất kỳ để hiển thị, xem trước hoặc chuyển vào Thùng rác"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右键点按任意方块即可在 Finder 中显示、预览或将其移到废纸篓"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任一區塊上按右鍵，即可顯示、預覽或丟到垃圾桶"
          }
        }
      }
    },

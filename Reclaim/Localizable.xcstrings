        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@) ട്രാഷിലേക്ക് നീക്കണോ?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@) naar de prullenmand verplaatsen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenieść %@ (%@) do Kosza?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover %@ (%@) para o Lixo?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переместить %@ (%@) в Корзину?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vill du flytta %@ (%@) till papperskorgen?"
          }
        },

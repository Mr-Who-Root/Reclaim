    "Keepers stay where they are.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى النسخ المحتفَظ بها في مكانها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behaltene Kopien bleiben, wo sie sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias conservadas se quedan donde están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les exemplaires conservés restent en place."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रखी जाने वाली कॉपियाँ जहाँ हैं, वहीं रहती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salinan yang disimpan tetap di tempatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le copie da conservare restano dove sono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残すファイルはそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유지 항목은 그대로 남습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സൂക്ഷിക്കുന്നവ അവ ഉള്ളിടത്ത് തന്നെ തുടരും."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaarde exemplaren blijven waar ze zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowywane kopie pozostają na miejscu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As cópias mantidas ficam onde estão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняемые копии остаются на месте."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiorna som behålls ligger kvar där de är."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வைத்திருக்கும் நகல்கள் அப்படியே இருக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำเนาที่เก็บไว้จะอยู่ที่เดิม"

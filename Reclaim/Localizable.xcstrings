    "The whole app changes with you. You can change it again any time in Settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتغير التطبيق بأكمله معك. يمكنك تغييره مجددًا في أي وقت من الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ganze App passt sich an. Du kannst das jederzeit in den Einstellungen wieder ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda la app cambia contigo. Puedes volver a cambiarlo cuando quieras en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute l'app s'adapte à votre choix. Vous pouvez le modifier à tout moment dans Réglages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरा ऐप आपके साथ बदलता है। आप इसे सेटिंग्ज़ में कभी भी फिर से बदल सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seluruh app berubah mengikuti Anda. Anda dapat mengubahnya lagi kapan saja di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutta l'app cambia con te. Puoi modificarlo di nuovo in qualsiasi momento in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App 全体があなたの選択に合わせて変わります。設定でいつでも変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 전체가 선택에 맞춰 바뀝니다. 언제든지 설정에서 다시 변경할 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആപ്പ് മുഴുവനും നിങ്ങൾക്കൊപ്പം മാറുന്നു. ക്രമീകരണത്തിൽ എപ്പോൾ വേണമെങ്കിലും ഇത് വീണ്ടും മാറ്റാം."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De hele app past zich aan. Je kunt dit op elk moment weer wijzigen in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cała aplikacja zmienia się razem z Tobą. Możesz to zmienić ponownie w dowolnej chwili w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app inteiro muda com você. Você pode alterar isso a qualquer momento em Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все приложение меняется вместе с Вами. Это можно изменить в любой момент в настройках."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hela appen ändras med dig. Du kan ändra det igen när som helst i Inställningar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முழு ஆப்பும் உங்களுடன் மாறும். அமைப்புகளில் எப்போது வேண்டுமானாலும் இதை மீண்டும் மாற்றலாம்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทั้งแอปจะเปลี่ยนตามคุณ คุณเปลี่ยนได้อีกทุกเมื่อในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm uygulama sizinle birlikte değişir. Ayarlar'dan istediğiniz zaman yeniden değiştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уся програма змінюється разом із вами. Це можна змінити будь-коли в параметрах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toàn bộ ứng dụng thay đổi theo bạn. Bạn có thể thay đổi lại bất cứ lúc nào trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整个应用会随之改变。你可以随时在“设置”中再次更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整個 App 會隨您的選擇改變。您隨時可以在「設定」中再次更改。"
          }
        }
      }
    },
    "The whole window takes on your colour.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تكتسي النافذة بأكملها بلونك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ganze Fenster nimmt deine Farbe an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda la ventana adopta tu color."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute la fenêtre adopte votre couleur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरी विंडो आपके रंग में रंग जाती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seluruh jendela mengikuti warna Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'intera finestra assume il colore scelto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウ全体があなたのカラーに染まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우 전체에 선택한 색상이 적용됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വിൻഡോ മുഴുവൻ നിങ്ങളുടെ നിറം സ്വീകരിക്കുന്നു."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het hele venster neemt je kleur aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Całe okno przyjmuje wybrany kolor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A janela inteira assume a sua cor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все окно окрашивается в выбранный цвет."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hela fönstret får din färg."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முழுச் சாளரமும் உங்கள் நிறத்தைப் பெறும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทั้งหน้าต่างจะเป็นสีที่คุณเลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm pencere sizin renginize bürünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе вікно набуває вибраного кольору."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toàn bộ cửa sổ mang màu bạn chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整个窗口都会采用你的颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整個視窗都會套用您選擇的顏色。"
          }
        }
      }
    },

          "stringUnit": {
            "state": "translated",
            "value": "يزيل كل الاقتراحات من الخطة. يتم الإبقاء على قرارات ترك العناصر دون تغيير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt alle Vorschläge aus dem Plan. Entscheidungen, Objekte unverändert zu lassen, bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita todas las sugerencias del plan. Se mantienen las decisiones de dejar elementos sin cambios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire toutes les suggestions du plan. Les décisions de laisser des éléments tels quels sont conservées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "योजना से हर सुझाव हटाता है। आइटम को बिना बदले छोड़ने के फ़ैसले बने रहते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus setiap saran dari rencana. Keputusan untuk membiarkan item tidak berubah tetap disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove tutti i suggerimenti dal piano. Le decisioni di lasciare invariati gli elementi vengono mantenute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランからすべての提案を削除します。「変更しない」の決定は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계획에서 모든 제안을 제거합니다. 항목을 그대로 두기로 한 결정은 유지됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്ലാനിൽ നിന്ന് എല്ലാ നിർദ്ദേശങ്ങളും നീക്കുന്നു. ഇനങ്ങൾ മാറ്റമില്ലാതെ വിടാനുള്ള തീരുമാനങ്ങൾ നിലനിർത്തും."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert alle suggesties uit het plan. Beslissingen om onderdelen ongewijzigd te laten, blijven behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa wszystkie sugestie z planu. Decyzje o pozostawieniu rzeczy bez zmian są zachowywane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove todas as sugestões do plano. As decisões de manter itens como estão são preservadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет все предложения из плана. Решения оставить объекты без изменений сохраняются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar bort alla förslag från planen. Beslut om att lämna objekt oförändrade behålls."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "திட்டத்திலிருந்து ஒவ்வொரு பரிந்துரையையும் அகற்றும். உருப்படிகளை மாற்றாமல் விடும் முடிவுகள் அப்படியே இருக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอาคำแนะนำทั้งหมดออกจากแผน การตัดสินใจคงรายการไว้ตามเดิมจะยังคงอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm önerileri plandan kaldırır. Öğeleri değiştirmeden bırakma kararları korunur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вилучає всі пропозиції з плану. Рішення залишити елементи без змін зберігаються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa mọi đề xuất khỏi kế hoạch. Các quyết định giữ nguyên mục vẫn được giữ lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从计划中移除所有建议。保持项目不变的决定会被保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從計畫中移除所有建議。讓項目保持不變的決定會保留。"
          }
        }
      }
    },

          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobrany plik nie jest prawidłową aplikacją Reclaim, więc nie został zainstalowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O download não é um app Reclaim válido, por isso não foi instalado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загруженный файл не является допустимым приложением Reclaim, поэтому он не был установлен."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämtningen är inte en giltig Reclaim-app, så den installerades inte."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிவிறக்கம் சரியான Reclaim ஆப் அல்ல, எனவே நிறுவப்படவில்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ที่ดาวน์โหลดไม่ใช่แอป Reclaim ที่ถูกต้อง จึงไม่ได้ติดตั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilen dosya geçerli bir Reclaim uygulaması olmadığı için yüklenmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Викачаний файл не є дійсною програмою Reclaim, тому його не встановлено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp tải về không phải ứng dụng Reclaim hợp lệ nên không được cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",

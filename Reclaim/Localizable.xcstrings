    "Open Settings › About to see what's new and install it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح الإعدادات › حول لمعرفة الجديد وتثبيت التحديث."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Einstellungen › Über, um die Neuerungen zu sehen und das Update zu installieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Ajustes › Acerca de para ver las novedades e instalar la actualización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Réglages › À propos pour découvrir les nouveautés et installer la mise à jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नया क्या है देखने और अपडेट इंस्टॉल करने के लिए सेटिंग्ज़ › परिचय खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Pengaturan › Tentang untuk melihat yang baru dan menginstal pembaruannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Impostazioni › Informazioni per vedere le novità e installare l'aggiornamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」›「情報」を開くと、新機能を確認してインストールできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 › 정보를 열어 새로운 기능을 확인하고 설치하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പുതിയതെന്തെന്ന് കാണാനും അപ്‌ഡേറ്റ് ഇൻസ്റ്റാൾ ചെയ്യാനും ക്രമീകരണം › വിവരം തുറക്കുക."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Instellingen › Info om te zien wat er nieuw is en de update te installeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Ustawienia › Informacje, aby zobaczyć nowości i zainstalować uaktualnienie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Ajustes › Sobre para ver as novidades e instalar a atualização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте «Настройки» › «О программе», чтобы узнать о новых функциях и установить обновление."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Inställningar › Om för att se nyheterna och installera uppdateringen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புதியவற்றைப் பார்த்துப் புதுப்பிப்பை நிறுவ, அமைப்புகள் › பற்றி என்பதைத் திறக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด การตั้งค่า › เกี่ยวกับ เพื่อดูสิ่งใหม่และติดตั้งการอัปเดต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yenilikleri görmek ve güncellemeyi yüklemek için Ayarlar › Hakkında bölümünü açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте «Параметри» › «Про програму», щоб переглянути новинки й встановити уточнення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Cài đặt › Giới thiệu để xem có gì mới và cài đặt bản cập nhật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“设置”›“关于”查看新功能并安装更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開「設定」›「關於」即可查看新功能並安裝。"
          }
        }
      }
    },

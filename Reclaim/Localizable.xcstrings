    "A throwaway browser profile left by browser automation, often driven by AI agents.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف تعريف متصفح مؤقت خلّفته أتمتة المتصفح، التي يقودها غالبًا وكلاء الذكاء الاصطناعي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein temporäres Browserprofil, das Browserautomatisierung zurückgelassen hat – oft von KI-Agenten gesteuert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un perfil de navegador desechable que deja la automatización del navegador, a menudo controlada por agentes de IA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un profil de navigateur jetable laissé par l'automatisation de navigateur, souvent pilotée par des agents IA."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्राउज़र ऑटोमेशन द्वारा छोड़ी गई अस्थायी ब्राउज़र प्रोफ़ाइल, जिसे अक्सर AI एजेंट चलाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil browser sekali pakai yang ditinggalkan oleh otomatisasi browser, sering kali dijalankan oleh agen AI."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un profilo browser temporaneo lasciato dall'automazione del browser, spesso gestita da agenti IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザ自動化（多くは AI エージェントによる）が残した使い捨てのブラウザプロファイルです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저 자동화(주로 AI 에이전트가 실행)가 남긴 일회용 브라우저 프로필입니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബ്രൗസർ ഓട്ടോമേഷൻ ബാക്കിവെച്ച ഒരു താൽക്കാലിക ബ്രൗസർ പ്രൊഫൈൽ, പലപ്പോഴും AI ഏജന്റുകൾ പ്രവർത്തിപ്പിക്കുന്നത്."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een wegwerpbrowserprofiel dat is achtergelaten door browserautomatisering, vaak aangestuurd door AI-agents."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tymczasowy profil przeglądarki pozostawiony przez automatyzację przeglądarki, często sterowaną przez agentów AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um perfil de navegador descartável deixado por automação de navegador, geralmente controlada por agentes de IA."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одноразовый профиль браузера, оставленный автоматизацией браузера, которую часто запускают ИИ-агенты."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En tillfällig webbläsarprofil som lämnats kvar av webbläsarautomatisering, ofta styrd av AI-agenter."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உலாவி ஆட்டோமேஷன் விட்டுச்சென்ற தற்காலிக உலாவி சுயவிவரம்; பெரும்பாலும் AI ஏஜென்ட்களால் இயக்கப்படுவது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรไฟล์เบราว์เซอร์แบบใช้แล้วทิ้งที่การทำงานอัตโนมัติของเบราว์เซอร์ทิ้งไว้ ซึ่งมักควบคุมโดยเอเจนต์ AI"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genellikle YZ ajanlarınca yürütülen tarayıcı otomasyonunun bıraktığı geçici bir tarayıcı profili."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одноразовий профіль браузера, залишений автоматизацією браузера, яку часто запускають ШІ-агенти."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hồ sơ trình duyệt dùng một lần do công cụ tự động hóa trình duyệt để lại, thường do tác tử AI điều khiển."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器自动化留下的临时浏览器配置文件，通常由 AI 智能体驱动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏覽器自動化（通常由 AI 代理程式驅動）留下的一次性瀏覽器描述檔。"
          }
        }
      }
    },

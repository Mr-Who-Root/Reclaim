        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் Mac ஸ்கேன் செய்யப்படுகிறது…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在扫描你的 Mac…"
          }
        }
      }
    },
    "Scanning…": {},
    "Scans Downloads, Desktop & Documents, your Home folder, or any folder": {},
    "Scans in progress stop. Your results, history and settings are kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laufende Scans werden gestoppt. Deine Ergebnisse, dein Verlauf und deine Einstellungen bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los análisis en curso se detendrán. Se conservan tus resultados, historial y ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les analyses en cours s'arrêtent. Vos résultats, votre historique et vos réglages sont conservés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चल रहे स्कैन रुक जाते हैं। आपके परिणाम, इतिहास और सेटिंग्ज़ बनी रहती हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進行中のスキャンは停止します。結果、履歴、設定は保持されます。"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നടന്നുകൊണ്ടിരിക്കുന്ന സ്കാനുകൾ നിർത്തും. നിങ്ങളുടെ ഫലങ്ങൾ, ചരിത്രം, ക്രമീകരണം എന്നിവ നിലനിർത്തും."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நடந்துகொண்டிருக்கும் ஸ்கேன்கள் நிறுத்தப்படும். உங்கள் முடிவுகள், வரலாறு, அமைப்புகள் வைக்கப்படும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在进行的扫描将停止。你的结果、历史记录和设置会保留。"
          }
        }
      }
    },
    "Scans your Downloads, Movies, Documents and Desktop by default — or your Home folder, or any folder you pick. Filter by size, age and kind to find what's worth removing.": {},

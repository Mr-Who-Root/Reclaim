    "Installers and archives older than 30 days, and large files older than six months": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدوات التثبيت والأرشيفات الأقدم من 30 يومًا، والملفات الكبيرة الأقدم من ستة أشهر"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installationsprogramme und Archive, die älter als 30 Tage sind, und große Dateien, die älter als sechs Monate sind"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instaladores y archivos comprimidos de más de 30 días, y archivos grandes de más de seis meses"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeurs et archives de plus de 30 jours, et gros fichiers de plus de six mois"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "30 दिन से पुराने इंस्टॉलर और आर्काइव, और छह महीने से पुरानी बड़ी फ़ाइलें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer dan arsip yang lebih lama dari 30 hari, serta file besar yang lebih lama dari enam bulan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer e archivi più vecchi di 30 giorni e file grandi più vecchi di sei mesi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30 日以上前のインストーラとアーカイブ、6 か月以上前の大きなファイル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "30일이 지난 설치 프로그램 및 압축 파일, 6개월이 지난 대용량 파일"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "30 ദിവസത്തിലേറെ പഴക്കമുള്ള ഇൻസ്റ്റാളറുകളും ആർക്കൈവുകളും, ആറ് മാസത്തിലേറെ പഴക്കമുള്ള വലിയ ഫയലുകളും"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installatieprogramma's en archieven ouder dan 30 dagen, en grote bestanden ouder dan zes maanden"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalatory i archiwa starsze niż 30 dni oraz duże pliki starsze niż sześć miesięcy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instaladores e arquivos compactados com mais de 30 dias e arquivos grandes com mais de seis meses"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установщики и архивы старше 30 дней, а также большие файлы старше полугода"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Installerare och arkiv som är äldre än 30 dagar och stora filer som är äldre än sex månader"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "30 நாட்களுக்கு மேற்பட்ட நிறுவிகள், காப்பகங்கள் மற்றும் ஆறு மாதங்களுக்கு மேற்பட்ட பெரிய கோப்புகள்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวติดตั้งและไฟล์บีบอัดที่เก่ากว่า 30 วัน และไฟล์ใหญ่ที่เก่ากว่าหกเดือน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "30 günden eski yükleyiciler ve arşivler ile altı aydan eski büyük dosyalar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інсталятори й архіви, старші за 30 днів, а також великі файли, старші за пів року"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trình cài đặt và tệp nén cũ hơn 30 ngày, và tệp lớn cũ hơn sáu tháng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超过 30 天的安装器和归档文件，以及超过六个月的大文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "超過 30 天的安裝程式和壓縮檔，以及超過六個月的大型檔案"
          }
        }
      }
    },

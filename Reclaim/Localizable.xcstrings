    "Ask macOS to move items to the Trash, and restore them": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب من macOS نقل العناصر إلى سلة المهملات واستعادتها"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS bitten, Objekte in den Papierkorb zu legen und wiederherzustellen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide a macOS que traslade elementos a la Papelera y que los restaure"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander à macOS de placer des éléments dans la Corbeille, et de les restaurer"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS से आइटम ट्रैश में ले जाने और उन्हें पुनर्स्थापित करने के लिए कहें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Minta macOS memindahkan item ke Tong Sampah, dan memulihkannya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedere a macOS di spostare gli elementi nel Cestino e di ripristinarli"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS に依頼して項目をゴミ箱に入れたり、元に戻したりします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS에 항목을 휴지통으로 이동하고 복원하도록 요청"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇനങ്ങൾ ട്രാഷിലേക്ക് നീക്കാനും അവ പുനഃസ്ഥാപിക്കാനും macOS-നോട് ആവശ്യപ്പെടുക"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS vragen onderdelen naar de prullenmand te verplaatsen en ze terug te zetten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proś macOS o przenoszenie rzeczy do Kosza i ich przywracanie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedir ao macOS para mover itens para o Lixo e restaurá-los"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просить macOS перемещать объекты в Корзину и восстанавливать их"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Be macOS att flytta objekt till papperskorgen och återställa dem"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உருப்படிகளைக் குப்பைத் தொட்டிக்கு நகர்த்தவும் மீட்டெடுக்கவும் macOS இடம் கோரும்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอให้ macOS ย้ายรายการไปยังถังขยะ และกู้คืนรายการเหล่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğeleri Çöp Sepetine taşımasını ve geri yüklemesini macOS'ten ister"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Просити macOS переміщувати елементи в Смітник і відновлювати їх"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu macOS chuyển các mục vào Thùng rác và khôi phục chúng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求 macOS 将项目移到废纸篓并恢复它们"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請 macOS 將項目移到垃圾桶，並將其回復"
          }
        }
      }
    },
    "Asking Docker what it stores…": {
      "localizations": {

            "value": "Відкриває %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“%@”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開 %@"
          }
        }
      }
    },
    "Opens Finder so you can inspect items Reclaim moved to the Trash.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح Finder لتتمكن من فحص العناصر التي نقلها Reclaim إلى سلة المهملات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet den Finder, damit du Objekte prüfen kannst, die Reclaim in den Papierkorb gelegt hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el Finder para que puedas revisar los elementos que Reclaim trasladó a la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre le Finder pour inspecter les éléments que Reclaim a placés dans la Corbeille."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder खोलता है ताकि आप Reclaim द्वारा ट्रैश में ले जाए गए आइटम देख सकें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka Finder agar Anda dapat memeriksa item yang dipindahkan Reclaim ke Tong Sampah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre il Finder per controllare gli elementi che Reclaim ha spostato nel Cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder を開き、Reclaim がゴミ箱に移動した項目を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder를 열어 Reclaim이 휴지통으로 이동한 항목을 확인할 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim ട്രാഷിലേക്ക് നീക്കിയ ഇനങ്ങൾ പരിശോധിക്കാൻ Finder തുറക്കുന്നു."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent Finder zodat je de onderdelen kunt bekijken die Reclaim naar de prullenmand heeft verplaatst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera Findera, aby można było sprawdzić rzeczy przeniesione przez Reclaim do Kosza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Finder para você inspecionar os itens que o Reclaim moveu para o Lixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает Finder, чтобы Вы могли просмотреть объекты, перемещенные Reclaim в Корзину."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar Finder så att du kan granska objekt som Reclaim har flyttat till papperskorgen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim குப்பைத் தொட்டிக்கு நகர்த்திய உருப்படிகளை ஆய்வு செய்ய Finder ஐத் திறக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Finder เพื่อให้คุณตรวจดูรายการที่ Reclaim ย้ายไปที่ถังขยะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim'in Çöp Sepetine taşıdığı öğeleri inceleyebilmeniz için Finder'ı açar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває Finder, щоб ви могли переглянути елементи, переміщені Reclaim у Смітник."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Finder để bạn có thể kiểm tra các mục Reclaim đã chuyển vào Thùng rác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Finder，以便检查 Reclaim 移到废纸篓的项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開 Finder，讓您查看 Reclaim 移到垃圾桶的項目。"
          }
        }
      }
    },
    "Opens Reclaim and runs every cleanup tool plus a read-only Security Check. You review everything before anything moves.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح Reclaim ويشغّل كل أدوات التنظيف بالإضافة إلى فحص أمان للقراءة فقط. تراجع كل شيء قبل نقل أي شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Reclaim und führt alle Bereinigungswerkzeuge plus eine rein lesende Sicherheitsprüfung aus. Du prüfst alles, bevor etwas verschoben wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Reclaim y ejecuta todas las herramientas de limpieza más una Revisión de seguridad de solo lectura. Lo revisas todo antes de que se mueva nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Reclaim et lance chaque outil de nettoyage, plus un Contrôle de sécurité en lecture seule. Vous examinez tout avant que quoi que ce soit ne bouge."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim खोलता है और हर सफ़ाई टूल के साथ केवल-पठन सुरक्षा जाँच चलाता है। कुछ भी हटने से पहले आप सब कुछ की समीक्षा करते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka Reclaim dan menjalankan semua alat pembersihan plus Pemeriksaan Keamanan hanya-baca. Anda meninjau semuanya sebelum ada yang dipindahkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre Reclaim ed esegue tutti gli strumenti di pulizia più un Controllo sicurezza in sola lettura. Esamini tutto prima che venga spostato qualcosa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim を開いて、すべてのクリーンアップツールと読み取り専用のセキュリティチェックを実行します。何かが移動される前に、すべてを確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim을 열고 모든 정리 도구와 읽기 전용 보안 검사를 실행합니다. 무엇이든 이동되기 전에 모든 항목을 검토합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim തുറന്ന് എല്ലാ ക്ലീനപ്പ് ടൂളുകളും റീഡ്-ഒൺലി സുരക്ഷാ പരിശോധനയും റൺ ചെയ്യുന്നു. എന്തെങ്കിലും നീങ്ങുന്നതിന് മുമ്പ് നിങ്ങൾ എല്ലാം അവലോകനം ചെയ്യും."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent Reclaim en voert alle opschoontools uit plus een alleen-lezen Beveiligingscontrole. Je beoordeelt alles voordat er iets wordt verplaatst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera Reclaim i uruchamia wszystkie narzędzia porządkowe oraz Kontrolę bezpieczeństwa tylko do odczytu. Wszystko przeglądasz, zanim cokolwiek zostanie przeniesione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Reclaim e executa todas as ferramentas de limpeza, mais uma Verificação de Segurança somente leitura. Você revisa tudo antes que algo seja movido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает Reclaim и запускает все инструменты очистки плюс Проверку безопасности только для чтения. Вы проверяете все, прежде чем что-либо будет перемещено."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar Reclaim och kör alla rensningsverktyg plus en skrivskyddad säkerhetskontroll. Du granskar allt innan något flyttas."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim ஐத் திறந்து அனைத்துச் சுத்தம் செய்யும் கருவிகளையும், படிக்க மட்டுமான பாதுகாப்புச் சோதனையையும் இயக்கும். எதுவும் நகரும் முன் அனைத்தையும் நீங்கள் மதிப்பாய்வு செய்யலாம்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Reclaim และเรียกใช้ทุกเครื่องมือล้างข้อมูล พร้อมตรวจสอบความปลอดภัยแบบอ่านอย่างเดียว คุณจะได้ตรวจทานทุกอย่างก่อนที่จะมีการย้ายสิ่งใด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim'i açar; tüm temizlik araçlarını ve salt okunur bir Güvenlik Kontrolü'nü çalıştırır. Herhangi bir şey taşınmadan önce her şeyi siz incelersiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває Reclaim і запускає всі інструменти очищення плюс Перевірку безпеки лише для читання. Ви переглядаєте все, перш ніж щось буде переміщено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Reclaim và chạy mọi công cụ dọn dẹp cùng với Kiểm tra bảo mật chỉ đọc. Bạn xem lại mọi thứ trước khi bất cứ thứ gì bị di chuyển."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Reclaim 并运行所有清理工具，外加只读的安全检查。在移动任何内容之前，你会审阅所有结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開 Reclaim 並執行所有清理工具，外加唯讀的安全性檢查。在移動任何項目之前，您都會先檢閱所有內容。"
          }
        }
      }
    },
    "Opens Reclaim's approval-first cleanup review. Nothing changes until you confirm a final plan.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح مراجعة التنظيف في Reclaim التي تشترط موافقتك أولًا. لن يتغير أي شيء حتى تؤكد خطة نهائية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die Bereinigungsprüfung von Reclaim, bei der zuerst du zustimmst. Es ändert sich nichts, bis du einen endgültigen Plan bestätigst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la revisión de limpieza de Reclaim, que requiere tu aprobación. No cambia nada hasta que confirmes un plan final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre l'examen de nettoyage de Reclaim, soumis à votre approbation. Rien ne change tant que vous n'avez pas confirmé un plan final."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim की स्वीकृति-आधारित सफ़ाई समीक्षा खोलता है। जब तक आप अंतिम योजना की पुष्टि नहीं करते, कुछ नहीं बदलता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka tinjauan pembersihan Reclaim yang mengutamakan persetujuan. Tidak ada yang berubah hingga Anda mengonfirmasi rencana akhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre la revisione di pulizia di Reclaim, che richiede sempre la tua approvazione. Nulla cambia finché non confermi un piano finale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認を前提とした Reclaim のクリーンアップレビューを開きます。最終プランを確定するまで何も変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인 우선 방식의 Reclaim 정리 검토를 엽니다. 최종 계획을 확인하기 전에는 아무것도 변경되지 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അംഗീകാരത്തിന് മുൻഗണന നൽകുന്ന Reclaim-ന്റെ ക്ലീനപ്പ് അവലോകനം തുറക്കുന്നു. നിങ്ങൾ അന്തിമ പ്ലാൻ സ്ഥിരീകരിക്കുന്നത് വരെ ഒന്നും മാറില്ല."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent de opschoonbeoordeling van Reclaim, waarbij jij eerst goedkeurt. Er verandert niets totdat je een definitief plan bevestigt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera w Reclaim przegląd porządków wymagający Twojej zgody. Nic się nie zmieni, dopóki nie potwierdzisz ostatecznego planu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre a revisão de limpeza do Reclaim, que exige sua aprovação. Nada muda até você confirmar um plano final."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает в Reclaim обзор очистки с предварительным одобрением. Ничего не изменится, пока Вы не подтвердите итоговый план."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar Reclaims rensningsgranskning där du godkänner allt först. Inget ändras förrän du bekräftar en slutlig plan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim இன் ஒப்புதல்-முதல் சுத்தம் மதிப்பாய்வைத் திறக்கும். இறுதித் திட்டத்தை நீங்கள் உறுதிசெய்யும் வரை எதுவும் மாறாது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดการตรวจทานการล้างข้อมูลแบบต้องอนุมัติก่อนของ Reclaim ไม่มีสิ่งใดเปลี่ยนแปลงจนกว่าคุณจะยืนยันแผนขั้นสุดท้าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim'in önce onay isteyen temizlik incelemesini açar. Son bir planı onaylayana kadar hiçbir şey değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває в Reclaim огляд очищення з попереднім схваленням. Нічого не зміниться, доки ви не підтвердите остаточний план."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở phần xem lại dọn dẹp cần phê duyệt trước của Reclaim. Không có gì thay đổi cho đến khi bạn xác nhận kế hoạch cuối cùng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Reclaim 的“先批准、后清理”审阅。在你确认最终计划之前，不会进行任何更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開 Reclaim 的「先核准再清理」檢閱流程。在您確認最終計畫之前，不會更改任何內容。"
          }
        }
      }
    },
    "Opens a Reclaim tool so you can review its results.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح أداة في Reclaim لتتمكن من مراجعة نتائجها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet ein Reclaim-Werkzeug, damit du seine Ergebnisse prüfen kannst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre una herramienta de Reclaim para que puedas revisar sus resultados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre un outil Reclaim pour examiner ses résultats."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई Reclaim टूल खोलता है ताकि आप उसके परिणामों की समीक्षा कर सकें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka alat Reclaim agar Anda dapat meninjau hasilnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre uno strumento di Reclaim per esaminarne i risultati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim のツールを開いて、結果を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim 도구를 열어 결과를 검토할 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫലങ്ങൾ അവലോകനം ചെയ്യാൻ ഒരു Reclaim ടൂൾ തുറക്കുന്നു."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent een Reclaim-tool zodat je de resultaten kunt beoordelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera narzędzie Reclaim, aby można było przejrzeć jego wyniki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre uma ferramenta do Reclaim para você revisar os resultados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает инструмент Reclaim, чтобы Вы могли просмотреть его результаты."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar ett Reclaim-verktyg så att du kan granska resultaten."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முடிவுகளை மதிப்பாய்வு செய்ய Reclaim கருவியைத் திறக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดเครื่องมือ Reclaim เพื่อให้คุณตรวจทานผลลัพธ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonuçlarını inceleyebilmeniz için bir Reclaim aracını açar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває інструмент Reclaim, щоб ви могли переглянути його результати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở một công cụ Reclaim để bạn xem lại kết quả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Reclaim 工具以审阅其结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開 Reclaim 工具，讓您檢閱其結果。"
          }
        }
      }
    },
    "Opens a final confirmation. It does not perform any action yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح تأكيدًا نهائيًا. لا ينفّذ أي إجراء بعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet eine abschließende Bestätigung. Es wird noch keine Aktion ausgeführt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre una confirmación final. Todavía no realiza ninguna acción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre une confirmation finale. Aucune action n'est encore effectuée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंतिम पुष्टि खोलता है। यह अभी कोई कार्रवाई नहीं करता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka konfirmasi akhir. Belum ada tindakan yang dijalankan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre una conferma finale. Non esegue ancora alcuna azione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終確認を開きます。まだ操作は実行されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최종 확인 화면을 엽니다. 아직 어떤 작업도 수행하지 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു അന്തിമ സ്ഥിരീകരണം തുറക്കുന്നു. ഇപ്പോൾ ഒരു പ്രവർത്തനവും നടത്തുന്നില്ല."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent een laatste bevestiging. Er wordt nog geen actie uitgevoerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera ostateczne potwierdzenie. Nie wykonuje jeszcze żadnej czynności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre uma confirmação final. Nenhuma ação é executada ainda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает окончательное подтверждение. Пока никакие действия не выполняются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar en slutlig bekräftelse. Ingen åtgärd utförs ännu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இறுதி உறுதிப்படுத்தலைத் திறக்கும். இது இன்னும் எந்தச் செயலையும் செய்யாது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดการยืนยันขั้นสุดท้าย ยังไม่มีการดำเนินการใดๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son bir onay penceresi açar. Henüz hiçbir işlem gerçekleştirmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває остаточне підтвердження. Поки що жодні дії не виконуються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở bước xác nhận cuối cùng. Chưa thực hiện thao tác nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开最终确认。暂不执行任何操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開最終確認畫面。目前尚不會執行任何動作。"
          }
        }
      }
    },
    "Opens an on-device assistant that can answer questions about this review and add suggestions to your plan.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح مساعدًا يعمل على الجهاز يمكنه الإجابة عن أسئلة حول هذه المراجعة وإضافة اقتراحات إلى خطتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet einen Assistenten auf dem Gerät, der Fragen zu dieser Überprüfung beantworten und Vorschläge zu deinem Plan hinzufügen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un asistente en el dispositivo que puede responder preguntas sobre esta revisión y añadir sugerencias a tu plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre un assistant sur l'appareil qui peut répondre à vos questions sur cet examen et ajouter des suggestions à votre plan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस पर चलने वाला सहायक खोलता है, जो इस समीक्षा के बारे में सवालों के जवाब दे सकता है और आपकी योजना में सुझाव जोड़ सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka asisten di perangkat yang dapat menjawab pertanyaan tentang tinjauan ini dan menambahkan saran ke rencana Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre un assistente sul dispositivo che può rispondere a domande su questa revisione e aggiungere suggerimenti al piano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレビューに関する質問に答え、提案をプランに追加できるオンデバイスのアシスタントを開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 검토에 대한 질문에 답하고 계획에 제안을 추가할 수 있는 기기 내 어시스턴트를 엽니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ അവലോകനത്തെക്കുറിച്ചുള്ള ചോദ്യങ്ങൾക്ക് ഉത്തരം നൽകാനും നിങ്ങളുടെ പ്ലാനിലേക്ക് നിർദ്ദേശങ്ങൾ ചേർക്കാനും കഴിയുന്ന, ഉപകരണത്തിൽ തന്നെ പ്രവർത്തിക്കുന്ന ഒരു അസിസ്റ്റന്റ് തുറക്കുന്നു."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent een assistent op het apparaat die vragen over deze beoordeling kan beantwoorden en suggesties aan je plan kan toevoegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera asystenta działającego na urządzeniu, który odpowie na pytania o ten przegląd i doda sugestie do planu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre um assistente no dispositivo que pode responder perguntas sobre esta revisão e adicionar sugestões ao seu plano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает ассистента на устройстве, который ответит на вопросы об этом обзоре и добавит предложения в план."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar en assistent på enheten som kan svara på frågor om den här granskningen och lägga till förslag i din plan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த மதிப்பாய்வு பற்றிய கேள்விகளுக்குப் பதிலளித்து, உங்கள் திட்டத்தில் பரிந்துரைகளைச் சேர்க்கக்கூடிய, சாதனத்திலேயே இயங்கும் உதவியாளரைத் திறக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดผู้ช่วยบนอุปกรณ์ที่ตอบคำถามเกี่ยวกับการตรวจทานนี้และเพิ่มคำแนะนำไปยังแผนของคุณได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu incelemeyle ilgili soruları yanıtlayabilen ve planınıza öneri ekleyebilen, aygıt üzerinde çalışan bir asistan açar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває асистента на пристрої, який відповість на запитання про цей огляд і додасть пропозиції до плану."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở trợ lý trên thiết bị có thể trả lời câu hỏi về lần xem lại này và thêm đề xuất vào kế hoạch của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开一个设备端助手，它可以回答有关此次审阅的问题，并向你的计划添加建议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開裝置上的助理，可回答與此檢閱相關的問題，並將建議加入您的計畫。"
          }
        }
      }
    },
    "Optional. Needed for Mail, iPhone backups, the Trash and other apps' data.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختياري. مطلوب للبريد ونسخ iPhone الاحتياطية وسلة المهملات وبيانات التطبيقات الأخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Erforderlich für Mail, iPhone-Backups, den Papierkorb und Daten anderer Apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Necesario para Mail, las copias de seguridad del iPhone, la Papelera y los datos de otras apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Nécessaire pour Mail, les sauvegardes d'iPhone, la Corbeille et les données d'autres apps."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक। Mail, iPhone बैकअप, ट्रैश और अन्य ऐप्स के डेटा के लिए ज़रूरी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsional. Diperlukan untuk Mail, cadangan iPhone, Tong Sampah, dan data app lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo. Necessario per Mail, i backup di iPhone, il Cestino e i dati di altre app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オプション。メール、iPhone のバックアップ、ゴミ箱、ほかの App のデータに必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항. Mail, iPhone 백업, 휴지통 및 다른 앱의 데이터에 필요합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓപ്ഷണൽ. Mail, iPhone ബാക്കപ്പുകൾ, ട്രാഷ്, മറ്റ് ആപ്പുകളുടെ ഡാറ്റ എന്നിവയ്ക്ക് ആവശ്യമാണ്."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optioneel. Nodig voor Mail, iPhone-reservekopieën, de prullenmand en gegevens van andere apps."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalnie. Potrzebny do aplikacji Mail, kopii zapasowych iPhone'a, Kosza i danych innych aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Necessário para o Mail, backups do iPhone, o Lixo e dados de outros apps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательно. Нужен для Почты, резервных копий iPhone, Корзины и данных других приложений."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valfritt. Krävs för Mail, iPhone-säkerhetskopior, papperskorgen och andra appars data."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விருப்பத்தேர்வு. Mail, iPhone காப்புப்பிரதிகள், குப்பைத் தொட்டி மற்றும் பிற ஆப்ஸின் தரவுக்குத் தேவை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่บังคับ จำเป็นสำหรับ Mail ข้อมูลสำรอง iPhone ถังขยะ และข้อมูลของแอปอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı. Mail, iPhone yedekleri, Çöp Sepeti ve diğer uygulamaların verileri için gereklidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Необов’язково. Потрібен для Пошти, резервних копій iPhone, Смітника й даних інших програм."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy chọn. Cần cho Mail, bản sao lưu iPhone, Thùng rác và dữ liệu của ứng dụng khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。访问邮件、iPhone 备份、废纸篓和其他应用的数据时需要。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選用。「郵件」、iPhone 備份、垃圾桶和其他 App 的資料需要此權限。"
          }
        }
      }
    },

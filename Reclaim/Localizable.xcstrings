          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பட்டியல் மட்டுமே அழிக்கப்படும். குப்பைத் தொட்டியில் உள்ள எதுவும் தொடப்படாது."
          }

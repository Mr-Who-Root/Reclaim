    "Leaves alone anything a running app has open": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتجنب أي شيء يفتحه تطبيق قيد التشغيل"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt alles unberührt, was eine laufende App geöffnet hat"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No toca nada que tenga abierto una app en ejecución"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignore tout ce qu'une app en cours d'exécution a ouvert"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी चल रहे ऐप ने जो कुछ भी खोला हुआ है, उसे नहीं छूता"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membiarkan apa pun yang sedang dibuka oleh app yang berjalan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non tocca nulla che sia aperto in un'app in esecuzione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中の App が開いているものには手を加えません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 중인 앱이 열고 있는 항목은 건드리지 않습니다"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്രവർത്തിക്കുന്ന ഒരു ആപ്പ് തുറന്നുവെച്ചിട്ടുള്ളതൊന്നും തൊടില്ല"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat alles ongemoeid wat een actieve app geopend heeft"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomija wszystko, co ma otwarte działająca aplikacja"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não mexe em nada que um app em execução esteja usando"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не трогает ничего, что открыто в запущенных приложениях"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rör inget som en app som körs har öppet"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இயங்கும் ஆப் திறந்து வைத்துள்ள எதையும் தொடாது"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่แตะต้องสิ่งที่แอปที่กำลังทำงานเปิดอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışan bir uygulamanın açık tuttuğu hiçbir şeye dokunmaz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не зачіпає нічого, що відкрито в запущених програмах"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không động đến bất kỳ thứ gì mà ứng dụng đang chạy đang mở"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会触碰正在运行的应用所打开的任何内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不處理執行中的 App 正在使用的任何項目"
          }
        }
      }
    },

    "Never deletes permanently — you empty the Trash yourself": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحذف نهائيًا أبدًا — أنت من يفرغ سلة المهملات"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht nie endgültig – du entleerst den Papierkorb selbst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca elimina nada de forma permanente: tú vacías la Papelera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne supprime jamais définitivement : c'est vous qui videz la Corbeille"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कभी स्थायी रूप से डिलीट नहीं करता — ट्रैश आप ख़ुद ख़ाली करते हैं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak pernah menghapus secara permanen — Anda sendiri yang mengosongkan Tong Sampah"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non elimina mai definitivamente: sei tu a svuotare il Cestino"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全に削除することはありません。ゴミ箱を空にするのはあなた自身です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영구 삭제하지 않습니다. 휴지통은 직접 비웁니다"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരിക്കലും ശാശ്വതമായി ഇല്ലാതാക്കില്ല — ട്രാഷ് ശൂന്യമാക്കുന്നത് നിങ്ങൾ തന്നെ"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert nooit definitief — je leegt de prullenmand zelf"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nigdy nie usuwa trwale — Kosz opróżniasz samodzielnie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca apaga permanentemente — você mesmo esvazia o Lixo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не удаляется навсегда — Корзину Вы очищаете сами"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Raderar aldrig permanent – du tömmer papperskorgen själv"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒருபோதும் நிரந்தரமாக நீக்காது — குப்பைத் தொட்டியை நீங்களே காலியாக்குவீர்கள்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ลบอย่างถาวร — คุณล้างถังขยะเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asla kalıcı olarak silmez — Çöp Sepetini kendiniz boşaltırsınız"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніщо не видаляється назавжди — Смітник ви спорожнюєте самі"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không bao giờ xóa vĩnh viễn — bạn tự dọn sạch Thùng rác"
          }
        },
        "zh-Hans": {
          "stringUnit": {

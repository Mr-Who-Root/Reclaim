    "Apple signed this as part of the operating system.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وقّعته Apple كجزء من نظام التشغيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hat dies als Teil des Betriebssystems signiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple lo ha firmado como parte del sistema operativo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signé par Apple en tant que composant du système d'exploitation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ने ऑपरेटिंग सिस्टम के हिस्से के रूप में इस पर हस्ताक्षर किए हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple menandatanganinya sebagai bagian dari sistem operasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Firmato da Apple come parte del sistema operativo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オペレーティングシステムの一部として Apple が署名しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple이 운영 체제의 일부로 서명했습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓപ്പറേറ്റിംഗ് സിസ്റ്റത്തിന്റെ ഭാഗമായി Apple ഇത് സൈൻ ചെയ്തു."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple heeft dit ondertekend als onderdeel van het besturingssysteem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple podpisało to jako część systemu operacyjnego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple assinou isto como parte do sistema operacional."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписано Apple как часть операционной системы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple har signerat detta som en del av operativsystemet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இயக்க முறைமையின் ஒரு பகுதியாக Apple இதில் கையொப்பமிட்டுள்ளது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ลงชื่อรายการนี้ไว้ในฐานะส่วนหนึ่งของระบบปฏิบัติการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple bunu işletim sisteminin bir parçası olarak imzaladı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",

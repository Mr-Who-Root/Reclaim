        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per misurare %@ serve l'Accesso completo al disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はフルディスクアクセスがある場合のみ測定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 전체 디스크 접근 권한이 있어야 측정할 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ പൂർണ്ണ ഡിസ്ക് ആക്സസ് ഉപയോഗിച്ച് മാത്രമേ അളക്കാനാകൂ."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan alleen worden gemeten met volledige schijftoegang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: pomiar jest możliwy tylko z pełnym dostępem do dysku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ só pode ser medido com o Acesso Total ao Disco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: измерение возможно только с полным доступом к диску."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan bara mätas med full skivåtkomst."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ஐ முழு வட்டு அணுகல் மூலம் மட்டுமே அளவிட முடியும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",

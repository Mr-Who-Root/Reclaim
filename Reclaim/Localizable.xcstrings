    "Temporary browser data left by Playwright automation, often driven by AI agents.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporäre Browserdaten aus der Playwright-Automatisierung, oft von KI-Agenten gesteuert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos temporales del navegador que deja la automatización con Playwright, a menudo controlada por agentes de IA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données de navigateur temporaires laissées par l'automatisation Playwright, souvent pilotée par des agents IA."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Playwright ऑटोमेशन द्वारा छोड़ा गया अस्थायी ब्राउज़र डेटा, जिसे अक्सर AI एजेंट चलाते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Playwright による自動化（多くは AI エージェントによる）が残した一時ブラウザデータです。"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Playwright ഓട്ടോമേഷൻ ബാക്കിവെച്ച താൽക്കാലിക ബ്രൗസർ ഡാറ്റ, പലപ്പോഴും AI ഏജന്റുകൾ പ്രവർത്തിപ്പിക്കുന്നത്."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Playwright ஆட்டோமேஷன் விட்டுச்சென்ற தற்காலிக உலாவித் தரவு; பெரும்பாலும் AI ஏஜென்ட்களால் இயக்கப்படுவது."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Playwright 自动化留下的临时浏览器数据，通常由 AI 智能体驱动。"
          }
        }
      }
    },

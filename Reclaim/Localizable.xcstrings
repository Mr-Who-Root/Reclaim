    },
    "Caches the Android build tools and emulator rebuild on demand.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ذاكرة تخزين مؤقت تعيد أدوات بناء Android والمحاكي إنشاءها عند الحاجة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches, die die Android-Build-Tools und der Emulator bei Bedarf neu erstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cachés que las herramientas de compilación y el emulador de Android vuelven a crear cuando las necesitan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches que les outils de compilation et l'émulateur Android recréent à la demande."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैश, जिन्हें Android बिल्ड टूल और एम्युलेटर ज़रूरत पड़ने पर फिर से बना लेते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache yang dibuat ulang alat build Android dan emulator sesuai kebutuhan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache che gli strumenti di build Android e l'emulatore ricreano quando servono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android のビルドツールとエミュレータが必要に応じて再作成するキャッシュです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 빌드 도구와 에뮬레이터가 필요할 때 다시 생성하는 캐시입니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Android ബിൽഡ് ടൂളുകളും എമുലേറ്ററും ആവശ്യാനുസരണം വീണ്ടും സൃഷ്ടിക്കുന്ന കാഷെകൾ."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches die de Android-buildtools en de emulator zo nodig opnieuw aanmaken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamięć podręczna, którą narzędzia kompilacji Androida i emulator odtwarzają na żądanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches que as ferramentas de compilação do Android e o emulador recriam quando necessário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэши, которые инструменты сборки Android и эмулятор создают заново при необходимости."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Cacheminnen som Androids byggverktyg och emulatorn skapar på nytt vid behov."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Android பில்ட் கருவிகளும் எமுலேட்டரும் தேவைக்கேற்ப மீண்டும் உருவாக்கும் கேச்கள்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แคชที่เครื่องมือบิลด์ของ Android และโปรแกรมจำลองสร้างใหม่เมื่อต้องการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android derleme araçlarının ve emülatörün gerektiğinde yeniden oluşturduğu önbellekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кеші, які інструменти збірки Android та емулятор створюють знову за потреби."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ nhớ đệm mà công cụ build Android và trình giả lập tạo lại khi cần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 构建工具和模拟器按需重新创建的缓存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 建置工具和模擬器會視需要重新建立的快取。"
          }
        }
      }
    },

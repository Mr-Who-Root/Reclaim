    "%@ is running. Quit it first so it can be removed cleanly.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ قيد التشغيل. قم بإنهائه أولًا لتتم إزالته بشكل سليم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird ausgeführt. Beende die App zuerst, damit sie sauber entfernt werden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se está ejecutando. Sal de la app primero para eliminarla por completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est en cours d'exécution. Quittez d'abord l'app pour qu'elle soit supprimée proprement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ चल रहा है। पहले इसे बंद करें ताकि इसे ठीक से हटाया जा सके।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sedang berjalan. Keluar dari app terlebih dahulu agar dapat dihapus dengan bersih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è in esecuzione. Esci prima dall'app per rimuoverla in modo pulito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は実行中です。きれいに削除できるよう、先に終了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 실행 중입니다. 깔끔하게 제거하려면 먼저 종료하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ പ്രവർത്തിക്കുന്നു. വൃത്തിയായി നീക്കം ചെയ്യാൻ ആദ്യം അത് അടയ്ക്കുക."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is actief. Stop de app eerst zodat deze netjes kan worden verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja %@ jest uruchomiona. Najpierw ją zakończ, aby można ją było całkowicie usunąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está em execução. Encerre-o primeiro para que seja removido corretamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение «%@» запущено. Сначала завершите его, чтобы удалить полностью."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ körs. Avsluta appen först så att den kan tas bort helt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ இயங்குகிறது. அதைச் சுத்தமாக அகற்ற, முதலில் அதிலிருந்து வெளியேறவும்."
          }

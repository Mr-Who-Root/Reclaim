    "Scan your Home folder or any folder you grant": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افحص مجلد البيت أو أي مجلد تمنح الوصول إليه"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne deinen Benutzerordner oder jeden freigegebenen Ordner"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza tu carpeta de inicio o cualquier carpeta a la que des acceso"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysez votre dossier de départ ou tout dossier autorisé"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने होम फ़ोल्डर या ऐक्सेस दिए गए किसी भी फ़ोल्डर को स्कैन करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindai folder Rumah Anda atau folder mana pun yang Anda izinkan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona la cartella Inizio o qualsiasi cartella autorizzata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホームフォルダまたは許可した任意のフォルダをスキャン"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 폴더 또는 권한을 부여한 폴더 스캔"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഹോം ഫോൾഡറോ ആക്സസ് നൽകിയ ഏത് ഫോൾഡറോ സ്കാൻ ചെയ്യുക"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan je thuismap of elke map waartoe je toegang geeft"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanuj katalog domowy lub dowolny katalog, do którego udzielisz dostępu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Analise sua pasta de início ou qualquer pasta à qual der acesso"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканируйте домашнюю папку или любую разрешенную папку"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanna din hemmapp eller valfri mapp som du ger åtkomst till"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் முகப்புக் கோப்புறையையோ நீங்கள் அனுமதிக்கும் எந்தக் கோப்புறையையோ ஸ்கேன் செய்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สแกนโฟลเดอร์บ้านหรือโฟลเดอร์ใดก็ได้ที่คุณให้สิทธิ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ev klasörünüzü veya izin verdiğiniz herhangi bir klasörü tarayın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скануйте домівку або будь-яку дозволену папку"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét thư mục nhà riêng hoặc bất kỳ thư mục nào bạn cấp quyền"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描你的个人文件夹或任何你授权的文件夹"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描您的個人專屬檔案夾或任何已授權的檔案夾"
          }
        }
      }
    },
    "Scanning only reads; nothing changes until you confirm": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفحص للقراءة فقط؛ لن يتغير أي شيء حتى تؤكد"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Scan liest nur; nichts ändert sich, bis du bestätigst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis solo lee; no cambia nada hasta que confirmas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'analyse se contente de lire ; rien ne change sans votre confirmation"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कैन केवल पढ़ता है; जब तक आप पुष्टि न करें, कुछ नहीं बदलता"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemindaian hanya membaca; tidak ada yang berubah hingga Anda mengonfirmasi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scansione legge soltanto; nulla cambia finché non confermi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンは読み取るだけで、確認するまで何も変更されません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔은 읽기만 하며, 확인하기 전에는 아무것도 변경되지 않습니다"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്കാൻ വായിക്കുക മാത്രമേ ചെയ്യൂ; നിങ്ങൾ സ്ഥിരീകരിക്കുന്നത് വരെ ഒന്നും മാറില്ല"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannen leest alleen; er verandert niets totdat je bevestigt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanowanie tylko odczytuje dane; nic się nie zmieni, dopóki nie potwierdzisz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise só lê; nada muda até você confirmar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирование только читает данные; ничего не изменится, пока Вы не подтвердите"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanningen läser bara; inget ändras förrän du bekräftar"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்கேன் படிக்க மட்டுமே செய்யும்; நீங்கள் உறுதிசெய்யும் வரை எதுவும் மாறாது"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสแกนเป็นการอ่านอย่างเดียว ไม่มีสิ่งใดเปลี่ยนแปลงจนกว่าคุณจะยืนยัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarama yalnızca okur; siz onaylayana kadar hiçbir şey değişmez"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканування лише читає дані; нічого не зміниться, доки ви не підтвердите"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét chỉ đọc; không có gì thay đổi cho đến khi bạn xác nhận"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描只读取内容；在你确认之前不会进行任何更改"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描只會讀取；在您確認之前不會變更任何內容"
          }
        }
      }
    },

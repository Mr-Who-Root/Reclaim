        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espacio libre de un vistazo y un análisis con todas las herramientas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'espace libre en un coup d'œil, et une analyse pour tous les outils"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक नज़र में ख़ाली स्थान, और हर टूल में एक साथ स्कैन"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruang kosong sekilas, dan satu pemindaian di semua alat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio libero a colpo d'occhio e un'unica scansione con tutti gli strumenti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空き容量をひと目で確認し、すべてのツールを一度にスキャン"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 가능한 공간을 한눈에, 모든 도구를 한 번에 스캔"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒഴിവുള്ള സ്ഥലം ഒറ്റനോട്ടത്തിൽ, എല്ലാ ടൂളുകളിലുമായി ഒരൊറ്റ സ്കാൻ"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrije ruimte in één oogopslag, en één scan voor alle tools"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wolne miejsce w skrócie i jedno skanowanie wszystkimi narzędziami"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espaço livre num relance e uma única análise em todas as ferramentas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свободное место с первого взгляда и одно сканирование всеми инструментами"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ledigt utrymme i en överblick och en skanning med alla verktyg"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காலி இடம் ஒரே பார்வையில், அனைத்துக் கருவிகளுக்கும் ஒரே ஸ்கேன்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูพื้นที่ว่างได้ทันที และสแกนครั้งเดียวครอบคลุมทุกเครื่องมือ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bakışta boş alan ve tüm araçlarda tek tarama"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вільне місце з першого погляду й одне сканування всіма інструментами"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem nhanh dung lượng trống và quét một lần qua mọi công cụ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一目了然的可用空间，一次扫描涵盖所有工具"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼掌握可用空間，一次掃描所有工具"
          }
        }
      }
    },

    "Matches by size, then a quick fingerprint, then a full SHA-256 check": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطابق حسب الحجم، ثم ببصمة سريعة، ثم بفحص SHA-256 كامل"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgleich nach Größe, dann per schnellem Fingerabdruck, dann per vollständiger SHA-256-Prüfung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara por tamaño, luego con una huella rápida y después con una comprobación SHA-256 completa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare la taille, puis une empreinte rapide, puis une vérification SHA-256 complète"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले आकार से, फिर एक त्वरित फ़िंगरप्रिंट से, और फिर पूरी SHA-256 जाँच से मिलान करता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencocokkan berdasarkan ukuran, lalu sidik jari cepat, lalu pemeriksaan SHA-256 penuh"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confronta per dimensione, poi con un'impronta rapida, infine con un controllo SHA-256 completo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイズ、簡易フィンガープリント、完全な SHA-256 チェックの順に照合します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크기, 빠른 지문, 전체 SHA-256 검사 순으로 비교합니다"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആദ്യം വലുപ്പം, പിന്നെ ഒരു ദ്രുത ഫിംഗർപ്രിന്റ്, തുടർന്ന് പൂർണ്ണ SHA-256 പരിശോധന എന്നിവ വഴി പൊരുത്തപ്പെടുത്തുന്നു"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergelijkt op grootte, daarna met een snelle vingerafdruk en dan met een volledige SHA-256-controle"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopasowuje po rozmiarze, potem po szybkim odcisku, a na koniec po pełnej sumie SHA-256"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara por tamanho, depois por uma impressão digital rápida e, por fim, por uma verificação SHA-256 completa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сравнение по размеру, затем по быстрому отпечатку, затем полная проверка SHA-256"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Matchar efter storlek, sedan ett snabbt fingeravtryck och sist en fullständig SHA-256-kontroll"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முதலில் அளவு, பின் விரைவான கைரேகை, பின் முழு SHA-256 சோதனை மூலம் பொருத்துகிறது"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จับคู่ตามขนาด ตามด้วยลายนิ้วมือแบบรวดเร็ว แล้วจึงตรวจสอบ SHA-256 แบบเต็ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce boyuta, sonra hızlı bir parmak izine, ardından tam bir SHA-256 denetimine göre eşleştirir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порівняння за розміром, потім за швидким відбитком, потім повна перевірка SHA-256"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "So khớp theo kích thước, rồi dấu vân tay nhanh, rồi kiểm tra SHA-256 đầy đủ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "依次按大小、快速指纹和完整的 SHA-256 校验进行匹配"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先比對大小，再比對快速指紋，最後進行完整的 SHA-256 檢查"
          }
        }
      }
    },

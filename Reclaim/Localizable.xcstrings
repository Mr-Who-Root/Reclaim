    "Not antivirus — Security Check reads signatures only": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس برنامجًا لمكافحة الفيروسات — يقرأ فحص الأمان التواقيع فقط"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Virenschutz – die Sicherheitsprüfung liest nur Signaturen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es un antivirus: Revisión de seguridad solo lee firmas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas un antivirus : le Contrôle de sécurité lit uniquement les signatures"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एंटीवायरस नहीं — सुरक्षा जाँच केवल हस्ताक्षर पढ़ती है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bukan antivirus — Pemeriksaan Keamanan hanya membaca tanda tangan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è un antivirus: Controllo sicurezza legge solo le firme"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウイルス対策ではありません。セキュリティチェックは署名を読み取るだけです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백신 아님 — 보안 검사는 서명만 읽습니다"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആന്റിവൈറസ് അല്ല — സുരക്ഷാ പരിശോധന സിഗ്നേച്ചറുകൾ മാത്രം വായിക്കുന്നു"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen antivirus — Beveiligingscontrole leest alleen handtekeningen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nie antywirus — Kontrola bezpieczeństwa odczytuje tylko podpisy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é antivírus — a Verificação de Segurança apenas lê assinaturas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не антивирус — Проверка безопасности только читает подписи"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget antivirusprogram – Säkerhetskontroll läser bara signaturer"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வைரஸ் தடுப்பு அல்ல — பாதுகாப்புச் சோதனை கையொப்பங்களை மட்டுமே படிக்கும்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ใช่แอนติไวรัส — ตรวจสอบความปลอดภัยอ่านเฉพาะลายเซ็น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Antivirüs değildir — Güvenlik Kontrolü yalnızca imzaları okur"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не антивірус — Перевірка безпеки лише читає підписи"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không phải phần mềm diệt virus — Kiểm tra bảo mật chỉ đọc chữ ký"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不是杀毒软件——安全检查只读取签名"
          }

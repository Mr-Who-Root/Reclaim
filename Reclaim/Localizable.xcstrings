          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamięć podręczna deweloperska odbudowuje się przy następnej kompilacji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os caches de desenvolvedor se recriam na próxima compilação"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэши разработчика создаются заново при следующей сборке"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utvecklarcacheminnen byggs upp igen vid nästa bygge"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "டெவலப்பர் கேச்கள் உங்கள் அடுத்த பில்டில் மீண்டும் உருவாகும்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แคชของนักพัฒนาจะสร้างใหม่ในการบิลด์ครั้งถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geliştirici önbellekleri bir sonraki derlemenizde yeniden oluşturulur"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кеші розробника відтворюються під час наступної збірки"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ nhớ đệm nhà phát triển được tạo lại ở lần build tiếp theo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发者缓存会在下次构建时重建"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開發者快取會在下次建置時重建"
          }
        }
      }
    },

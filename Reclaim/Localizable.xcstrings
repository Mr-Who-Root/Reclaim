    "Byte-for-byte identical files. One copy of each always stays.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملفات متطابقة بايتًا ببايت. تبقى نسخة واحدة من كل منها دائمًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Byte für Byte identische Dateien. Eine Kopie jeder Datei bleibt immer erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos idénticos byte a byte. Siempre se conserva una copia de cada uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers identiques octet par octet. Une copie de chacun est toujours conservée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाइट-दर-बाइट एक जैसी फ़ाइलें। हर एक की एक कॉपी हमेशा रहती है।"
          }
        },
        "id": {
          "stringUnit": {

    "Adds every undecided suggestion in this filter to the plan. Nothing is carried out yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيف كل اقتراح لم يُحسم في عامل التصفية هذا إلى الخطة. لن يُنفَّذ أي شيء بعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt alle offenen Vorschläge in diesem Filter zum Plan hinzu. Noch wird nichts ausgeführt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade al plan todas las sugerencias sin decidir de este filtro. Todavía no se ejecuta nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute au plan toutes les suggestions en attente de ce filtre. Rien n'est encore exécuté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़िल्टर के हर अनिर्णीत सुझाव को योजना में जोड़ता है। अभी कुछ भी लागू नहीं किया जाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menambahkan setiap saran yang belum diputuskan di filter ini ke rencana. Belum ada yang dijalankan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge al piano tutti i suggerimenti da decidere in questo filtro. Per ora non viene eseguito nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフィルタ内の未決定の提案をすべてプランに追加します。まだ何も実行されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 필터에서 아직 결정하지 않은 모든 제안을 계획에 추가합니다. 아직 아무것도 실행되지 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫിൽട്ടറിലെ തീരുമാനിക്കാത്ത എല്ലാ നിർദ്ദേശങ്ങളും പ്ലാനിലേക്ക് ചേർക്കുന്നു. ഇപ്പോൾ ഒന്നും നടപ്പിലാക്കുന്നില്ല."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voegt elke onbesliste suggestie in dit filter toe aan het plan. Er wordt nog niets uitgevoerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje do planu każdą sugestię bez decyzji z tego filtra. Na razie nic nie jest wykonywane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona ao plano todas as sugestões sem decisão deste filtro. Nada é executado ainda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет в план все предложения без решения из этого фильтра. Пока ничего не выполняется."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägger till alla obestämda förslag i det här filtret i planen. Inget utförs ännu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வடிப்பானில் முடிவு செய்யப்படாத ஒவ்வொரு பரிந்துரையையும் திட்டத்தில் சேர்க்கும். இன்னும் எதுவும் செயல்படுத்தப்படவில்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มคำแนะนำทั้งหมดที่ยังไม่ได้ตัดสินใจในตัวกรองนี้ไปยังแผน ยังไม่มีการดำเนินการใดๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu filtredeki karar verilmemiş tüm önerileri plana ekler. Henüz hiçbir şey uygulanmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додає до плану всі пропозиції без рішення з цього фільтра. Поки що нічого не виконується."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm mọi đề xuất chưa quyết định trong bộ lọc này vào kế hoạch. Chưa có gì được thực hiện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此筛选条件中所有未决定的建议添加到计划。暂不执行任何操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將此篩選條件中所有未決定的建議加入計畫。目前還不會執行任何動作。"
          }
        }
      }
    },

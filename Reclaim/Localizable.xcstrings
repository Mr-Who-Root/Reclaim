          }
        }
      }
    },
    "Tells you how much Reclaim's last Smart Scan found to review.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخبرك بحجم ما وجده آخر فحص ذكي في Reclaim للمراجعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibt an, wie viel der letzte Smart Scan von Reclaim zum Prüfen gefunden hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te dice cuánto encontró para revisar el último Análisis inteligente de Reclaim."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique ce que la dernière analyse intelligente de Reclaim a trouvé à examiner."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बताता है कि Reclaim के पिछले स्मार्ट स्कैन में समीक्षा के लिए कितना मिला।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memberi tahu berapa banyak yang ditemukan Pindai Cerdas terakhir Reclaim untuk ditinjau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica quanto ha trovato da esaminare l'ultima scansione intelligente di Reclaim."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim の前回のスマートスキャンで、確認が必要なものがどれだけ見つかったかを伝えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim의 마지막 스마트 스캔에서 검토할 항목을 얼마나 찾았는지 알려 줍니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim-ന്റെ അവസാന സ്മാർട്ട് സ്കാൻ അവലോകനത്തിനായി എത്രത്തോളം കണ്ടെത്തി എന്ന് പറയുന്നു."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertelt hoeveel de laatste Smart Scan van Reclaim heeft gevonden om te beoordelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Informuje, ile miejsca do przejrzenia znalazło ostatnie inteligentne skanowanie w Reclaim."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informa quanto a última Análise Inteligente do Reclaim encontrou para revisar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщает, сколько нашло для проверки последнее умное сканирование Reclaim."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar hur mycket Reclaims senaste Smart Scan hittade att granska."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim இன் கடைசி ஸ்மார்ட் ஸ்கேன் மதிப்பாய்வுக்கு எவ்வளவு கண்டறிந்தது என்பதைச் சொல்லும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บอกว่าสแกนอัจฉริยะครั้งล่าสุดของ Reclaim พบสิ่งที่ต้องตรวจทานมากเท่าใด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim'deki son Akıllı Taramanın incelenmek üzere ne kadar bulduğunu söyler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повідомляє, скільки знайшло для перегляду останнє розумне сканування Reclaim."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho bạn biết lần Quét thông minh gần nhất của Reclaim tìm thấy bao nhiêu thứ cần xem lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉你 Reclaim 上次智能扫描找到了多少可审阅的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "告訴您 Reclaim 上次智慧型掃描找到多少待檢閱的項目。"
          }
        }
      }
    },
    "Tells you how much space is free on your startup disk.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخبرك بحجم المساحة المتاحة على قرص بدء التشغيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibt an, wie viel Speicher auf deinem Startvolume frei ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te dice cuánto espacio libre hay en tu disco de arranque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique l'espace libre sur votre disque de démarrage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बताता है कि आपकी स्टार्टअप डिस्क पर कितना स्थान ख़ाली है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memberi tahu berapa banyak ruang kosong di disk startup Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica quanto spazio è libero sul disco di avvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動ディスクの空き容量を伝えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시동 디스크에 사용 가능한 공간이 얼마나 있는지 알려 줍니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ സ്റ്റാർട്ടപ്പ് ഡിസ്കിൽ എത്ര സ്ഥലം ഒഴിവുണ്ടെന്ന് പറയുന്നു."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertelt hoeveel ruimte er vrij is op je opstartschijf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Informuje, ile wolnego miejsca jest na dysku startowym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informa quanto espaço está livre no disco de inicialização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщает, сколько свободного места на загрузочном диске."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar hur mycket utrymme som är ledigt på startskivan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் தொடக்க வட்டில் எவ்வளவு இடம் காலியாக உள்ளது என்பதைச் சொல்லும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บอกว่าดิสก์เริ่มระบบมีพื้นที่ว่างเท่าใด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlangıç diskinizde ne kadar boş alan olduğunu söyler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повідомляє, скільки вільного місця на завантажувальному диску."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho bạn biết ổ đĩa khởi động còn trống bao nhiêu dung lượng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉你启动磁盘上有多少可用空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "告訴您啟動磁碟上有多少可用空間。"
          }
        }
      }
    },
    "Temp files, sessions and logs changed more recently than this are left alone": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتم المساس بالملفات المؤقتة والجلسات والسجلات التي تغيّرت خلال هذه المدة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporäre Dateien, Sitzungen und Protokolle, die innerhalb dieses Zeitraums geändert wurden, bleiben unberührt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se tocan los archivos temporales, sesiones y registros modificados más recientemente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers temporaires, sessions et journaux modifiés plus récemment sont ignorés"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे हाल में बदली गई अस्थायी फ़ाइलें, सत्र और लॉग छोड़ दिए जाते हैं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File sementara, sesi, dan log yang diubah lebih baru dari ini dibiarkan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File temporanei, sessioni e log modificati più di recente vengono ignorati"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これより最近に変更された一時ファイル、セッション、ログはそのままにします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기간보다 최근에 변경된 임시 파일, 세션 및 로그는 건드리지 않습니다"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതിലും അടുത്തിടെ മാറ്റം വന്ന താൽക്കാലിക ഫയലുകൾ, സെഷനുകൾ, ലോഗുകൾ എന്നിവ തൊടില്ല"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdelijke bestanden, sessies en logbestanden die recenter zijn gewijzigd, blijven ongemoeid"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki tymczasowe, sesje i dzienniki zmienione w tym okresie są pomijane"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos temporários, sessões e registros alterados mais recentemente que isso não são afetados"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Временные файлы, сеансы и журналы, изменявшиеся в течение этого срока, не затрагиваются"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillfälliga filer, sessioner och loggar som har ändrats senare än så lämnas orörda"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இதை விடச் சமீபத்தில் மாற்றப்பட்ட தற்காலிகக் கோப்புகள், அமர்வுகள், பதிவுகள் தொடப்படாது"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ชั่วคราว เซสชัน และบันทึกที่เปลี่ยนแปลงล่าสุดกว่านี้จะไม่ถูกแตะต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundan daha yakın zamanda değişen geçici dosyalara, oturumlara ve günlüklere dokunulmaz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тимчасові файли, сеанси й журнали, змінені протягом цього терміну, не зачіпаються"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp tạm, phiên và nhật ký thay đổi gần đây hơn mức này sẽ được giữ nguyên"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此时间内更改过的临时文件、会话和日志将不受影响"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此期間內有變更的暫存檔、工作階段和記錄檔將不予處理"
          }
        }
      }
    },
    "Temporary audio from Whisper transcription.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صوت مؤقت من تفريغ Whisper للكلام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporäres Audio aus der Whisper-Transkription."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio temporal de transcripciones de Whisper."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio temporaire de la transcription Whisper."
          }

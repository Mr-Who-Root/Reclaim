    "Selects files that match a rule, or clears the current selection": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدد الملفات التي تطابق قاعدة، أو يمسح التحديد الحالي"
          }
        },
        "de": {

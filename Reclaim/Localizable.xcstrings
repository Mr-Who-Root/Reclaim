    "An accent used across the app, the widget and the Dock icon.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لون تمييز يُستخدم في التطبيق والأداة وأيقونة Dock."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Akzentfarbe für die App, das Widget und das Dock-Symbol."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un color de acentuación para la app, el widget y el icono del Dock."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une couleur d'accentuation utilisée dans l'app, le widget et l'icône du Dock."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप, विजेट और Dock आइकन में उपयोग होने वाला ऐक्सेंट रंग।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aksen yang digunakan di seluruh app, widget, dan ikon Dock."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un colore di accento usato in tutta l'app, nel widget e nell'icona del Dock."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App 全体、ウィジェット、Dock アイコンで使われるアクセントカラーです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱, 위젯 및 Dock 아이콘 전체에 사용되는 강조 색상입니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആപ്പിലും വിജറ്റിലും Dock ഐക്കണിലും ഉപയോഗിക്കുന്ന ആക്സന്റ് നിറം."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een accentkleur voor de hele app, de widget en het Dock-symbool."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolor akcentu używany w całej aplikacji, widżecie i ikonie w Docku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma cor de destaque usada no app, no widget e no ícone do Dock."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цвет акцента для приложения, виджета и значка в Dock."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En accentfärg som används i appen, widgeten och Dock-symbolen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆப், விட்ஜெட், Dock ஐகான் முழுவதும் பயன்படுத்தப்படும் அக்சென்ட் நிறம்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สีเน้นที่ใช้ทั่วทั้งแอป วิดเจ็ต และไอคอนบน Dock"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama, widget ve Dock simgesinde kullanılan vurgu rengi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Колір акценту для програми, віджета й іконки в Dock."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màu nhấn dùng trong toàn bộ ứng dụng, tiện ích và biểu tượng trên Dock."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在整个应用、小组件和程序坞图标中使用的强调色。"
          }
        },

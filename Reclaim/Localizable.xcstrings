    "Downloaded dependencies, build caches and wrapper distributions for Gradle (Android and Java). Rebuilt on your next build.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التبعيات التي تم تنزيلها وذاكرة البناء المؤقتة وتوزيعات wrapper الخاصة بـ Gradle (لـ Android وJava). يُعاد إنشاؤها في عملية البناء التالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geladene Abhängigkeiten, Build-Caches und Wrapper-Distributionen für Gradle (Android und Java). Werden beim nächsten Build neu erstellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dependencias descargadas, cachés de compilación y distribuciones del wrapper de Gradle (Android y Java). Se regeneran en tu próxima compilación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dépendances téléchargées, caches de compilation et distributions wrapper de Gradle (Android et Java). Reconstruits à la prochaine compilation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradle (Android और Java) के लिए डाउनलोड की गई डिपेंडेंसी, बिल्ड कैश और रैपर डिस्ट्रिब्यूशन। अगले बिल्ड पर ये फिर से बन जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dependensi yang diunduh, cache build, dan distribusi wrapper untuk Gradle (Android dan Java). Dibuat ulang pada build berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipendenze scaricate, cache di build e distribuzioni wrapper di Gradle (Android e Java). Vengono ricreate alla build successiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradle（Android と Java）のダウンロード済み依存関係、ビルドキャッシュ、ラッパーディストリビューションです。次回のビルド時に再作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradle(Android 및 Java)용으로 다운로드한 종속성, 빌드 캐시 및 wrapper 배포판입니다. 다음 빌드 때 다시 생성됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradle-നുള്ള (Android, Java) ഡൗൺലോഡ് ചെയ്ത ഡിപൻഡൻസികൾ, ബിൽഡ് കാഷെകൾ, wrapper ഡിസ്ട്രിബ്യൂഷനുകൾ. അടുത്ത ബിൽഡിൽ പുനർനിർമ്മിക്കപ്പെടും."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gedownloade afhankelijkheden, buildcaches en wrapperdistributies voor Gradle (Android en Java). Ze worden bij je volgende build opnieuw opgebouwd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobrane zależności, pamięć podręczna kompilacji i dystrybucje wrappera Gradle (Android i Java). Odbudowywane przy następnej kompilacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dependências baixadas, caches de compilação e distribuições do wrapper do Gradle (Android e Java). Recriados na próxima compilação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загруженные зависимости, кэши сборки и дистрибутивы wrapper для Gradle (Android и Java). Создаются заново при следующей сборке."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämtade beroenden, byggcacheminnen och wrapper-distributioner för Gradle (Android och Java). Byggs upp igen vid nästa bygge."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradle (Android மற்றும் Java) க்கான பதிவிறக்கிய சார்புகள், பில்ட் கேச்கள் மற்றும் wrapper விநியோகங்கள். உங்கள் அடுத்த பில்டில் மீண்டும் உருவாக்கப்படும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "dependency ที่ดาวน์โหลดไว้ แคชการบิลด์ และ wrapper distribution ของ Gradle (Android และ Java) จะสร้างใหม่ในการบิลด์ครั้งถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradle (Android ve Java) için indirilen bağımlılıklar, derleme önbellekleri ve wrapper dağıtımları. Bir sonraki derlemenizde yeniden oluşturulur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Викачані залежності, кеші збірки й дистрибутиви wrapper для Gradle (Android і Java). Відтворюються під час наступної збірки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phụ thuộc đã tải về, bộ nhớ đệm build và bản phân phối wrapper của Gradle (Android và Java). Được tạo lại ở lần build tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradle（Android 和 Java）下载的依赖项、构建缓存和 wrapper 分发包。下次构建时会重建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradle（Android 與 Java）下載的相依項目、建置快取與 wrapper 發行版本。下次建置時會重建。"
          }
        }
      }
    },

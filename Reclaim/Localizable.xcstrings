    "Show Reclaim in a specific language, or follow your Mac's setting. Changing the language reopens Reclaim.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض Reclaim بلغة محددة، أو اتبع إعداد جهاز Mac. يؤدي تغيير اللغة إلى إعادة فتح Reclaim."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeige Reclaim in einer bestimmten Sprache an oder folge der Einstellung deines Mac. Beim Ändern der Sprache wird Reclaim neu geöffnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra Reclaim en un idioma concreto o sigue el ajuste de tu Mac. Al cambiar el idioma, Reclaim se vuelve a abrir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez Reclaim dans une langue précise, ou suivez le réglage de votre Mac. Changer de langue rouvre Reclaim."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim को किसी ख़ास भाषा में दिखाएँ, या अपने Mac की सेटिंग का पालन करें। भाषा बदलने पर Reclaim फिर से खुलता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan Reclaim dalam bahasa tertentu, atau ikuti pengaturan Mac Anda. Mengubah bahasa akan membuka ulang Reclaim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra Reclaim in una lingua specifica o segui l'impostazione del Mac. Cambiando la lingua, Reclaim viene riaperto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim を特定の言語で表示するか、Mac の設定に従います。言語を変更すると Reclaim が開き直されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim을 특정 언어로 표시하거나 Mac 설정을 따릅니다. 언어를 변경하면 Reclaim이 다시 열립니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim ഒരു പ്രത്യേക ഭാഷയിൽ കാണിക്കുക, അല്ലെങ്കിൽ നിങ്ങളുടെ Mac-ന്റെ ക്രമീകരണം പിന്തുടരുക. ഭാഷ മാറ്റുമ്പോൾ Reclaim വീണ്ടും തുറക്കും."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon Reclaim in een specifieke taal of volg de instelling van je Mac. Als je de taal wijzigt, wordt Reclaim opnieuw geopend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetlaj Reclaim w wybranym języku lub zgodnie z ustawieniem Maca. Zmiana języka powoduje ponowne otwarcie Reclaim."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre o Reclaim em um idioma específico ou siga o ajuste do Mac. Alterar o idioma reabre o Reclaim."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать Reclaim на выбранном языке или следовать настройке Mac. При смене языка Reclaim перезапускается."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa Reclaim på ett visst språk eller följ inställningen på din Mac. När du byter språk öppnas Reclaim igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim ஐ ஒரு குறிப்பிட்ட மொழியில் காட்டவும், அல்லது உங்கள் Mac இன் அமைப்பைப் பின்பற்றவும். மொழியை மாற்றினால் Reclaim மீண்டும் திறக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดง Reclaim เป็นภาษาที่ระบุ หรือตามการตั้งค่าของ Mac การเปลี่ยนภาษาจะเปิด Reclaim ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim'i belirli bir dilde gösterin veya Mac'inizin ayarını izleyin. Dili değiştirmek Reclaim'i yeniden açar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати Reclaim вибраною мовою або відповідно до параметра Mac. Після зміни мови Reclaim перезапускається."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị Reclaim bằng một ngôn ngữ cụ thể, hoặc theo cài đặt của Mac. Thay đổi ngôn ngữ sẽ mở lại Reclaim."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以特定语言显示 Reclaim，或跟随 Mac 的设置。更改语言会重新打开 Reclaim。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以特定語言顯示 Reclaim，或依照 Mac 的設定。更改語言會重新打開 Reclaim。"
          }
        }
      }
    },

    "Old installers, archives and large files that have sat in Downloads for months.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدوات تثبيت وأرشيفات قديمة وملفات كبيرة بقيت في التنزيلات لأشهر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alte Installationsprogramme, Archive und große Dateien, die seit Monaten in Downloads liegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instaladores antiguos, archivos comprimidos y archivos grandes que llevan meses en Descargas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anciens installeurs, archives et gros fichiers qui traînent dans Téléchargements depuis des mois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुराने इंस्टॉलर, आर्काइव और बड़ी फ़ाइलें, जो महीनों से डाउनलोड में पड़ी हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer, arsip, dan file besar lama yang sudah berbulan-bulan berada di Unduhan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vecchi installer, archivi e file grandi rimasti in Download per mesi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードフォルダに何か月も放置されている古いインストーラ、アーカイブ、大きなファイル。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드 폴더에 몇 달째 남아 있는 오래된 설치 프로그램, 압축 파일 및 대용량 파일입니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മാസങ്ങളായി ഡൗൺലോഡുകളിൽ കിടക്കുന്ന പഴയ ഇൻസ്റ്റാളറുകൾ, ആർക്കൈവുകൾ, വലിയ ഫയലുകൾ."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oude installatieprogramma's, archieven en grote bestanden die al maanden in Downloads staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stare instalatory, archiwa i duże pliki, które od miesięcy leżą w katalogu Pobrane rzeczy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instaladores antigos, arquivos compactados e arquivos grandes parados em Downloads há meses."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старые установщики, архивы и большие файлы, месяцами лежащие в папке «Загрузки»."
          }
        },
        "sv": {
          "stringUnit": {

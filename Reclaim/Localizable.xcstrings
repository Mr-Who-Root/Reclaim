    "Developer caches rebuild on your next build": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُعاد إنشاء ذاكرة المطوّرين المؤقتة في عملية البناء التالية"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entwickler-Caches werden beim nächsten Build neu erstellt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cachés de desarrollo se regeneran en la siguiente compilación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les caches de développement se reconstruisent à la prochaine compilation"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डेवलपर कैश आपके अगले बिल्ड पर फिर से बन जाते हैं"
          }
        },
        "id": {

          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi piccoli raggruppati non possono essere gestiti singolarmente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "統合された小さな項目は個別に操作できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병합된 작은 항목은 개별적으로 처리할 수 없습니다"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലയിപ്പിച്ച ചെറിയ ഇനങ്ങളിൽ ഓരോന്നായി പ്രവർത്തനം നടത്താനാകില്ല"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samengevoegde kleine onderdelen kunnen niet afzonderlijk worden bewerkt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na scalonych małych rzeczach nie można wykonywać czynności osobno"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Itens pequenos agrupados não podem ser tratados individualmente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С объединенными мелкими объектами нельзя работать по отдельности"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammanslagna små objekt kan inte hanteras enskilt"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இணைக்கப்பட்ட சிறிய உருப்படிகளில் தனித்தனியாகச் செயல்பட முடியாது"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการขนาดเล็กที่ถูกรวมไว้ไม่สามารถดำเนินการแยกทีละรายการได้"

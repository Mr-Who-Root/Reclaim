    "Chunk cache that speeds up repeat downloads. Downloaded models are kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chunk-Cache, der wiederholte Downloads beschleunigt. Geladene Modelle bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caché de fragmentos que acelera las descargas repetidas. Los modelos descargados se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache de fragments qui accélère les téléchargements répétés. Les modèles téléchargés sont conservés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चंक कैश, जो दोबारा डाउनलोड को तेज़ करता है। डाउनलोड किए गए मॉडल रखे जाते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再ダウンロードを高速化するチャンクキャッシュです。ダウンロード済みのモデルは保持されます。"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആവർത്തിച്ചുള്ള ഡൗൺലോഡുകൾ വേഗത്തിലാക്കുന്ന ചങ്ക് കാഷെ. ഡൗൺലോഡ് ചെയ്ത മോഡലുകൾ സൂക്ഷിക്കും."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீண்டும் பதிவிறக்குவதை வேகப்படுத்தும் துண்டுக் கேச். பதிவிறக்கப்பட்ட மாடல்கள் வைக்கப்படும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于加快重复下载的分块缓存。已下载的模型会被保留。"
          }
        }
      }
    },

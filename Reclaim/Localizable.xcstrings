          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережені копії залишаються на місці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bản giữ lại vẫn ở nguyên chỗ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留项会留在原处。"
          }

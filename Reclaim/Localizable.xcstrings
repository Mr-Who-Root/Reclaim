    "In the Trash · recoverable until you empty it": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في سلة المهملات · قابل للاسترداد حتى تفرغها"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Papierkorb · wiederherstellbar, bis du ihn entleerst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la Papelera · se puede recuperar hasta que la vacíes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la Corbeille · récupérable jusqu'à ce que vous la vidiez"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रैश में · जब तक आप ट्रैश ख़ाली नहीं करते, इसे वापस पाया जा सकता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di Tong Sampah · dapat dipulihkan hingga Anda mengosongkannya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel Cestino · recuperabile finché non lo svuoti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱内 · ゴミ箱を空にするまで復元可能"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통에 있음 · 비우기 전까지 복구 가능"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ട്രാഷിൽ · നിങ്ങൾ ശൂന്യമാക്കുന്നത് വരെ വീണ്ടെടുക്കാനാകും"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de prullenmand · herstelbaar totdat je die leegt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W Koszu · do odzyskania, dopóki go nie opróżnisz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lixo · recuperável até você esvaziá-lo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Корзине · можно восстановить, пока Вы ее не очистите"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I papperskorgen · kan återställas tills du tömmer den"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குப்பைத் தொட்டியில் · நீங்கள் காலியாக்கும் வரை மீட்டெடுக்கலாம்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อยู่ในถังขยะ · กู้คืนได้จนกว่าคุณจะล้างถังขยะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöp Sepetinde · siz boşaltana kadar kurtarılabilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У Смітнику · можна відновити, доки ви його не спорожните"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong Thùng rác · có thể khôi phục cho đến khi bạn dọn sạch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",

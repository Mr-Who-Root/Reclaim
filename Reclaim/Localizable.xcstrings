          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चल रहे कंटेनर और उनके द्वारा इस्तेमाल की जा रही इमेज को कभी छुआ नहीं जाता"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Container yang sedang berjalan dan image yang dipakainya tidak pernah disentuh"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I container in esecuzione e le immagini che usano non vengono mai toccati"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中のコンテナと、それらが使用しているイメージには一切手を加えません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 중인 컨테이너와 해당 컨테이너가 사용하는 이미지는 건드리지 않습니다"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്രവർത്തിക്കുന്ന കണ്ടെയ്‌നറുകളെയും അവ ഉപയോഗിക്കുന്ന ഇമേജുകളെയും ഒരിക്കലും തൊടില്ല"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Actieve containers en de images die ze gebruiken, worden nooit aangeraakt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działające kontenery i używane przez nie obrazy nigdy nie są ruszane"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contêineres em execução e as imagens que eles usam nunca são tocados"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запущенные контейнеры и используемые ими образы никогда не затрагиваются"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Containrar som körs och avbilderna de använder rörs aldrig"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இயங்கும் கன்டெய்னர்களும் அவை பயன்படுத்தும் இமேஜ்களும் ஒருபோதும் தொடப்படாது"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คอนเทนเนอร์ที่กำลังทำงานและอิมเมจที่คอนเทนเนอร์ใช้อยู่จะไม่ถูกแตะต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışan konteynerlere ve kullandıkları imajlara asla dokunulmaz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запущені контейнери й образи, які вони використовують, ніколи не зачіпаються"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Container đang chạy và các image chúng dùng không bao giờ bị động đến"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绝不会触碰正在运行的容器及其使用的镜像"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "絕不會動到正在執行的容器及其使用的映像檔"
          }
        }
      }
    },
    "Runs on this Mac with Apple's on-device model. Nothing you ask leaves the device, and it can only suggest — you decide.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل على جهاز Mac هذا باستخدام نموذج Apple على الجهاز. لا يغادر أي شيء تسأل عنه الجهاز، ويمكنه الاقتراح فقط — والقرار لك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft auf diesem Mac mit dem On-Device-Modell von Apple. Nichts, was du fragst, verlässt das Gerät, und es kann nur vorschlagen – du entscheidest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ejecuta en este Mac con el modelo en el dispositivo de Apple. Nada de lo que preguntes sale del dispositivo, y solo puede sugerir: tú decides."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne sur ce Mac avec le modèle d'Apple intégré à l'appareil. Rien de ce que vous demandez ne quitte l'appareil, et il peut seulement suggérer : c'est vous qui décidez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple के ऑन-डिवाइस मॉडल के साथ इस Mac पर चलता है। आप जो कुछ पूछते हैं, वह डिवाइस से बाहर नहीं जाता, और यह केवल सुझाव दे सकता है — फ़ैसला आप करते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berjalan di Mac ini dengan model di perangkat dari Apple. Pertanyaan Anda tidak pernah keluar dari perangkat, dan asisten hanya dapat menyarankan — Anda yang memutuskan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funziona su questo Mac con il modello sul dispositivo di Apple. Le tue domande non lasciano il dispositivo e può solo dare suggerimenti: decidi tu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple のオンデバイスモデルを使ってこの Mac 上で動作します。質問内容がデバイスの外に出ることはありません。提案するだけで、決めるのはあなたです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple의 기기 내 모델을 사용하여 이 Mac에서 실행됩니다. 질문한 내용은 기기 밖으로 나가지 않으며, 제안만 할 수 있고 결정은 사용자가 합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-ന്റെ ഓൺ-ഡിവൈസ് മോഡൽ ഉപയോഗിച്ച് ഈ Mac-ൽ പ്രവർത്തിക്കുന്നു. നിങ്ങൾ ചോദിക്കുന്നതൊന്നും ഉപകരണം വിട്ടുപോകില്ല, ഇതിന് നിർദ്ദേശിക്കാൻ മാത്രമേ കഴിയൂ — തീരുമാനിക്കുന്നത് നിങ്ങളാണ്."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werkt op deze Mac met het model van Apple op het apparaat. Niets wat je vraagt verlaat het apparaat, en de assistent kan alleen voorstellen — jij beslist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa na tym Macu z modelem Apple na urządzeniu. Nic, o co zapytasz, nie opuszcza urządzenia, a asystent może tylko sugerować — decyzja należy do Ciebie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona neste Mac com o modelo da Apple no dispositivo. Nada do que você pergunta sai do dispositivo, e ele só pode sugerir — você decide."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работает на этом Mac с помощью модели Apple на устройстве. Ваши вопросы не покидают устройство, а ассистент может только предлагать — решаете Вы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Körs på den här Macen med Apples modell på enheten. Inget du frågar lämnar enheten, och den kan bara föreslå – du bestämmer."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple இன் சாதனத்திலேயே இயங்கும் மாடலுடன் இந்த Mac இல் இயங்குகிறது. நீங்கள் கேட்பது எதுவும் சாதனத்தை விட்டு வெளியேறாது, இதனால் பரிந்துரைக்க மட்டுமே முடியும் — முடிவு உங்களுடையது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำงานบน Mac เครื่องนี้ด้วยโมเดลบนอุปกรณ์ของ Apple สิ่งที่คุณถามจะไม่ออกจากอุปกรณ์ และทำได้เพียงแนะนำ — คุณเป็นผู้ตัดสินใจ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'te Apple'ın aygıt üzerindeki modeliyle çalışır. Sorduğunuz hiçbir şey aygıttan çıkmaz ve yalnızca öneride bulunabilir — kararı siz verirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Працює на цьому Mac за допомогою моделі Apple на пристрої. Ваші запитання не залишають пристрій, а асистент може лише пропонувати — вирішуєте ви."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy trên máy Mac này bằng mô hình trên thiết bị của Apple. Không câu hỏi nào của bạn rời khỏi thiết bị, và trợ lý chỉ có thể đề xuất — bạn quyết định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Apple 的设备端模型在此 Mac 上运行。你提出的任何问题都不会离开设备，而且它只能提供建议——由你决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Apple 的裝置端模型在此 Mac 上執行。您提出的問題都不會離開此裝置，且它只能提供建議，由您做決定。"
          }
        }
      }
    },

    },
    "%@ Last used about %@ ago.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Etwa %@ lang nicht verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ Last used about %2$@ ago."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Último uso hace unos %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Dernière utilisation il y a environ %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ लगभग %@ पहले अंतिम बार उपयोग हुआ।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 最終使用は約%@前です。"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ അവസാനം ഉപയോഗിച്ചത് ഏകദേശം %@ മുമ്പ്."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ சுமார் %@ முன்பு கடைசியாகப் பயன்படுத்தப்பட்டது."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@上次使用约在 %@前。"
          }
        }
      }
    },
    "%@ Only files untouched for %@ or more.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Nur Dateien, die mindestens %@ lang unberührt sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ Only files untouched for %2$@ or more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Solo archivos sin tocar desde hace %@ o más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Uniquement les fichiers non modifiés depuis au moins %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ केवल वे फ़ाइलें जिन्हें %@ या उससे अधिक समय से छुआ नहीं गया।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@以上変更されていないファイルのみが対象です。"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ അല്ലെങ്കിൽ അതിലധികം കാലമായി തൊടാത്ത ഫയലുകൾ മാത്രം."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ அல்லது அதற்கு மேல் தொடப்படாத கோப்புகள் மட்டும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@仅包括至少 %@未改动的文件。"
          }
        }
      }
    },

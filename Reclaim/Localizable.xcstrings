        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആന്റിവൈറസ് അല്ല — സുരക്ഷാ പരിശോധന സിഗ്നേച്ചറുകൾ മാത്രം വായിക്കുന്നു"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வைரஸ் தடுப்பு அல்ல — பாதுகாப்புச் சோதனை கையொப்பங்களை மட்டுமே படிக்கும்"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不是杀毒软件——安全检查只读取签名"
          }
        }
      }
    },

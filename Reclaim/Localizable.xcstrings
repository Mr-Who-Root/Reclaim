          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இமேஜ்கள், கன்டெய்னர்கள், வால்யூம்கள் & பில்ட் கேச்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อิมเมจ คอนเทนเนอร์ วอลุ่ม และแคชบิลด์"
          }
        },
        "tr": {
          "stringUnit": {

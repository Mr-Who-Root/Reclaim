    "Start Docker, wait until its engine is running, then scan again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل Docker، وانتظر حتى يعمل محرّكه، ثم افحص مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte Docker, warte, bis die Engine läuft, und scanne dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia Docker, espera a que su motor esté en marcha y vuelve a analizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez Docker, attendez que son moteur soit démarré, puis relancez l'analyse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker शुरू करें, उसका इंजन चलने तक प्रतीक्षा करें, फिर से स्कैन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalankan Docker, tunggu hingga engine-nya berjalan, lalu pindai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia Docker, attendi che il motore sia in esecuzione, quindi esegui di nuovo la scansione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker を起動し、エンジンが動き出すまで待ってから、もう一度スキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker를 시작하고 엔진이 실행될 때까지 기다린 다음 다시 스캔하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker ആരംഭിക്കുക, അതിന്റെ എഞ്ചിൻ പ്രവർത്തിച്ചു തുടങ്ങുന്നത് വരെ കാത്തിരിക്കുക, തുടർന്ന് വീണ്ടും സ്കാൻ ചെയ്യുക."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Docker, wacht tot de engine draait en scan daarna opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchom Docker, poczekaj, aż jego silnik zacznie działać, i przeskanuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie o Docker, espere o mecanismo dele entrar em execução e analise novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустите Docker, дождитесь, пока заработает его движок, и выполните сканирование снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Starta Docker, vänta tills motorn körs och skanna sedan igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker ஐத் தொடங்கி, அதன் இன்ஜின் இயங்கும் வரை காத்திருந்து, பிறகு மீண்டும் ஸ்கேன் செய்யவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Docker รอจนกว่าเอนจินของ Docker จะทำงาน แล้วสแกนอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker'ı başlatın, motorunun çalışmasını bekleyin, ardından yeniden tarayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустіть Docker, дочекайтеся, поки запрацює його рушій, і проскануйте знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy khởi động Docker, đợi đến khi engine chạy rồi quét lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请启动 Docker，等待其引擎开始运行，然后重新扫描。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請啟動 Docker，等到其引擎開始執行後，再重新掃描。"
          }
        }
      }
    },
    "Start by themselves": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدأ تلقائيًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten von selbst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abren solos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrent tout seuls"
          }
        },
        "hi": {
          "stringUnit": {

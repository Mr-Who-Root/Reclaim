    "Needs approval in System Settings › General › Login Items.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب الموافقة في إعدادات النظام › عام › عناصر تسجيل الدخول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Muss in Systemeinstellungen › Allgemein › Anmeldeobjekte genehmigt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere aprobación en Ajustes del Sistema › General › Ítems de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite une autorisation dans Réglages Système › Général › Ouverture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम सेटिंग्ज़ › सामान्य › लॉगिन आइटम में स्वीकृति चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memerlukan persetujuan di Pengaturan Sistem › Umum › Item Login."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede l'approvazione in Impostazioni di Sistema › Generali › Elementi login."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 › 一般 › ログイン項目で承認が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 › 일반 › 로그인 항목에서 승인해야 합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സിസ്റ്റം ക്രമീകരണം › പൊതുവായവ › ലോഗിൻ ഇനങ്ങൾ എന്നതിൽ അനുമതി ആവശ്യമാണ്."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vereist goedkeuring in Systeeminstellingen › Algemeen › Inlogonderdelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymaga zatwierdzenia w Ustawieniach systemowych › Ogólne › Rzeczy otwierane podczas logowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer aprovação em Ajustes do Sistema › Geral › Itens de Início."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется одобрение в разделе «Системные настройки» › «Основные» › «Объекты входа»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Måste godkännas i Systeminställningar › Allmänt › Inloggningsobjekt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "System Settings › General › Login Items இல் ஒப்புதல் தேவை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องอนุมัติในการตั้งค่าระบบ › ทั่วไป › รายการเข้าสู่ระบบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları › Genel › Giriş Öğeleri'nde onay gerekiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібне схвалення в «Системні параметри» › «Загальні» › «Автозапуск»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần phê duyệt trong Cài đặt hệ thống › Cài đặt chung › Mục đăng nhập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要在“系统设置” › “通用” › “登录项”中批准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要在「系統設定」›「一般」›「登入項目」中核准。"
          }
        }
      }
    },

    "%lld folders couldn't be read and are shown as unknown. Totals exclude them, so they may be higher than shown.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة %lld مجلدات، لذا تظهر كغير معروفة. لا تشملها الإجماليات، لذا قد تكون أعلى مما يظهر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Ordner konnten nicht gelesen werden und werden als unbekannt angezeigt. Die Summen enthalten sie nicht und können daher höher sein als angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido leer %lld carpetas y se muestran como desconocidas. Los totales no las incluyen, así que pueden ser mayores de lo indicado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dossiers n'ont pas pu être lus et sont affichés comme inconnus. Les totaux les excluent : ils peuvent donc être plus élevés qu'indiqué."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld फ़ोल्डर पढ़े नहीं जा सके और अज्ञात के रूप में दिखाए गए हैं। कुल योग में ये शामिल नहीं हैं, इसलिए वास्तविक योग दिखाए गए से अधिक हो सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld folder tidak dapat dibaca dan ditampilkan sebagai tidak diketahui. Total tidak menyertakannya, jadi total sebenarnya mungkin lebih tinggi dari yang ditampilkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere %lld cartelle, che sono indicate come sconosciute. I totali le escludono, quindi potrebbero essere più alti di quanto mostrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個のフォルダを読み取れなかったため、不明として表示しています。合計にはこれらが含まれないため、実際は表示より大きい可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개의 폴더를 읽을 수 없어 ‘알 수 없음’으로 표시됩니다. 합계에서 제외되었으므로 실제 크기는 더 클 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ഫോൾഡറുകൾ വായിക്കാനായില്ല, അവ അജ്ഞാതമായി കാണിക്കുന്നു. ആകെത്തുകയിൽ അവ ഉൾപ്പെടുന്നില്ല, അതിനാൽ യഥാർത്ഥ അളവ് കാണിച്ചതിലും കൂടുതലായിരിക്കാം."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld mappen konden niet worden gelezen en worden als onbekend getoond. De totalen tellen deze mappen niet mee en kunnen dus hoger zijn dan getoond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać katalogów (%lld), więc są pokazane jako nieznane. Sumy ich nie uwzględniają, dlatego rzeczywiste wartości mogą być wyższe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler %lld pastas, que aparecem como desconhecidas. Os totais não as incluem, então podem ser maiores do que o exibido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать папки (%lld) — они показаны как неизвестные. Итоги их не учитывают, поэтому реальные значения могут быть больше."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld mappar kunde inte läsas och visas som okända. De ingår inte i summorna, så summorna kan vara högre än vad som visas."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld கோப்புறைகளைப் படிக்க முடியவில்லை; அவை அறியப்படாதவை எனக் காட்டப்படுகின்றன. மொத்த அளவுகளில் அவை சேர்க்கப்படவில்லை, எனவே உண்மையான அளவு காட்டப்பட்டதை விட அதிகமாக இருக்கலாம்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่าน %lld โฟลเดอร์ไม่ได้ จึงแสดงเป็นไม่ทราบขนาด ยอดรวมไม่ได้นับโฟลเดอร์เหล่านี้ จึงอาจสูงกว่าที่แสดง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld klasör okunamadı ve bilinmiyor olarak gösteriliyor. Toplamlara dahil edilmedikleri için toplamlar gösterilenden yüksek olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати папки (%lld) — їх показано як невідомі. Підсумки їх не враховують, тому реальні значення можуть бути більшими."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc %lld thư mục nên chúng được hiển thị là không xác định. Tổng số không bao gồm các thư mục này, nên thực tế có thể cao hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 个文件夹无法读取，显示为未知。总计未包含这些文件夹，因此实际可能更高。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 個檔案夾無法讀取，因此顯示為「未知」。總計不包含這些檔案夾，實際數值可能更高。"
          }
        }
      }
    },

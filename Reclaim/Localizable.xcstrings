    "Left undecided, so Reclaim didn't touch it": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُتخذ قرار بشأنه، لذا لم يمسّه Reclaim"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offen gelassen, daher hat Reclaim es nicht angerührt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin decidir, así que Reclaim no lo ha tocado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissé en attente : Reclaim n'y a pas touché"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनिर्णीत छोड़ा गया, इसलिए Reclaim ने इसे नहीं छुआ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum diputuskan, jadi Reclaim tidak menyentuhnya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasciato in sospeso, quindi Reclaim non l'ha toccato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未決定のため、Reclaim は手を加えませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결정하지 않아 Reclaim이 건드리지 않았습니다"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തീരുമാനിക്കാതെ വിട്ടതിനാൽ Reclaim ഇത് തൊട്ടില്ല"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onbeslist gelaten, dus Reclaim heeft het niet aangeraakt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez decyzji, więc Reclaim tego nie ruszał"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem decisão, então o Reclaim não mexeu"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Решение не принято, поэтому Reclaim не трогал этот объект"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget beslut fattades, så Reclaim rörde inte objektet"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முடிவு செய்யாமல் விடப்பட்டதால் Reclaim இதைத் தொடவில்லை"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้ตัดสินใจ Reclaim จึงไม่ได้แตะต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karar verilmediği için Reclaim buna dokunmadı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рішення не ухвалено, тому Reclaim не зачіпав цей елемент"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa quyết định nên Reclaim không động đến"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未作决定，因此 Reclaim 未作处理"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未做決定，因此 Reclaim 未處理"
          }
        }
      }
    },

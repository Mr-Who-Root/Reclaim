    "Mapping the whole disk is slower, and folders macOS protects will show as unknown.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تخطيط القرص بالكامل أبطأ، وستظهر المجلدات التي يحميها macOS كغير معروفة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Erfassen der gesamten Festplatte dauert länger, und von macOS geschützte Ordner werden als unbekannt angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapear todo el disco es más lento, y las carpetas que macOS protege aparecerán como desconocidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartographie du disque entier est plus lente, et les dossiers protégés par macOS apparaîtront comme inconnus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरी डिस्क का मैप बनाने में ज़्यादा समय लगता है, और macOS द्वारा सुरक्षित फ़ोल्डर अज्ञात के रूप में दिखेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memetakan seluruh disk lebih lambat, dan folder yang dilindungi macOS akan ditampilkan sebagai tidak diketahui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La mappatura dell'intero disco è più lenta e le cartelle protette da macOS appariranno come sconosciute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスク全体のマップには時間がかかり、macOS が保護しているフォルダは不明として表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 디스크를 매핑하면 시간이 더 걸리며, macOS가 보호하는 폴더는 ‘알 수 없음’으로 표시됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മുഴുവൻ ഡിസ്കും മാപ്പ് ചെയ്യാൻ കൂടുതൽ സമയമെടുക്കും, macOS സംരക്ഷിക്കുന്ന ഫോൾഡറുകൾ അജ്ഞാതമായി കാണിക്കും."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De hele schijf in kaart brengen duurt langer, en mappen die macOS beschermt worden als onbekend getoond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapowanie całego dysku trwa dłużej, a katalogi chronione przez macOS będą pokazane jako nieznane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapear o disco inteiro é mais lento, e as pastas protegidas pelo macOS aparecerão como desconhecidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Построение карты всего диска занимает больше времени, а папки, защищенные macOS, будут показаны как неизвестные."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det går långsammare att kartlägga hela skivan, och mappar som macOS skyddar visas som okända."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முழு வட்டையும் வரைபடமாக்குவது மெதுவானது, macOS பாதுகாக்கும் கோப்புறைகள் அறியப்படாதவையாகக் காட்டப்படும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การทำแผนที่ทั้งดิสก์จะช้ากว่า และโฟลเดอร์ที่ macOS ปกป้องจะแสดงเป็นไม่ทราบขนาด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm diskin haritasını çıkarmak daha yavaştır ve macOS'in koruduğu klasörler bilinmiyor olarak görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Побудова карти всього диска триває довше, а папки, захищені macOS, буде показано як невідомі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lập bản đồ toàn bộ ổ đĩa sẽ chậm hơn, và các thư mục macOS bảo vệ sẽ hiển thị là không xác định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "映射整个磁盘会比较慢，且受 macOS 保护的文件夹将显示为未知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分析整個磁碟會比較慢，且受 macOS 保護的檔案夾會顯示為「未知」。"
          }
        }
      }
    },

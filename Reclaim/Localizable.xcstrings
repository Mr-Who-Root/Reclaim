            "value": "Сейчас все кэши и журналы небольшие. Просканировано %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Cacheminnen och loggar är små just nu. Skannades %@."
          }
        },

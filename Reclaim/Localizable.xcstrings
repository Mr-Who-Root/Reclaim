    "Checking your Mac. Nothing is being changed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ فحص جهاز Mac. لا يتم تغيير أي شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Mac wird geprüft. Es wird nichts geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobando tu Mac. No se está cambiando nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",

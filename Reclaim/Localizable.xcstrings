    "Model code and weights downloaded through torch.hub.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellcode und -gewichte, die über torch.hub geladen wurden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código y pesos de modelos descargados mediante torch.hub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Code et poids de modèles téléchargés via torch.hub."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "torch.hub के ज़रिए डाउनलोड किए गए मॉडल कोड और वेट।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "torch.hub でダウンロードしたモデルのコードと重みです。"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "torch.hub വഴി ഡൗൺലോഡ് ചെയ്ത മോഡൽ കോഡും വെയ്റ്റുകളും."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "torch.hub மூலம் பதிவிறக்கப்பட்ட மாடல் குறியீடும் எடைகளும் (weights)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 torch.hub 下载的模型代码和权重。"
          }
        }
      }
    },

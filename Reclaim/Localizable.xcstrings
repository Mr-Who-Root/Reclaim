    "No area is selected. Turn on at least one row to run an audit.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تحديد أي منطقة. شغّل صفًا واحدًا على الأقل لإجراء التدقيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Bereich ausgewählt. Aktiviere mindestens eine Zeile, um eine Analyse durchzuführen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún área seleccionada. Activa al menos una fila para hacer una auditoría."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune zone n'est sélectionnée. Activez au moins une ligne pour lancer un audit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई क्षेत्र नहीं चुना गया है। ऑडिट चलाने के लिए कम से कम एक पंक्ति चालू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada area yang dipilih. Nyalakan setidaknya satu baris untuk menjalankan audit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna area selezionata. Attiva almeno una riga per eseguire una verifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "領域が選択されていません。点検を実行するには、少なくとも 1 つの行をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 영역이 없습니다. 점검을 실행하려면 하나 이상의 행을 켜세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മേഖലയൊന്നും തിരഞ്ഞെടുത്തിട്ടില്ല. ഓഡിറ്റ് റൺ ചെയ്യാൻ ഒരു വരിയെങ്കിലും ഓണാക്കുക."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen gebied geselecteerd. Schakel minstens één rij in om een audit uit te voeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wybrano żadnego obszaru. Włącz co najmniej jeden wiersz, aby przeprowadzić audyt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma área selecionada. Ative pelo menos uma linha para fazer uma auditoria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не выбрано ни одной области. Включите хотя бы одну строку, чтобы запустить аудит."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget område är valt. Aktivera minst en rad för att köra en genomgång."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எந்தப் பகுதியும் தேர்ந்தெடுக்கப்படவில்லை. தணிக்கையை இயக்க குறைந்தது ஒரு வரிசையை இயக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้เลือกส่วนใด เปิดอย่างน้อยหนึ่งแถวเพื่อเรียกใช้การตรวจทาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir alan seçilmedi. Denetim yapmak için en az bir satırı açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вибрано жодної області. Увімкніть хоча б один рядок, щоб запустити аудит."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa chọn khu vực nào. Hãy bật ít nhất một hàng để chạy rà soát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未选择任何区域。请至少打开一行以运行审查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未選取任何範圍。請至少開啟一列以執行稽核。"
          }
        }
      }
    },
    "No build cache, unused images, stopped containers or orphaned volumes. Scanned %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد ذاكرة بناء مؤقتة أو صور غير مستخدمة أو حاويات متوقفة أو وحدات تخزين يتيمة. تم الفحص %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Build-Cache, keine ungenutzten Images, gestoppten Container oder verwaisten Volumes. Letzter Scan %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay caché de compilación, imágenes sin usar, contenedores detenidos ni volúmenes huérfanos. Analizado %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun cache de compilation, aucune image inutilisée, aucun conteneur arrêté ni volume orphelin. Dernière analyse %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई बिल्ड कैश, अप्रयुक्त इमेज, रुके हुए कंटेनर या अनाथ वॉल्यूम नहीं। %@ स्कैन किया गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada cache build, image yang tidak dipakai, container yang berhenti, atau volume telantar. Dipindai %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna cache di build, immagine inutilizzata, container arrestato o volume orfano. Ultima scansione: %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビルドキャッシュ、未使用のイメージ、停止中のコンテナ、孤立したボリュームはありません（スキャン: %@）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빌드 캐시, 사용하지 않는 이미지, 중지된 컨테이너 또는 고립된 볼륨이 없습니다. %@ 스캔함."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബിൽഡ് കാഷെയോ ഉപയോഗിക്കാത്ത ഇമേജുകളോ നിർത്തിയ കണ്ടെയ്‌നറുകളോ അനാഥ വോള്യങ്ങളോ ഇല്ല. %@ സ്കാൻ ചെയ്തു."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen buildcache, ongebruikte images, gestopte containers of verweesde volumes. Gescand %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak pamięci podręcznej kompilacji, nieużywanych obrazów, zatrzymanych kontenerów i osieroconych wolumenów. Przeskanowano %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum cache de compilação, imagem sem uso, contêiner parado ou volume órfão. Analisado %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет кэша сборки, неиспользуемых образов, остановленных контейнеров и бесхозных томов. Просканировано %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen byggcache, inga oanvända avbilder, stoppade containrar eller föräldralösa volymer. Skannades %@."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பில்ட் கேச், பயன்படுத்தப்படாத இமேஜ்கள், நிறுத்தப்பட்ட கன்டெய்னர்கள் அல்லது இணைக்கப்படாத வால்யூம்கள் எதுவும் இல்லை. %@ ஸ்கேன் செய்யப்பட்டது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีแคชบิลด์ อิมเมจที่ไม่ได้ใช้ คอนเทนเนอร์ที่หยุดแล้ว หรือวอลุ่มที่ไม่มีคอนเทนเนอร์ใช้ สแกนเมื่อ %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Derleme önbelleği, kullanılmayan imaj, durdurulmuş konteyner veya sahipsiz volume yok. %@ tarandı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає кешу збірки, невикористовуваних образів, зупинених контейнерів чи осиротілих томів. Проскановано %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có bộ nhớ đệm build, image không dùng, container đã dừng hay volume mồ côi. Đã quét %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有构建缓存、未使用的镜像、已停止的容器或孤立的卷。上次扫描：%@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有建置快取、未使用的映像檔、已停止的容器或孤立的磁碟區。掃描於 %@。"

    "Try a smaller minimum size, any age, or clear the search.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جرّب حدًا أدنى أصغر للحجم، أو أي عمر، أو امسح البحث."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probiere eine kleinere Mindestgröße oder ein beliebiges Alter, oder lösche die Suche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba con un tamaño mínimo menor o cualquier antigüedad, o borra la búsqueda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez une taille minimale plus petite, n'importe quel âge, ou effacez la recherche."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई छोटा न्यूनतम आकार या कोई भी आयु आज़माएँ, या खोज साफ़ करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coba ukuran minimum yang lebih kecil, usia berapa pun, atau hapus pencarian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova con una dimensione minima inferiore, qualsiasi età o cancella la ricerca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最小サイズを小さくするか、経過期間を問わない設定にするか、検索を消去してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최소 크기를 줄이거나, 기간을 제한하지 않거나, 검색을 지워 보세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചെറിയ കുറഞ്ഞ വലുപ്പമോ ഏത് പഴക്കമോ പരീക്ഷിക്കുക, അല്ലെങ്കിൽ തിരയൽ മായ്ക്കുക."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer een kleinere minimale grootte, elke leeftijd, of wis de zoekopdracht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj mniejszego rozmiaru minimalnego, dowolnego wieku lub wyczyść wyszukiwanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente um tamanho mínimo menor, qualquer idade ou limpe a busca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте уменьшить минимальный размер, выбрать любой возраст или очистить поиск."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova en mindre minsta storlek, valfri ålder eller rensa sökningen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சிறிய குறைந்தபட்ச அளவையோ எந்த வயதையோ முயலவும், அல்லது தேடலை அழிக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลองใช้ขนาดขั้นต่ำที่เล็กลง อายุใดก็ได้ หรือล้างการค้นหา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha küçük bir en küçük boyut ya da herhangi bir yaş deneyin veya aramayı temizleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробуйте зменшити мінімальний розмір, вибрати будь-який вік або очистити пошук."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thử kích thước tối thiểu nhỏ hơn, bất kỳ độ cũ nào, hoặc xóa tìm kiếm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请尝试更小的最小大小、任意时长，或清除搜索。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請嘗試較小的最小大小、不限存放時間，或清除搜尋。"
          }
        }
      }
    },

            "value": "Kopior av Mail-bilagor"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail இணைப்பு நகல்கள்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำเนาไฟล์แนบของ Mail"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail eki kopyaları"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копії вкладень Пошти"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao tệp đính kèm Mail"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邮件附件副本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "郵件附件副本"
          }
        }
      }
    },
    "Mail, Safari, Messages and other apps' data are unknown without it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى بيانات البريد وSafari والرسائل والتطبيقات الأخرى غير معروفة بدونه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne ihn bleiben die Daten von Mail, Safari, Nachrichten und anderen Apps unbekannt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin él, los datos de Mail, Safari, Mensajes y otras apps aparecen como desconocidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans lui, les données de Mail, Safari, Messages et d'autres apps restent inconnues."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके बिना Mail, Safari, Messages और अन्य ऐप्स का डेटा अज्ञात रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data Mail, Safari, Pesan, dan app lain tidak diketahui tanpa akses ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza questo accesso, i dati di Mail, Safari, Messaggi e altre app restano sconosciuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これがないと、メール、Safari、メッセージ、ほかの App のデータは不明になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 권한이 없으면 Mail, Safari, 메시지 및 다른 앱의 데이터 크기를 알 수 없습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതില്ലാതെ Mail, Safari, Messages, മറ്റ് ആപ്പുകൾ എന്നിവയുടെ ഡാറ്റ അജ്ഞാതമായിരിക്കും."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder deze toegang zijn de gegevens van Mail, Safari, Berichten en andere apps onbekend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez niego dane aplikacji Mail, Safari, Wiadomości i innych są nieznane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem ele, os dados do Mail, Safari, Mensagens e outros apps ficam desconhecidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без него данные Почты, Safari, Сообщений и других приложений неизвестны."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Data för Mail, Safari, Meddelanden och andra appar är okända utan den."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது இல்லாமல் Mail, Safari, Messages மற்றும் பிற ஆப்ஸின் தரவு அறியப்படாததாக இருக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากไม่มีสิทธิ์นี้ จะไม่ทราบขนาดข้อมูลของ Mail, Safari, ข้อความ และแอปอื่นๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu olmadan Mail, Safari, Mesajlar ve diğer uygulamaların verileri bilinmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без нього дані Пошти, Safari, Повідомлень та інших програм невідомі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu không có quyền này, dữ liệu của Mail, Safari, Tin nhắn và các ứng dụng khác sẽ không xác định được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有此权限，“邮件”、Safari、“信息”和其他应用的数据将显示为未知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若沒有此權限，將無法得知「郵件」、Safari、「訊息」和其他 App 的資料大小。"
          }
        }
      }
    },
    "Manage exclusions in Settings › Exclusions.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك إدارة الاستثناءات من الإعدادات › الاستثناءات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwalte Ausnahmen unter Einstellungen › Ausnahmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona las exclusiones en Ajustes › Exclusiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérez les exclusions dans Réglages › Exclusions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्ज़ › अपवाद में अपवाद प्रबंधित करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelola pengecualian di Pengaturan › Pengecualian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci le esclusioni in Impostazioni › Esclusioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "除外項目は「設定」›「除外項目」で管理できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제외 항목은 설정 › 제외 항목에서 관리할 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ക്രമീകരണം › ഒഴിവാക്കലുകൾ എന്നതിൽ ഒഴിവാക്കലുകൾ നിയന്ത്രിക്കുക."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheer uitsluitingen in Instellingen › Uitsluitingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarządzaj wykluczeniami w Ustawieniach › Wykluczenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie as exceções em Ajustes › Exceções."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управлять исключениями можно в разделе «Настройки» › «Исключения»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hantera undantag i Inställningar › Undantag."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அமைப்புகள் › விலக்குகள் என்பதில் விலக்குகளை நிர்வகிக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดการรายการยกเว้นได้ใน การตั้งค่า › รายการยกเว้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hariç tutulanları Ayarlar › Hariç Tutulanlar bölümünden yönetebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Керувати винятками можна в «Параметри» › «Винятки»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quản lý mục loại trừ trong Cài đặt › Loại trừ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可在“设置”›“排除项”中管理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可在「設定」›「排除項目」中管理。"
          }
        }
      }
    },

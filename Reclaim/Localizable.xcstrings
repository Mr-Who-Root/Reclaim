            "state": "translated",
            "value": "Zaznacza pliki pasujące do reguły lub czyści bieżące zaznaczenie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleciona arquivos que correspondem a uma regra ou limpa a seleção atual"
          }
        },
        "ru": {

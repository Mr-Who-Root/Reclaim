    "Notify me when a scan finds something to review": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعلمني عندما يعثر الفحص على شيء للمراجعة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigen, wenn ein Scan etwas zum Prüfen findet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisarme cuando un análisis encuentre algo que revisar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "M'avertir quand une analyse trouve quelque chose à examiner"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कैन में समीक्षा के लिए कुछ मिलने पर मुझे सूचित करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri tahu saya saat pemindaian menemukan sesuatu untuk ditinjau"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvisami quando una scansione trova qualcosa da esaminare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンで確認が必要な項目が見つかったら通知"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔에서 검토할 항목을 찾으면 알림"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അവലോകനം ചെയ്യേണ്ട എന്തെങ്കിലും സ്കാൻ കണ്ടെത്തുമ്പോൾ എന്നെ അറിയിക്കുക"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meld wanneer een scan iets vindt om te beoordelen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadamiaj, gdy skanowanie znajdzie coś do przejrzenia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificar quando uma análise encontrar algo para revisar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомлять, когда сканирование найдет что-то для проверки"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Meddela mig när en skanning hittar något att granska"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்கேனில் மதிப்பாய்வு செய்ய ஏதேனும் கண்டறியப்பட்டால் எனக்கு அறிவி"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แจ้งเตือนเมื่อการสแกนพบสิ่งที่ต้องตรวจทาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir tarama incelenecek bir şey bulduğunda bana bildir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщати, коли сканування знайде щось для перегляду"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo cho tôi khi lần quét tìm thấy thứ cần xem lại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描发现需要审阅的内容时通知我"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描找到需要檢閱的項目時通知我"
          }
        }
      }
    },

    "Stale agent scratch folders, old AI sessions and AI app caches nothing has open.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجلدات الوكلاء المؤقتة المهملة وجلسات الذكاء الاصطناعي القديمة وذاكرة التخزين المؤقت لتطبيقات الذكاء الاصطناعي التي لا يفتحها أي شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Veraltete Arbeitsordner von Agenten, alte KI-Sitzungen und KI-App-Caches, die nichts geöffnet hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carpetas temporales antiguas de agentes, sesiones de IA antiguas y cachés de apps de IA que nada tiene abiertas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dossiers de travail d'agents obsolètes, anciennes sessions d'IA et caches d'apps d'IA que rien n'utilise."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुराने एजेंट स्क्रैच फ़ोल्डर, पुराने AI सत्र और AI ऐप कैश, जिन्हें किसी ने खोला हुआ नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder kerja agen yang usang, sesi AI lama, dan cache app AI yang tidak sedang dibuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartelle di lavoro degli agenti inutilizzate, vecchie sessioni IA e cache delle app IA non aperte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "放置されたエージェントの作業フォルダ、古い AI セッション、どの App も開いていない AI App のキャッシュ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방치된 에이전트 임시 폴더, 이전 AI 세션, 아무것도 열고 있지 않은 AI 앱 캐시입니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പഴകിയ ഏജന്റ് സ്ക്രാച്ച് ഫോൾഡറുകൾ, പഴയ AI സെഷനുകൾ, ഒന്നും തുറന്നിട്ടില്ലാത്ത AI ആപ്പ് കാഷെകൾ."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verouderde kladmappen van agents, oude AI-sessies en caches van AI-apps die nergens geopend zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieaktualne katalogi robocze agentów, stare sesje AI i pamięć podręczna aplikacji AI, której nic nie ma otwartej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastas de rascunho de agentes esquecidas, sessões antigas de IA e caches de apps de IA que nada está usando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Давние черновые папки агентов, старые ИИ-сеансы и кэши ИИ-приложений, которые ничем не открыты."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inaktuella arbetsmappar från agenter, gamla AI-sessioner och AI-appars cacheminnen som inget har öppna."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எதுவும் திறந்து வைக்காத பழைய ஏஜென்ட் தற்காலிகக் கோப்புறைகள், பழைய AI அமர்வுகள் மற்றும் AI ஆப் கேச்கள்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โฟลเดอร์ชั่วคราวของเอเจนต์ที่ค้างนาน เซสชัน AI เก่า และแคชของแอป AI ที่ไม่มีสิ่งใดเปิดอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eskimiş ajan geçici klasörleri, eski YZ oturumları ve hiçbir şeyin açık tutmadığı YZ uygulaması önbellekleri."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Давні чорнові папки агентів, старі ШІ-сеанси й кеші ШІ-програм, які нічим не відкрито."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư mục nháp lâu ngày của tác tử, phiên AI cũ và bộ nhớ đệm ứng dụng AI không bị thứ gì mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无人打开的过期智能体临时文件夹、旧 AI 会话和 AI 应用缓存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過時的代理程式暫存檔案夾、舊的 AI 工作階段，以及沒有任何程式正在使用的 AI App 快取。"
          }
        }
      }
    },

    "No support files found in your Library for %@. Only the app itself will be removed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على ملفات دعم لـ %@ في مجلد المكتبة. ستتم إزالة التطبيق نفسه فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Support-Dateien für %@ in deiner Library gefunden. Nur die App selbst wird entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han encontrado archivos de soporte de %@ en tu Biblioteca. Solo se eliminará la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun fichier associé à %@ trouvé dans votre Bibliothèque. Seule l'app elle-même sera supprimée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी लाइब्रेरी में %@ के लिए कोई सहायता फ़ाइल नहीं मिली। केवल ऐप ही हटाया जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ditemukan file pendukung di Perpustakaan Anda untuk %@. Hanya app itu sendiri yang akan dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun file di supporto di %@ trovato nella Libreria. Verrà rimossa solo l'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリに %@ のサポートファイルは見つかりませんでした。App 本体のみが削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브러리에서 %@의 지원 파일을 찾을 수 없습니다. 앱만 제거됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ലൈബ്രറിയിൽ %@-ന്റെ സപ്പോർട്ട് ഫയലുകളൊന്നും കണ്ടെത്തിയില്ല. ആപ്പ് മാത്രം നീക്കം ചെയ്യും."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen ondersteuningsbestanden voor %@ gevonden in je bibliotheek. Alleen de app zelf wordt verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono plików pomocniczych aplikacji %@ w katalogu Biblioteki. Usunięta zostanie tylko sama aplikacja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum arquivo de suporte de %@ encontrado na Biblioteca. Apenas o próprio app será removido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В папке «Библиотека» не найдено вспомогательных файлов для %@. Будет удалено только само приложение."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga supportfiler för %@ hittades i ditt bibliotek. Bara själva appen tas bort."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ க்கான ஆதரவுக் கோப்புகள் எதுவும் உங்கள் Library இல் கண்டறியப்படவில்லை. ஆப் மட்டுமே அகற்றப்படும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบไฟล์สนับสนุนของ %@ ในคลังของคุณ จะเอาออกเฉพาะตัวแอปเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitaplığınızda %@ için destek dosyası bulunamadı. Yalnızca uygulamanın kendisi kaldırılacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У папці «Бібліотека» не знайдено допоміжних файлів для %@. Буде видалено лише саму програму."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy tệp hỗ trợ nào của %@ trong Thư viện. Chỉ ứng dụng sẽ bị gỡ bỏ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的资源库中未找到“%@”的支持文件。将只移除应用本身。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在您的資源庫中找不到 %@ 的支援檔案。只會移除 App 本身。"
          }
        }
      }
    },

    "Keeps the menu bar item available after you sign in, so scheduled scans can run.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُبقي عنصر شريط القائمة متاحًا بعد تسجيل الدخول، لتتمكن عمليات الفحص المجدولة من العمل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält das Menüleistensymbol nach der Anmeldung verfügbar, damit geplante Scans laufen können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene disponible el elemento de la barra de menús al iniciar sesión, para que se puedan ejecutar los análisis programados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde l'élément de la barre des menus disponible après la connexion, pour que les analyses planifiées puissent s'exécuter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन करने के बाद मेनू बार आइटम उपलब्ध रखता है, ताकि शेड्यूल किए गए स्कैन चल सकें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjaga item bar menu tetap tersedia setelah Anda masuk, agar pemindaian terjadwal dapat berjalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene disponibile l'elemento della barra dei menu dopo il login, così le scansioni programmate possono essere eseguite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン後もメニューバー項目を利用できるようにして、スケジュールしたスキャンを実行できるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 후에도 메뉴 막대 항목을 사용할 수 있게 하여 예약된 스캔이 실행되도록 합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഷെഡ്യൂൾ ചെയ്ത സ്കാനുകൾ റൺ ചെയ്യാൻ, സൈൻ ഇൻ ചെയ്തതിന് ശേഷം മെനു ബാർ ഇനം ലഭ്യമാക്കി നിർത്തുന്നു."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houdt het menubalkonderdeel beschikbaar nadat je bent ingelogd, zodat geplande scans kunnen worden uitgevoerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymuje ikonę na pasku menu po zalogowaniu, aby mogły działać zaplanowane skanowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém o item da barra de menus disponível depois que você inicia a sessão, para que as análises agendadas possam ser executadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значок в строке меню остается доступным после входа в систему, чтобы сканирование по расписанию могло выполняться."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håller menyradsobjektet tillgängligt efter att du har loggat in, så att schemalagda skanningar kan köras."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் உள்நுழைந்த பிறகும் மெனு பட்டி உருப்படியைக் கிடைக்கச் செய்யும், எனவே திட்டமிட்ட ஸ்கேன்கள் இயங்க முடியும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คงรายการในแถบเมนูไว้หลังจากคุณเข้าสู่ระบบ เพื่อให้การสแกนตามกำหนดการทำงานได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanlanmış taramaların çalışabilmesi için oturum açtıktan sonra menü çubuğu öğesini kullanılabilir tutar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Елемент у смузі меню залишається доступним після входу в систему, щоб сканування за розкладом могло виконуватися."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ biểu tượng trên thanh menu sau khi bạn đăng nhập để các lần quét theo lịch có thể chạy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录后保持菜单栏项目可用，以便运行定时扫描。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入後讓選單列項目保持可用，以便執行排程掃描。"
          }
        }
      }
    },
    "Keeps the menu bar item available after you sign in, so scheduled scans can run. Off unless you say yes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُبقي عنصر شريط القائمة متاحًا بعد تسجيل الدخول، لتتمكن عمليات الفحص المجدولة من العمل. يبقى متوقفًا ما لم توافق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält das Menüleistensymbol nach der Anmeldung verfügbar, damit geplante Scans laufen können. Aus, solange du nicht zustimmst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene disponible el elemento de la barra de menús al iniciar sesión, para que se puedan ejecutar los análisis programados. Desactivado salvo que digas que sí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde l'élément de la barre des menus disponible après la connexion, pour que les analyses planifiées puissent s'exécuter. Désactivé sauf si vous l'acceptez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन करने के बाद मेनू बार आइटम उपलब्ध रखता है, ताकि शेड्यूल किए गए स्कैन चल सकें। जब तक आप हाँ नहीं कहते, यह बंद रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjaga item bar menu tetap tersedia setelah Anda masuk, agar pemindaian terjadwal dapat berjalan. Nonaktif kecuali Anda menyetujuinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene disponibile l'elemento della barra dei menu dopo il login, così le scansioni programmate possono essere eseguite. Disattivato a meno che tu non lo consenta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン後もメニューバー項目を利用できるようにして、スケジュールしたスキャンを実行できるようにします。許可しない限りオフです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 후에도 메뉴 막대 항목을 사용할 수 있게 하여 예약된 스캔이 실행되도록 합니다. 직접 허용하지 않으면 꺼져 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഷെഡ്യൂൾ ചെയ്ത സ്കാനുകൾ റൺ ചെയ്യാൻ, സൈൻ ഇൻ ചെയ്തതിന് ശേഷം മെനു ബാർ ഇനം ലഭ്യമാക്കി നിർത്തുന്നു. നിങ്ങൾ അനുവദിക്കുന്നത് വരെ ഓഫ് ആയിരിക്കും."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houdt het menubalkonderdeel beschikbaar nadat je bent ingelogd, zodat geplande scans kunnen worden uitgevoerd. Staat uit tenzij je ja zegt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymuje ikonę na pasku menu po zalogowaniu, aby mogły działać zaplanowane skanowania. Wyłączone, dopóki się nie zgodzisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém o item da barra de menus disponível depois que você inicia a sessão, para que as análises agendadas possam ser executadas. Desativado a menos que você permita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значок в строке меню остается доступным после входа в систему, чтобы сканирование по расписанию могло выполняться. Выключено, пока Вы не разрешите."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håller menyradsobjektet tillgängligt efter att du har loggat in, så att schemalagda skanningar kan köras. Av om du inte säger ja."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் உள்நுழைந்த பிறகும் மெனு பட்டி உருப்படியைக் கிடைக்கச் செய்யும், எனவே திட்டமிட்ட ஸ்கேன்கள் இயங்க முடியும். நீங்கள் ஒப்புக்கொள்ளாவிட்டால் முடக்கப்பட்டிருக்கும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คงรายการในแถบเมนูไว้หลังจากคุณเข้าสู่ระบบ เพื่อให้การสแกนตามกำหนดการทำงานได้ ปิดอยู่จนกว่าคุณจะตกลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanlanmış taramaların çalışabilmesi için oturum açtıktan sonra menü çubuğu öğesini kullanılabilir tutar. Siz evet demedikçe kapalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Елемент у смузі меню залишається доступним після входу в систему, щоб сканування за розкладом могло виконуватися. Вимкнено, доки ви не дозволите."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ biểu tượng trên thanh menu sau khi bạn đăng nhập để các lần quét theo lịch có thể chạy. Tắt trừ khi bạn đồng ý."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录后保持菜单栏项目可用，以便运行定时扫描。除非你同意，否则保持关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入後讓選單列項目保持可用，以便執行排程掃描。除非您同意，否則會保持關閉。"
          }
        }
      }
    },
    "Keeps this copy and makes the others removable": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ بهذه النسخة ويجعل النسخ الأخرى قابلة للإزالة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält diese Kopie und macht die anderen entfernbar"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva esta copia y permite eliminar las demás"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde cette copie et rend les autres supprimables"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस कॉपी को रखता है और बाक़ी को हटाने योग्य बनाता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan salinan ini dan membuat salinan lainnya dapat dihapus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva questa copia e rende rimovibili le altre"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコピーを残し、ほかのコピーを削除対象にします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사본을 유지하고 나머지를 제거할 수 있게 합니다"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ പകർപ്പ് സൂക്ഷിച്ച് മറ്റുള്ളവ നീക്കം ചെയ്യാവുന്നതാക്കുന്നു"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaart deze kopie en maakt de andere verwijderbaar"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowuje tę kopię i umożliwia usunięcie pozostałych"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém esta cópia e permite remover as outras"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставляет эту копию, а остальные можно удалить"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behåller den här kopian och gör det möjligt att ta bort de andra"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த நகலை வைத்து, மற்றவற்றை அகற்றக்கூடியதாக்கும்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บสำเนานี้ไว้และทำให้สำเนาอื่นเอาออกได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kopyayı saklar ve diğerlerini kaldırılabilir yapar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишає цю копію, а інші можна видалити"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ bản này và cho phép gỡ các bản còn lại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留此副本，并将其他副本设为可移除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留此副本，並讓其他副本可被移除"
          }
        }
      }
    },

    "Opening Guided Cleanup. Nothing changes until you confirm a final plan.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ فتح التنظيف الموجَّه. لن يتغير أي شيء حتى تؤكد خطة نهائية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geführte Bereinigung wird geöffnet. Es ändert sich nichts, bis du einen endgültigen Plan bestätigst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abriendo Limpieza guiada. No cambia nada hasta que confirmes un plan final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouverture du nettoyage guidé. Rien ne change tant que vous n'avez pas confirmé un plan final."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्देशित सफ़ाई खोली जा रही है। जब तक आप अंतिम योजना की पुष्टि नहीं करते, कुछ नहीं बदलता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka Pembersihan Terpandu. Tidak ada yang berubah hingga Anda mengonfirmasi rencana akhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apertura di Pulizia guidata. Nulla cambia finché non confermi un piano finale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ガイド付きクリーンアップを開いています。最終プランを確定するまで何も変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단계별 정리를 여는 중입니다. 최종 계획을 확인하기 전에는 아무것도 변경되지 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഗൈഡഡ് ക്ലീനപ്പ് തുറക്കുന്നു. നിങ്ങൾ അന്തിമ പ്ലാൻ സ്ഥിരീകരിക്കുന്നത് വരെ ഒന്നും മാറില്ല."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begeleide opschoning wordt geopend. Er verandert niets totdat je een definitief plan bevestigt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwieranie Czyszczenia z przewodnikiem. Nic się nie zmieni, dopóki nie potwierdzisz ostatecznego planu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrindo a Limpeza Guiada. Nada muda até você confirmar um plano final."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывается пошаговая очистка. Ничего не изменится, пока Вы не подтвердите итоговый план."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar Guidad rensning. Inget ändras förrän du bekräftar en slutlig plan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வழிகாட்டப்பட்ட சுத்தம் திறக்கப்படுகிறது. இறுதித் திட்டத்தை நீங்கள் உறுதிசெய்யும் வரை எதுவும் மாறாது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังเปิดการล้างข้อมูลแบบมีคำแนะนำ ไม่มีสิ่งใดเปลี่ยนแปลงจนกว่าคุณจะยืนยันแผนขั้นสุดท้าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rehberli Temizlik açılıyor. Son bir planı onaylayana kadar hiçbir şey değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкривається покрокове очищення. Нічого не зміниться, доки ви не підтвердите остаточний план."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang mở Dọn dẹp có hướng dẫn. Không có gì thay đổi cho đến khi bạn xác nhận kế hoạch cuối cùng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在打开引导式清理。在你确认最终计划之前，不会进行任何更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在打開引導式清理。在您確認最終計畫之前，不會更改任何內容。"
          }
        }
      }
    },

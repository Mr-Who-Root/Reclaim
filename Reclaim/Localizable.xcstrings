        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจทานและกู้คืนสิ่งที่ถูกย้าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşınanları inceleyin ve geri yükleyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перегляд і відновлення переміщеного"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem lại & khôi phục những gì đã di chuyển"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审阅并恢复已移动的内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢閱並回復已移動的項目"
          }
        }
      }
    },

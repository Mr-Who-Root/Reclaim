        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I risultati appaiono man mano che ogni strumento termina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ツールが完了するたびに結果が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 도구가 완료되는 대로 결과가 표시됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ ടൂളും പൂർത്തിയാകുമ്പോൾ ഫലങ്ങൾ ദൃശ്യമാകും."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultaten verschijnen zodra elke tool klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyniki pojawiają się w miarę, jak poszczególne narzędzia kończą pracę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os resultados aparecem à medida que cada ferramenta termina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результаты появляются по мере завершения работы каждого инструмента."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultaten visas allteftersom varje verktyg blir klart."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு கருவியும் முடிந்ததும் முடிவுகள் தோன்றும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผลลัพธ์จะแสดงเมื่อแต่ละเครื่องมือทำงานเสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonuçlar her araç bittikçe görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Результати з’являються в міру завершення роботи кожного інструмента."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết quả xuất hiện khi từng công cụ hoàn tất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个工具完成后都会显示结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個工具完成時就會顯示結果。"

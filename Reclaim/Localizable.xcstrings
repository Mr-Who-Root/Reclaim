          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്വകാര്യതാ ക്രമീകരണത്തിൽ അനുവദിക്കുക"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தனியுரிமை அமைப்புகளில் அனுமதி"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",

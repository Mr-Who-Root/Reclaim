    "Model code and weights downloaded through torch.hub.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شيفرة النموذج وأوزانه التي تم تنزيلها عبر torch.hub."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellcode und -gewichte, die über torch.hub geladen wurden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código y pesos de modelos descargados mediante torch.hub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Code et poids de modèles téléchargés via torch.hub."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "torch.hub के ज़रिए डाउनलोड किए गए मॉडल कोड और वेट।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode dan bobot model yang diunduh melalui torch.hub."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Codice e pesi dei modelli scaricati tramite torch.hub."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "torch.hub でダウンロードしたモデルのコードと重みです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "torch.hub를 통해 다운로드한 모델 코드 및 가중치입니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "torch.hub വഴി ഡൗൺലോഡ് ചെയ്ത മോഡൽ കോഡും വെയ്റ്റുകളും."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelcode en -gewichten gedownload via torch.hub."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod i wagi modeli pobrane przez torch.hub."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Código e pesos de modelos baixados pelo torch.hub."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код и веса моделей, загруженные через torch.hub."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellkod och vikter som har hämtats via torch.hub."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "torch.hub மூலம் பதிவிறக்கப்பட்ட மாடல் குறியீடும் எடைகளும் (weights)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โค้ดและน้ำหนักของโมเดลที่ดาวน์โหลดผ่าน torch.hub"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "torch.hub aracılığıyla indirilen model kodu ve ağırlıkları."
          }
        },
        "uk": {

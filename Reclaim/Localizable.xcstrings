    "%@ (%@) left alone because it changed in the last %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم استثناء %@ (%@) بسبب تغييرات خلال آخر %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@) unberührt gelassen, da die letzte Änderung weniger als %@ zurückliegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (%2$@) left alone because it changed in the last %3$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@) sin tocar por haber cambiado hace menos de %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@) non pris en compte : dernière modification il y a moins de %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@) को छोड़ दिया गया, क्योंकि पिछले %@ में इनमें बदलाव हुआ है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@) dibiarkan karena berubah dalam %@ terakhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@) lasciato invariato perché modificato meno di %@ fa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（%@）は過去 %@以内に変更されたため、そのままにしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(%@)은(는) 최근 %@ 이내에 변경되어 그대로 두었습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കഴിഞ്ഞ %3$@ കാലയളവിൽ മാറ്റം വന്നതിനാൽ %1$@ (%2$@) തൊടാതെ വിട്ടു."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@) is ongemoeid gelaten omdat het de afgelopen %@ is gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pominięto %@ (%@): ostatnia zmiana mniej niż %@ temu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@) não foram alterados porque mudaram nos últimos %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@) не тронуто: изменения были менее чем %@ назад."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@) lämnades kvar eftersom det har ändrats under de senaste %@."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடந்த %3$@ காலத்தில் மாறியதால் %1$@ (%2$@) தொடப்படவில்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่แตะต้อง %@ (%@) เพราะมีการเปลี่ยนแปลงในช่วง %@ ที่ผ่านมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@), son %@ içinde değiştiği için olduğu gibi bırakıldı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@) не зачеплено: зміни були менш ніж %@ тому."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@) được giữ nguyên vì đã thay đổi trong %@ qua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（%@）在过去 %@内有过改动，因此未作处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（%@）在最近 %@內有變更，因此未予處理。"
          }
        }
      }
    },
    "%@ Last used about %@ ago.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ آخر استخدام قبل %@ تقريبًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Etwa %@ lang nicht verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ Last used about %2$@ ago."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Último uso hace unos %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Dernière utilisation il y a environ %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ लगभग %@ पहले अंतिम बार उपयोग हुआ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Terakhir digunakan sekitar %@ yang lalu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ultimo utilizzo circa %@ fa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 最終使用は約%@前です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 약 %@ 전에 마지막으로 사용했습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ അവസാനം ഉപയോഗിച്ചത് ഏകദേശം %@ മുമ്പ്."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ongeveer %@ geleden voor het laatst gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ostatnio używane około %@ temu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Usado pela última vez há cerca de %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Последнее использование — примерно %@ назад."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Användes senast för ungefär %@ sedan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ சுமார் %@ முன்பு கடைசியாகப் பயன்படுத்தப்பட்டது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ใช้ล่าสุดเมื่อประมาณ %@ ที่แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Son kullanım yaklaşık %@ önce."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Востаннє використовувалося приблизно %@ тому."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Lần dùng cuối khoảng %@ trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@上次使用约在 %@前。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上次使用約在 %@前。"
          }
        }
      }
    },
    "%@ Only files untouched for %@ or more.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ تُعرض فقط الملفات التي بقيت دون تعديل لمدة %@ أو أكثر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Nur Dateien, die mindestens %@ lang unberührt sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ Only files untouched for %2$@ or more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Solo archivos sin tocar desde hace %@ o más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Uniquement les fichiers non modifiés depuis au moins %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ केवल वे फ़ाइलें जिन्हें %@ या उससे अधिक समय से छुआ नहीं गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Hanya file yang tidak disentuh selama %@ atau lebih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Solo file non modificati da almeno %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@以上変更されていないファイルのみが対象です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ 이상 변경되지 않은 파일만 해당됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ അല്ലെങ്കിൽ അതിലധികം കാലമായി തൊടാത്ത ഫയലുകൾ മാത്രം."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Alleen bestanden die %@ of langer onaangeroerd zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Tylko pliki nieużywane przez co najmniej %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Apenas arquivos intocados há %@ ou mais."
          }
        },
        "ru": {
          "stringUnit": {

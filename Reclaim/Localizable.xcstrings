        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko trafia do Kosza, więc możesz to cofnąć"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo vai para o Lixo, então dá para desfazer"

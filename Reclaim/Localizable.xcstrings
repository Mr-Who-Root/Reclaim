    "Scans Downloads, Desktop & Documents, your Home folder, or any folder": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفحص التنزيلات وسطح المكتب والمستندات، أو مجلد البيت، أو أي مجلد"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannt Downloads, Schreibtisch & Dokumente, deinen Benutzerordner oder einen beliebigen Ordner"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza Descargas, Escritorio y Documentos, tu carpeta de inicio o cualquier carpeta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse Téléchargements, Bureau et Documents, votre dossier de départ ou n'importe quel dossier"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डाउनलोड, डेस्कटॉप और दस्तावेज़, आपका होम फ़ोल्डर या कोई भी फ़ोल्डर स्कैन करता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memindai Unduhan, Desktop & Dokumen, folder Rumah Anda, atau folder mana pun"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona Download, Scrivania e Documenti, la cartella Inizio o qualsiasi cartella"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード、デスクトップ、書類、ホームフォルダ、または任意のフォルダをスキャン"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드, 데스크탑 및 문서, 홈 폴더 또는 모든 폴더 스캔"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഡൗൺലോഡുകൾ, ഡെസ്ക്ടോപ്പ്, ഡോക്യുമെന്റുകൾ, നിങ്ങളുടെ ഹോം ഫോൾഡർ, അല്ലെങ്കിൽ ഏത് ഫോൾഡറും സ്കാൻ ചെയ്യുന്നു"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scant Downloads, Bureaublad en Documenten, je thuismap of elke andere map"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanuje Pobrane rzeczy, Biurko i Dokumenty, katalog domowy lub dowolny katalog"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisa Downloads, Mesa e Documentos, sua pasta de início ou qualquer pasta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирует «Загрузки», «Рабочий стол» и «Документы», домашнюю папку или любую другую папку"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skannar Hämtade filer, Skrivbord och Dokument, din hemmapp eller valfri mapp"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிவிறக்கங்கள், டெஸ்க்டாப் & ஆவணங்கள், உங்கள் முகப்புக் கோப்புறை அல்லது எந்தக் கோப்புறையையும் ஸ்கேன் செய்யும்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สแกนดาวน์โหลด เดสก์ท็อปและเอกสาร โฟลเดอร์บ้าน หรือโฟลเดอร์ใดก็ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilenler, Masaüstü ve Belgeler'i, ev klasörünüzü veya herhangi bir klasörü tarar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканує «Викачане», «Робочий стіл» і «Документи», домівку або будь-яку іншу папку"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét Tải về, Màn hình nền & Tài liệu, thư mục nhà riêng hoặc bất kỳ thư mục nào"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描“下载”、“桌面”和“文稿”、你的个人文件夹或任意文件夹"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描「下載項目」、「桌面」與「文件」、個人專屬檔案夾或任何檔案夾"
          }
        }
      }
    },
    "Scans in progress stop. Your results, history and settings are kept.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتوقف عمليات الفحص الجارية. يتم الاحتفاظ بنتائجك وسجلك وإعداداتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laufende Scans werden gestoppt. Deine Ergebnisse, dein Verlauf und deine Einstellungen bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los análisis en curso se detendrán. Se conservan tus resultados, historial y ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les analyses en cours s'arrêtent. Vos résultats, votre historique et vos réglages sont conservés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चल रहे स्कैन रुक जाते हैं। आपके परिणाम, इतिहास और सेटिंग्ज़ बनी रहती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemindaian yang sedang berjalan akan berhenti. Hasil, riwayat, dan pengaturan Anda tetap disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scansioni in corso si interrompono. Risultati, cronologia e impostazioni vengono mantenuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進行中のスキャンは停止します。結果、履歴、設定は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 중인 스캔이 중단됩니다. 결과, 기록 및 설정은 유지됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നടന്നുകൊണ്ടിരിക്കുന്ന സ്കാനുകൾ നിർത്തും. നിങ്ങളുടെ ഫലങ്ങൾ, ചരിത്രം, ക്രമീകരണം എന്നിവ നിലനിർത്തും."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lopende scans stoppen. Je resultaten, geschiedenis en instellingen blijven behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwające skanowania zostaną zatrzymane. Wyniki, historia i ustawienia zostaną zachowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As análises em andamento são interrompidas. Seus resultados, histórico e ajustes são mantidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущие сканирования остановятся. Результаты, история и настройки сохранятся."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pågående skanningar avbryts. Dina resultat, din historik och dina inställningar behålls."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நடந்துகொண்டிருக்கும் ஸ்கேன்கள் நிறுத்தப்படும். உங்கள் முடிவுகள், வரலாறு, அமைப்புகள் வைக்கப்படும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสแกนที่กำลังดำเนินอยู่จะหยุด ผลลัพธ์ ประวัติ และการตั้งค่าของคุณจะยังคงอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam eden taramalar durur. Sonuçlarınız, geçmişiniz ve ayarlarınız korunur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поточні сканування зупиняться. Результати, історія й параметри збережуться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các lần quét đang diễn ra sẽ dừng. Kết quả, lịch sử và cài đặt của bạn được giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在进行的扫描将停止。你的结果、历史记录和设置会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進行中的掃描會停止。您的結果、歷史記錄和設定都會保留。"
          }
        }
      }
    },
    "Scans your Downloads, Movies, Documents and Desktop by default — or your Home folder, or any folder you pick. Filter by size, age and kind to find what's worth removing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفحص التنزيلات والأفلام والمستندات وسطح المكتب افتراضيًا — أو مجلد البيت، أو أي مجلد تختاره. صفِّ النتائج حسب الحجم والعمر والنوع للعثور على ما يستحق الإزالة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannt standardmäßig deine Ordner Downloads, Filme, Dokumente und Schreibtisch – oder deinen Benutzerordner oder einen beliebigen Ordner deiner Wahl. Filtere nach Größe, Alter und Art, um zu finden, was sich zu entfernen lohnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza por omisión Descargas, Películas, Documentos y Escritorio, o bien tu carpeta de inicio o cualquier carpeta que elijas. Filtra por tamaño, antigüedad y tipo para encontrar lo que merece la pena eliminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse par défaut vos dossiers Téléchargements, Films, Documents et Bureau, ou votre dossier de départ, ou tout dossier de votre choix. Filtrez par taille, âge et type pour trouver ce qui mérite d'être supprimé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिफ़ॉल्ट रूप से आपके डाउनलोड, मूवी, दस्तावेज़ और डेस्कटॉप स्कैन करता है — या आपका होम फ़ोल्डर, या आपका चुना हुआ कोई भी फ़ोल्डर। हटाने लायक चीज़ें खोजने के लिए आकार, आयु और प्रकार से फ़िल्टर करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memindai Unduhan, Film, Dokumen, dan Desktop Anda secara default — atau folder Rumah Anda, atau folder mana pun yang Anda pilih. Filter berdasarkan ukuran, usia, dan jenis untuk menemukan yang layak dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona per impostazione predefinita Download, Filmati, Documenti e Scrivania, oppure la cartella Inizio o qualsiasi cartella tu scelga. Filtra per dimensione, età e tipo per trovare ciò che vale la pena rimuovere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトでは、ダウンロード、ムービー、書類、デスクトップをスキャンします。ホームフォルダや任意のフォルダを選ぶこともできます。サイズ、経過期間、種類で絞り込んで、削除する価値のあるものを見つけましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본적으로 다운로드, 동영상, 문서 및 데스크탑 폴더를 스캔하며, 홈 폴더나 원하는 폴더를 선택할 수도 있습니다. 크기, 기간 및 종류로 필터링하여 제거할 만한 항목을 찾으세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഡിഫോൾട്ടായി നിങ്ങളുടെ ഡൗൺലോഡുകൾ, സിനിമകൾ, ഡോക്യുമെന്റുകൾ, ഡെസ്ക്ടോപ്പ് എന്നിവ സ്കാൻ ചെയ്യുന്നു — അല്ലെങ്കിൽ നിങ്ങളുടെ ഹോം ഫോൾഡർ, അല്ലെങ്കിൽ നിങ്ങൾ തിരഞ്ഞെടുക്കുന്ന ഏത് ഫോൾഡറും. നീക്കം ചെയ്യേണ്ടവ കണ്ടെത്താൻ വലുപ്പം, പഴക്കം, തരം എന്നിവ ഉപയോഗിച്ച് ഫിൽട്ടർ ചെയ്യുക."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scant standaard je mappen Downloads, Films, Documenten en Bureaublad — of je thuismap, of een map die je kiest. Filter op grootte, leeftijd en soort om te vinden wat het verwijderen waard is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślnie skanuje katalogi Pobrane rzeczy, Filmy, Dokumenty i Biurko — albo katalog domowy lub dowolny wybrany katalog. Filtruj według rozmiaru, wieku i rodzaju, aby znaleźć to, co warto usunąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisa por padrão Downloads, Filmes, Documentos e Mesa — ou sua pasta de início, ou qualquer pasta que você escolher. Filtre por tamanho, idade e tipo para encontrar o que vale a pena remover."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию сканирует папки «Загрузки», «Фильмы», «Документы» и «Рабочий стол» — или домашнюю папку, или любую выбранную папку. Фильтруйте по размеру, возрасту и типу, чтобы найти то, что стоит удалить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skannar Hämtade filer, Filmer, Dokument och Skrivbord som standard – eller din hemmapp eller valfri mapp du väljer. Filtrera efter storlek, ålder och typ för att hitta det som är värt att ta bort."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இயல்பாக உங்கள் பதிவிறக்கங்கள், திரைப்படங்கள், ஆவணங்கள், டெஸ்க்டாப் ஆகியவற்றை ஸ்கேன் செய்யும் — அல்லது உங்கள் முகப்புக் கோப்புறையை, அல்லது நீங்கள் தேர்வுசெய்யும் எந்தக் கோப்புறையையும். அகற்றத் தக்கவற்றைக் கண்டறிய அளவு, வயது, வகை மூலம் வடிகட்டவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สแกนดาวน์โหลด ภาพยนตร์ เอกสาร และเดสก์ท็อปตามค่าเริ่มต้น — หรือโฟลเดอร์บ้าน หรือโฟลเดอร์ใดก็ได้ที่คุณเลือก กรองตามขนาด อายุ และชนิด เพื่อค้นหาสิ่งที่ควรเอาออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan olarak İndirilenler, Filmler, Belgeler ve Masaüstü klasörlerinizi tarar — ya da ev klasörünüzü veya seçtiğiniz herhangi bir klasörü. Kaldırmaya değer olanları bulmak için boyuta, yaşa ve türe göre filtreleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Типово сканує папки «Викачане», «Фільми», «Документи» і «Робочий стіл» — або домівку, або будь-яку вибрану папку. Фільтруйте за розміром, віком і типом, щоб знайти те, що варто видалити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo mặc định, quét Tải về, Phim, Tài liệu và Màn hình nền — hoặc thư mục nhà riêng, hoặc bất kỳ thư mục nào bạn chọn. Lọc theo kích thước, độ cũ và loại để tìm những gì đáng gỡ bỏ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认扫描你的“下载”、“影片”、“文稿”和“桌面”——也可以扫描你的个人文件夹或你选取的任意文件夹。按大小、时长和种类筛选，找出值得移除的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設會掃描「下載項目」、「影片」、「文件」和「桌面」，也可以掃描個人專屬檔案夾或您選擇的任何檔案夾。依大小、存放時間和類型篩選，找出值得移除的項目。"
          }
        }
      }
    },

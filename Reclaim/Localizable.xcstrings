        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama താൽക്കാലിക ഡാറ്റ"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdelijke gegevens van Ollama"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane tymczasowe Ollama"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados temporários do Ollama"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Временные данные Ollama"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillfälliga data från Ollama"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama தற்காலிகத் தரவு"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลชั่วคราวของ Ollama"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama geçici verileri"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тимчасові дані Ollama"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu tạm của Ollama"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama 临时数据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama 暫存資料"
          }
        }
      }
    },
    "One read-only pass across every section: cleanup tools, your apps, Security Check, the Storage Map and the Trash. Nothing moves until you approve it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جولة واحدة للقراءة فقط عبر كل الأقسام: أدوات التنظيف وتطبيقاتك وفحص الأمان وخريطة التخزين وسلة المهملات. لا يُنقل أي شيء حتى توافق عليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein rein lesender Durchlauf durch alle Bereiche: Bereinigungswerkzeuge, deine Apps, Sicherheitsprüfung, Speicherbelegung und Papierkorb. Nichts wird verschoben, bis du zustimmst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pasada de solo lectura por todas las secciones: herramientas de limpieza, tus apps, Revisión de seguridad, el Mapa de almacenamiento y la Papelera. No se mueve nada hasta que lo apruebes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul passage en lecture seule dans chaque section : outils de nettoyage, vos apps, Contrôle de sécurité, Carte du stockage et Corbeille. Rien ne bouge sans votre accord."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर अनुभाग में एक केवल-पठन जाँच: सफ़ाई टूल, आपके ऐप्स, सुरक्षा जाँच, स्टोरेज मैप और ट्रैश। आपकी स्वीकृति के बिना कुछ भी नहीं हटता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu kali pemeriksaan hanya-baca di setiap bagian: alat pembersihan, app Anda, Pemeriksaan Keamanan, Peta Penyimpanan, dan Tong Sampah. Tidak ada yang dipindahkan hingga Anda menyetujuinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un unico passaggio in sola lettura in ogni sezione: strumenti di pulizia, le tue app, Controllo sicurezza, Mappa archiviazione e Cestino. Nulla viene spostato finché non lo approvi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのセクションを読み取り専用で一度に確認します：クリーンアップツール、お使いの App、セキュリティチェック、ストレージマップ、ゴミ箱。承認するまで何も移動しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 섹션을 읽기 전용으로 한 번에 확인합니다: 정리 도구, 내 앱, 보안 검사, 저장 공간 맵, 휴지통. 승인하기 전에는 아무것도 이동되지 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാ വിഭാഗങ്ങളിലൂടെയും ഒരൊറ്റ റീഡ്-ഒൺലി പരിശോധന: ക്ലീനപ്പ് ടൂളുകൾ, നിങ്ങളുടെ ആപ്പുകൾ, സുരക്ഷാ പരിശോധന, സ്റ്റോറേജ് മാപ്പ്, ട്രാഷ്. നിങ്ങൾ അംഗീകരിക്കുന്നത് വരെ ഒന്നും നീങ്ങില്ല."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén alleen-lezen ronde langs elke sectie: opschoontools, je apps, Beveiligingscontrole, de Opslagkaart en de prullenmand. Niets wordt verplaatst totdat je het goedkeurt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno przejście tylko do odczytu przez wszystkie sekcje: narzędzia porządkowe, Twoje aplikacje, Kontrola bezpieczeństwa, Mapa dysku i Kosz. Nic nie zostanie przeniesione, dopóki tego nie zatwierdzisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma passada somente leitura por todas as seções: ferramentas de limpeza, seus apps, Verificação de Segurança, o Mapa de Armazenamento e o Lixo. Nada é movido até você aprovar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один проход только для чтения по всем разделам: инструменты очистки, Ваши приложения, Проверка безопасности, Карта хранилища и Корзина. Ничего не перемещается без Вашего одобрения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En skrivskyddad genomgång av alla avsnitt: rensningsverktyg, dina appar, säkerhetskontroll, Lagringskarta och papperskorgen. Inget flyttas förrän du godkänner det."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு பிரிவிலும் படிக்க மட்டுமான ஒரே ஓட்டம்: சுத்தம் செய்யும் கருவிகள், உங்கள் ஆப்ஸ், பாதுகாப்புச் சோதனை, சேமிப்பக வரைபடம் மற்றும் குப்பைத் தொட்டி. நீங்கள் அங்கீகரிக்கும் வரை எதுவும் நகராது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สแกนแบบอ่านอย่างเดียวรอบเดียวครอบคลุมทุกส่วน: เครื่องมือล้างข้อมูล แอปของคุณ ตรวจสอบความปลอดภัย แผนที่พื้นที่จัดเก็บ และถังขยะ ไม่มีสิ่งใดถูกย้ายจนกว่าคุณจะอนุมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her bölümde salt okunur tek geçiş: temizlik araçları, uygulamalarınız, Güvenlik Kontrolü, Depolama Haritası ve Çöp Sepeti. Siz onaylayana kadar hiçbir şey taşınmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один прохід лише для читання всіма розділами: інструменти очищення, ваші програми, Перевірка безпеки, Карта сховища і Смітник. Ніщо не переміщується без вашого схвалення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một lượt quét chỉ đọc qua mọi phần: công cụ dọn dẹp, ứng dụng của bạn, Kiểm tra bảo mật, Bản đồ dung lượng và Thùng rác. Không có gì bị di chuyển cho đến khi bạn phê duyệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以只读方式一次检查每个分区：清理工具、你的应用、安全检查、储存空间地图和废纸篓。在你批准之前不会移动任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以唯讀方式一次檢查每個區段：清理工具、您的 App、安全性檢查、儲存空間地圖和垃圾桶。在您核准之前，不會移動任何項目。"
          }
        }
      }
    },
    "Only Reclaim's list is cleared; nothing in the Trash is touched.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم مسح قائمة Reclaim فقط؛ ولا يتم المساس بأي شيء في سلة المهملات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die Liste von Reclaim wird gelöscht; der Inhalt des Papierkorbs bleibt unberührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se borra la lista de Reclaim; no se toca nada de la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule la liste de Reclaim est effacée ; rien n'est touché dans la Corbeille."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल Reclaim की सूची साफ़ होती है; ट्रैश में किसी चीज़ को छुआ नहीं जाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya daftar Reclaim yang dihapus; tidak ada isi Tong Sampah yang disentuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene cancellato solo l'elenco di Reclaim; il contenuto del Cestino non viene toccato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "消去されるのは Reclaim のリストのみで、ゴミ箱の中身には手を加えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim의 목록만 지워지며 휴지통의 항목은 그대로 유지됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim-ന്റെ ലിസ്റ്റ് മാത്രമേ മായ്ക്കൂ; ട്രാഷിലുള്ളതൊന്നും തൊടില്ല."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de lijst van Reclaim wordt gewist; niets in de prullenmand wordt aangeraakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czyszczona jest tylko lista Reclaim; zawartość Kosza pozostaje nietknięta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas a lista do Reclaim é limpa; nada no Lixo é afetado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очищается только список Reclaim; содержимое Корзины не затрагивается."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara Reclaims lista rensas. Inget i papperskorgen påverkas."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim இன் பட்டியல் மட்டுமே அழிக்கப்படும்; குப்பைத் தொட்டியில் உள்ள எதுவும் தொடப்படாது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ล้างเฉพาะรายการของ Reclaim ไม่มีสิ่งใดในถังขยะถูกแตะต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca Reclaim'in listesi temizlenir; Çöp Sepetindeki hiçbir şeye dokunulmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очищається лише список Reclaim; вміст Смітника не зачіпається."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ danh sách của Reclaim bị xóa; không có gì trong Thùng rác bị động đến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅清除 Reclaim 的列表；废纸篓中的内容不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會清除 Reclaim 的列表；垃圾桶中的項目不受影響。"
          }
        }
      }
    },
    "Only confirmed Trash moves are counted.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحتسب فقط عمليات النقل المؤكدة إلى سلة المهملات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden nur bestätigte Verschiebungen in den Papierkorb gezählt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se cuentan los traslados a la Papelera confirmados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les placements confirmés dans la Corbeille sont comptabilisés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल पुष्टि करके ट्रैश में ले जाए गए आइटम गिने जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pemindahan ke Tong Sampah yang dikonfirmasi yang dihitung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono conteggiati solo gli spostamenti nel Cestino confermati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱への移動が確認されたものだけを集計しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통으로 이동이 확인된 항목만 집계됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്ഥിരീകരിച്ച ട്രാഷ് നീക്കങ്ങൾ മാത്രമേ കണക്കാക്കൂ."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen bevestigde verplaatsingen naar de prullenmand worden geteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczone są tylko potwierdzone przeniesienia do Kosza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas as movimentações confirmadas para o Lixo são contadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учитываются только подтвержденные перемещения в Корзину."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara bekräftade flyttar till papperskorgen räknas."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உறுதிசெய்யப்பட்ட குப்பைத் தொட்டி நகர்வுகள் மட்டுமே கணக்கிடப்படும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นับเฉพาะการย้ายไปที่ถังขยะที่ยืนยันแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca onaylanmış Çöp Sepeti taşımaları sayılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Враховуються лише підтверджені переміщення в Смітник."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ tính các lần chuyển vào Thùng rác đã xác nhận."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅统计已确认移到废纸篓的项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只計算已確認移到垃圾桶的項目。"
          }
        }
      }
    },
    "Only lists temp files nothing has touched for %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض فقط الملفات المؤقتة التي لم يمسّها شيء منذ %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Listet nur temporäre Dateien, die mindestens %@ lang unberührt sind"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo muestra archivos temporales sin tocar desde hace %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne liste que les fichiers temporaires non modifiés depuis %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल वे अस्थायी फ़ाइलें दिखाता है, जिन्हें %@ से किसी ने नहीं छुआ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya menampilkan file sementara yang tidak disentuh selama %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elenca solo i file temporanei non modificati da %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@以上変更されていない一時ファイルのみを表示します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 동안 아무것도 건드리지 않은 임시 파일만 표시합니다"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ആയി ഒന്നും തൊടാത്ത താൽക്കാലിക ഫയലുകൾ മാത്രം കാണിക്കുന്നു"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont alleen tijdelijke bestanden die %@ onaangeroerd zijn"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetla tylko pliki tymczasowe nieużywane przez %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista apenas arquivos temporários intocados há %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает только временные файлы, которые не изменялись %@ и дольше"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar bara tillfälliga filer som inget har rört på %@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ காலமாக எதுவும் தொடாத தற்காலிகக் கோப்புகளை மட்டுமே பட்டியலிடும்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงเฉพาะไฟล์ชั่วคราวที่ไม่มีสิ่งใดแตะต้องมา %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca %@ boyunca hiçbir şeyin dokunmadığı geçici dosyaları listeler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує лише тимчасові файли, які не змінювалися %@ або довше"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ liệt kê tệp tạm không bị động đến trong %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅列出至少 %@未被改动的临时文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只列出已 %@未被變動的暫存檔"
          }
        }
      }
    },
    "Only the actions you confirmed are being requested.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم طلب الإجراءات التي أكدتها فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden nur die von dir bestätigten Aktionen angefordert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se están solicitando las acciones que has confirmado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les actions que vous avez confirmées sont demandées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल वही कार्रवाइयाँ अनुरोधित की जा रही हैं जिनकी आपने पुष्टि की है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya tindakan yang Anda konfirmasi yang diminta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono richieste solo le azioni confermate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確定した操作のみを要求しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인한 작업만 요청하는 중입니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ സ്ഥിരീകരിച്ച പ്രവർത്തനങ്ങൾ മാത്രമാണ് അഭ്യർത്ഥിക്കുന്നത്."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de acties die je hebt bevestigd, worden aangevraagd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykonywane są tylko potwierdzone czynności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas as ações que você confirmou estão sendo solicitadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрашиваются только подтвержденные Вами действия."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara de åtgärder du har bekräftat begärs."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் உறுதிசெய்த செயல்கள் மட்டுமே கோரப்படுகின்றன."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังร้องขอเฉพาะการดำเนินการที่คุณยืนยันเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca onayladığınız işlemler isteniyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитуються лише підтверджені вами дії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ các thao tác bạn đã xác nhận đang được yêu cầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只请求你确认过的操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會請求您確認過的動作。"
          }
        }
      }
    },
    "Only the list is cleared. Nothing in the Trash is touched.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم مسح القائمة فقط. لا يتم المساس بأي شيء في سلة المهملات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die Liste wird gelöscht. Der Inhalt des Papierkorbs bleibt unberührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se borra la lista. No se toca nada de la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule la liste est effacée. Rien n'est touché dans la Corbeille."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल सूची साफ़ होती है। ट्रैश में किसी चीज़ को छुआ नहीं जाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya daftarnya yang dihapus. Tidak ada isi Tong Sampah yang disentuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene cancellato solo l'elenco. Il contenuto del Cestino non viene toccato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "消去されるのはリストのみです。ゴミ箱の中身には手を加えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록만 지워집니다. 휴지통의 항목은 그대로 유지됩니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലിസ്റ്റ് മാത്രമേ മായ്ക്കൂ. ട്രാഷിലുള്ളതൊന്നും തൊടില്ല."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de lijst wordt gewist. Niets in de prullenmand wordt aangeraakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czyszczona jest tylko lista. Zawartość Kosza pozostaje nietknięta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas a lista é limpa. Nada no Lixo é afetado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очищается только список. Содержимое Корзины не затрагивается."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara listan rensas. Inget i papperskorgen påverkas."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பட்டியல் மட்டுமே அழிக்கப்படும். குப்பைத் தொட்டியில் உள்ள எதுவும் தொடப்படாது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ล้างเฉพาะรายการ ไม่มีสิ่งใดในถังขยะถูกแตะต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca liste temizlenir. Çöp Sepetindeki hiçbir şeye dokunulmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очищається лише список. Вміст Смітника не зачіпається."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ danh sách bị xóa. Không có gì trong Thùng rác bị động đến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅清除列表。废纸篓中的内容不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會清除列表。垃圾桶中的項目不受影響。"
          }
        }
      }
    },
    "Only when it finds at least": {
      "localizations": {
        "ar": {

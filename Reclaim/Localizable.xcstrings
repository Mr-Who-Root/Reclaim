    "Couldn't check %@. Everything that finished is ready to review.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte nicht geprüft werden. Alles, was fertig ist, kann jetzt geprüft werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido comprobar %@. Todo lo que ha terminado está listo para revisar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier %@. Tout ce qui est terminé est prêt à être examiné."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ की जाँच नहीं हो सकी। जो कुछ पूरा हुआ, वह समीक्षा के लिए तैयार है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を確認できませんでした。完了した項目はレビューできます。"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ പരിശോധിക്കാനായില്ല. പൂർത്തിയായതെല്ലാം അവലോകനത്തിന് തയ്യാറാണ്."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ஐச் சரிபார்க்க முடியவில்லை. முடிந்தவை அனைத்தும் மதிப்பாய்வுக்குத் தயார்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查 %@。所有已完成的部分均可审阅。"
          }
        }
      }
    },

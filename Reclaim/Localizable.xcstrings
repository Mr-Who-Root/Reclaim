    "Docker": {
      "shouldTranslate": false
    },
    "Docker deletes these directly. They don't go to the Trash and can't be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحذف Docker هذه العناصر مباشرةً. لا تنتقل إلى سلة المهملات ولا يمكن التراجع عن ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker löscht diese Daten direkt. Sie landen nicht im Papierkorb. Dies kann nicht widerrufen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker borra estos datos directamente. No pasan por la Papelera y no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker supprime ces données directement. Elles ne passent pas par la Corbeille et l'opération est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker इन्हें सीधे डिलीट करता है। ये ट्रैश में नहीं जाते और इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker menghapusnya secara langsung. Item ini tidak masuk ke Tong Sampah dan tidak dapat diurungkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker elimina questi dati direttamente. Non passano dal Cestino e l'operazione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらは Docker が直接削除します。ゴミ箱には入らず、取り消すこともできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker가 이 항목을 직접 삭제합니다. 휴지통으로 이동하지 않으며 실행 취소할 수 없습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker ഇവ നേരിട്ട് ഇല്ലാതാക്കുന്നു. ഇവ ട്രാഷിലേക്ക് പോകില്ല, പഴയപടിയാക്കാനുമാകില്ല."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker verwijdert deze gegevens direct. Ze gaan niet naar de prullenmand en dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker usuwa te dane bezpośrednio. Nie trafiają do Kosza i tej operacji nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Docker apaga esses dados diretamente. Eles não vão para o Lixo e não é possível desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker удаляет их напрямую. Они не попадают в Корзину, и это действие нельзя отменить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker raderar detta direkt. Det hamnar inte i papperskorgen och går inte att ångra."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker இவற்றை நேரடியாக நீக்கும். இவை குப்பைத் தொட்டிக்குச் செல்லாது, செயல்தவிர்க்கவும் முடியாது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker จะลบรายการเหล่านี้โดยตรง ไม่ได้ย้ายไปที่ถังขยะและไม่สามารถเลิกทำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker bunları doğrudan siler. Çöp Sepetine gitmezler ve geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker видаляє їх напряму. Вони не потрапляють у Смітник, і цю дію не можна відмінити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker xóa trực tiếp các mục này. Chúng không vào Thùng rác và không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些内容由 Docker 直接删除，不会进入废纸篓，且无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些項目會由 Docker 直接刪除，不會移到垃圾桶，也無法還原。"
          }
        }
      }
    },
    "Docker didn't finish": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُكمل Docker العملية"
          }
        },

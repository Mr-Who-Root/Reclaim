        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluir itens marcados como Cuidado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить объекты с пометкой «Осторожно»"

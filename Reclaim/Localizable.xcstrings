          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il download non è un'app Reclaim valida, quindi non è stato installato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードしたファイルは有効な Reclaim App ではないため、インストールされませんでした。"
          }
        },
        "ko": {
          "stringUnit": {

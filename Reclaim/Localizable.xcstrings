    "Look-alikes are grouped, and the sharpest copy is kept": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تجميع الصور المتشابهة، والاحتفاظ بالنسخة الأكثر حدة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ähnliche Aufnahmen werden gruppiert, und die schärfste wird behalten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos similares se agrupan y se conserva la copia más nítida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos similaires sont regroupées, et la plus nette est conservée"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मिलती-जुलती फ़ोटो का समूह बनाया जाता है, और सबसे शार्प कॉपी रखी जाती है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto mirip dikelompokkan, dan salinan paling tajam disimpan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto simili vengono raggruppate e la copia più nitida viene conservata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "類似写真はグループ化され、最もシャープな 1 枚が残ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유사한 사진은 그룹으로 묶이고 가장 선명한 사진이 유지됩니다"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സമാന ചിത്രങ്ങൾ ഗ്രൂപ്പ് ചെയ്യുന്നു, ഏറ്റവും വ്യക്തമായ പകർപ്പ് സൂക്ഷിക്കുന്നു"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelijkende foto's worden gegroepeerd en de scherpste kopie wordt bewaard"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podobne zdjęcia są grupowane, a najostrzejsza kopia zostaje zachowana"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos semelhantes são agrupadas, e a mais nítida é mantida"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похожие фото группируются, и самая резкая копия сохраняется"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Liknande bilder grupperas och den skarpaste kopian behålls"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒத்த படங்கள் குழுவாக்கப்படுகின்றன, மிகக் கூர்மையான நகல் வைத்துக்கொள்ளப்படுகிறது"
          }

          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File identici byte per byte. Una copia di ciascuno viene sempre conservata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バイト単位で同一のファイルです。それぞれ 1 つのコピーは必ず残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바이트 단위로 동일한 파일입니다. 각각 사본 하나는 항상 남겨 둡니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബൈറ്റ്-ബൈ-ബൈറ്റ് സമാനമായ ഫയലുകൾ. ഓരോന്നിന്റെയും ഒരു പകർപ്പ് എപ്പോഴും നിലനിൽക്കും."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Byte voor byte identieke bestanden. Van elk bestand blijft altijd één kopie bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki identyczne co do bajtu. Jedna kopia każdego z nich zawsze zostaje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos idênticos byte a byte. Uma cópia de cada sempre é mantida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Побайтно идентичные файлы. Одна копия каждого всегда остается."
          }
        },
        "sv": {
          "stringUnit": {

    "Every tool unlocked. No account, no subscription, no network.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Werkzeuge freigeschaltet. Kein Account, kein Abo, kein Netzwerk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las herramientas desbloqueadas. Sin cuenta, sin suscripción, sin red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les outils débloqués. Pas de compte, pas d'abonnement, pas de réseau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर टूल अनलॉक। कोई खाता नहीं, कोई सब्सक्रिप्शन नहीं, कोई नेटवर्क नहीं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのツールが利用可能。アカウントもサブスクリプションもネットワーク接続も不要です。"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാ ടൂളുകളും ലഭ്യം. അക്കൗണ്ടില്ല, സബ്‌സ്ക്രിപ്ഷനില്ല, നെറ്റ്‌വർക്കില്ല."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அனைத்துக் கருவிகளும் திறக்கப்பட்டுள்ளன. கணக்கு இல்லை, சந்தா இல்லை, நெட்வொர்க் இல்லை."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有工具均已解锁。无需账户、无需订阅、无需联网。"
          }
        }
      }
    },

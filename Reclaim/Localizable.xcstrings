        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers temporaires de llama.cpp, vLLM ou d'un moteur d'exécution de modèles locaux similaire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "llama.cpp, vLLM या ऐसे ही किसी लोकल मॉडल रनर की अस्थायी फ़ाइलें।"

        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഡെവലപ്പർ കാഷെകൾ നിങ്ങളുടെ അടുത്ത ബിൽഡിൽ പുനർനിർമ്മിക്കപ്പെടും"
          }
        },
        "nl": {
          "stringUnit": {

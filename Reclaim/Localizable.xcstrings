    "App caches, logs and developer leftovers that rebuild themselves.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Caches, Protokolle und Entwicklerreste, die sich selbst neu aufbauen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cachés de apps, registros y restos de desarrollo que se regeneran solos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches d'apps, journaux et résidus de développement qui se reconstruisent d'eux-mêmes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप कैश, लॉग और डेवलपर अवशेष, जो अपने आप फिर से बन जाते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動的に再作成される App のキャッシュ、ログ、開発用の残存ファイル。"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്വയം പുനർനിർമ്മിക്കപ്പെടുന്ന ആപ്പ് കാഷെകൾ, ലോഗുകൾ, ഡെവലപ്പർ അവശേഷിപ്പുകൾ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தானாகவே மீண்டும் உருவாகும் ஆப் கேச்கள், பதிவுகள் மற்றும் டெவலப்பர் எஞ்சியவை."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会自动重建的应用缓存、日志和开发残留文件。"
          }
        }
      }
    },

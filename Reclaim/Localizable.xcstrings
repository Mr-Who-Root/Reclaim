            "state": "translated",
            "value": "Räume deine Fotos auf"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordena tus fotos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites le tri dans vos photos"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी फ़ोटो व्यवस्थित करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapikan foto Anda"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti ordine nelle foto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を整理"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 정리"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഫോട്ടോകൾ ചിട്ടപ്പെടുത്തുക"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruim je foto's op"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporządkuj zdjęcia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Organize suas fotos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведите порядок в фото"
          }
        },
        "sv": {

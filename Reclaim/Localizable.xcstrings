    "Containers that have exited. Anything they changed inside themselves is lost when they're removed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حاويات انتهى تشغيلها. يضيع كل ما غيّرته بداخلها عند إزالتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Container, die beendet wurden. Was sie in ihrem Inneren geändert haben, geht beim Entfernen verloren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenedores que han terminado. Lo que hayan cambiado en su interior se pierde al eliminarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conteneurs qui se sont arrêtés. Les modifications faites à l'intérieur sont perdues lorsqu'ils sont supprimés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद हो चुके कंटेनर। हटाए जाने पर इनके अंदर हुए सभी बदलाव खो जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Container yang sudah berhenti. Semua perubahan di dalamnya hilang saat container dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Container che sono terminati. Tutto ciò che hanno modificato al loro interno va perso quando vengono rimossi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了したコンテナです。削除すると、コンテナ内で行われた変更はすべて失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료된 컨테이너입니다. 제거하면 컨테이너 내부에서 변경된 내용은 모두 사라집니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്രവർത്തനം അവസാനിച്ച കണ്ടെയ്‌നറുകൾ. നീക്കം ചെയ്യുമ്പോൾ അവയ്ക്കുള്ളിൽ വരുത്തിയ മാറ്റങ്ങളെല്ലാം നഷ്ടമാകും."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Containers die zijn gestopt. Wat ze in zichzelf hebben gewijzigd, gaat verloren als ze worden verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontenery, które zakończyły działanie. Wszystko, co zmieniły w swoim wnętrzu, przepadnie po ich usunięciu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contêineres que foram encerrados. O que foi alterado dentro deles se perde quando são removidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершившие работу контейнеры. Все, что они изменили внутри себя, будет потеряно при их удалении."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Containrar som har avslutats. Allt de har ändrat inuti sig själva försvinner när de tas bort."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இயக்கம் முடிந்த கன்டெய்னர்கள். அவை அகற்றப்படும்போது அவற்றுக்குள் செய்யப்பட்ட மாற்றங்கள் அனைத்தும் இழக்கப்படும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คอนเทนเนอร์ที่หยุดทำงานแล้ว สิ่งที่เปลี่ยนแปลงภายในคอนเทนเนอร์จะหายไปเมื่อเอาออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışması sona ermiş konteynerler. Kaldırıldıklarında kendi içlerinde yaptıkları tüm değişiklikler kaybolur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Контейнери, що завершили роботу. Усе, що вони змінили всередині себе, буде втрачено після їх видалення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các container đã thoát. Mọi thay đổi bên trong chúng sẽ mất khi bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已退出的容器。移除后，容器内部所做的任何更改都会丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已結束的容器。移除後，容器內部所做的任何變更都會遺失。"
          }
        }
      }
    },

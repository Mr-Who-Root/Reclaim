    "Other apps' Containers and some Library folders can only be checked with it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن فحص مجلدات Containers للتطبيقات الأخرى وبعض مجلدات المكتبة إلا به."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Container anderer Apps und einige Library-Ordner können nur damit geprüft werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los Containers de otras apps y algunas carpetas de la Biblioteca solo se pueden comprobar con él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dossiers Containers d'autres apps et certains dossiers de la Bibliothèque ne peuvent être vérifiés qu'avec cet accès."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अन्य ऐप्स के Containers और कुछ लाइब्रेरी फ़ोल्डरों की जाँच केवल इसी से हो सकती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontainer app lain dan beberapa folder Perpustakaan hanya dapat diperiksa dengan akses ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cartelle Containers di altre app e alcune cartelle della Libreria possono essere controllate solo con questo accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの App の Containers や一部のライブラリフォルダは、これがないと確認できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱의 Containers와 일부 라이브러리 폴더는 이 권한이 있어야 확인할 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മറ്റ് ആപ്പുകളുടെ Containers-ഉം ചില ലൈബ്രറി ഫോൾഡറുകളും ഇതുണ്ടെങ്കിൽ മാത്രമേ പരിശോധിക്കാനാകൂ."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De containers van andere apps en sommige bibliotheekmappen kunnen alleen hiermee worden gecontroleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontenery innych aplikacji i niektóre katalogi Biblioteki można sprawdzić tylko z nim."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os Containers de outros apps e algumas pastas da Biblioteca só podem ser verificados com ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только с ним можно проверить папки Containers других приложений и некоторые папки «Библиотеки»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Andra appars Containers-mappar och vissa biblioteksmappar kan bara kontrolleras med den."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பிற ஆப்ஸின் Containers மற்றும் சில Library கோப்புறைகளை இதைக் கொண்டு மட்டுமே சரிபார்க்க முடியும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Containers ของแอปอื่นและโฟลเดอร์บางส่วนในคลังจะตรวจสอบได้เฉพาะเมื่อมีสิทธิ์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer uygulamaların Containers klasörleri ve bazı Kitaplık klasörleri yalnızca bununla denetlenebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише з ним можна перевірити папки Containers інших програм і деякі папки «Бібліотеки»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Containers của ứng dụng khác và một số thư mục trong Thư viện chỉ có thể kiểm tra khi có quyền này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他应用的 Containers 和部分资源库文件夹只有在获得此权限后才能检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他 App 的 Containers 和部分資源庫檔案夾只能透過此權限檢查。"
          }
        }
      }
    },

    "Restores this item to its original folder": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستعيد هذا العنصر إلى مجلده الأصلي"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt dieses Objekt in seinem ursprünglichen Ordner wieder her"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura este elemento en su carpeta original"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remet cet élément dans son dossier d'origine"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस आइटम को उसके मूल फ़ोल्डर में पुनर्स्थापित करता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memulihkan item ini ke folder aslinya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina questo elemento nella cartella originale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目を元のフォルダに復元します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목을 원래 폴더로 복원합니다"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഇനം അതിന്റെ യഥാർത്ഥ ഫോൾഡറിലേക്ക് പുനഃസ്ഥാപിക്കുന്നു"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet dit onderdeel terug in de oorspronkelijke map"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywraca tę rzecz do oryginalnego katalogu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura este item na pasta original"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстанавливает этот объект в исходную папку"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återställer objektet till dess ursprungliga mapp"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த உருப்படியை அதன் அசல் கோப்புறைக்கு மீட்டெடுக்கும்"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กู้คืนรายการนี้ไปยังโฟลเดอร์เดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu öğeyi özgün klasörüne geri yükler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновлює цей елемент у початкову папку"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục mục này về thư mục gốc"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此项目恢复到原始文件夹"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將此項目回復到原始檔案夾"
          }
        }
      }
    },

          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic pozostawionego przez narzędzia AI nie wymaga Twojej uwagi. Przeskanowano %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada deixado por ferramentas de IA requer sua atenção. Analisado %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",

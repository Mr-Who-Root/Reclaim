    "Nothing Reclaim moved is still in the Trash.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد أي شيء نقله Reclaim موجودًا في سلة المهملات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts, was Reclaim verschoben hat, liegt noch im Papierkorb."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de lo que trasladó Reclaim sigue en la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de ce que Reclaim a déplacé n'est encore dans la Corbeille."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim द्वारा ले जाया गया कुछ भी अब ट्रैश में नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada item yang dipindahkan Reclaim yang masih ada di Tong Sampah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun elemento spostato da Reclaim è ancora nel Cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim が移動した項目はゴミ箱に残っていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim이 이동한 항목 중 휴지통에 남아 있는 것이 없습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim നീക്കിയതൊന്നും ഇപ്പോൾ ട്രാഷിൽ ഇല്ല."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets wat Reclaim heeft verplaatst, staat nog in de prullenmand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic, co przeniósł Reclaim, nie znajduje się już w Koszu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada do que o Reclaim moveu ainda está no Lixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Корзине не осталось ничего из перемещенного Reclaim."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget som Reclaim flyttade finns kvar i papperskorgen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim நகர்த்தியவற்றில் எதுவும் இப்போது குப்பைத் தொட்டியில் இல்லை."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีสิ่งที่ Reclaim ย้ายไว้เหลืออยู่ในถังขยะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim'in taşıdığı hiçbir şey artık Çöp Sepetinde değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У Смітнику не залишилося нічого з переміщеного Reclaim."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không còn mục nào do Reclaim di chuyển trong Thùng rác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim 移动的项目都已不在废纸篓中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaim 移動的項目都已不在垃圾桶中。"
          }
        }
      }
    },
    "Nothing about your Mac leaves it — no analytics, no uploads": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يغادر جهاز Mac أي شيء يخصه — بلا تحليلات، بلا رفع للبيانات"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts über deinen Mac gelangt nach außen – keine Analysen, keine Uploads"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada sobre tu Mac sale de él: sin analíticas ni subidas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune information sur votre Mac n'en sort : ni statistiques, ni envois"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके Mac के बारे में कुछ भी बाहर नहीं जाता — न एनालिटिक्स, न अपलोड"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada data tentang Mac Anda yang keluar darinya — tanpa analitik, tanpa unggahan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna informazione sul Mac lascia il computer: nessuna analisi, nessun caricamento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac に関する情報が外に出ることはありません。解析もアップロードもなし"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에 관한 어떤 정보도 밖으로 나가지 않습니다 — 분석도, 업로드도 없습니다"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ Mac-നെക്കുറിച്ചുള്ള ഒന്നും പുറത്തുപോകില്ല — അനലിറ്റിക്സില്ല, അപ്‌ലോഡുകളില്ല"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets over je Mac gaat naar buiten — geen analyses, geen uploads"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadne dane o Macu nie opuszczają komputera — bez analityki, bez przesyłania danych"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada sobre o seu Mac sai dele — sem análises de uso, sem envios"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никакие данные о Вашем Mac не покидают его — без аналитики и отправки данных"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting om din Mac lämnar den – ingen analys, inga uppladdningar"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் Mac பற்றிய எதுவும் வெளியே செல்லாது — பகுப்பாய்வு இல்லை, பதிவேற்றம் இல்லை"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีข้อมูลใดเกี่ยวกับ Mac ของคุณออกไปภายนอก — ไม่มีการวิเคราะห์ ไม่มีการอัปโหลด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'inizle ilgili hiçbir şey dışarı çıkmaz — analiz yok, yükleme yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жодні дані про ваш Mac не залишають його — без аналітики й надсилання даних"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có thông tin nào về Mac của bạn rời khỏi máy — không phân tích, không tải lên"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有关你 Mac 的信息不会外传——无分析、无上传"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與您 Mac 相關的資料都不會外傳：沒有分析、沒有上傳"
          }
        }
      }
    },
    "Nothing excluded yet. Right-click any result and choose Never Suggest This.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُستثنَ أي شيء بعد. انقر بزر الماوس الأيمن على أي نتيجة واختر «عدم اقتراح هذا مجددًا»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Ausnahmen. Klicke mit der rechten Maustaste auf ein Ergebnis und wähle „Nicht mehr vorschlagen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay exclusiones. Haz clic derecho en cualquier resultado y elige «No volver a sugerir»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune exclusion pour l'instant. Cliquez avec le bouton droit sur un résultat et choisissez Ne plus suggérer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कुछ भी बाहर नहीं रखा गया है। किसी भी परिणाम पर राइट-क्लिक करें और “इसे फिर कभी न सुझाएँ” चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada yang dikecualikan. Klik kanan hasil mana pun lalu pilih Jangan Sarankan Lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna esclusione. Fai clic con il tasto destro su un risultato e scegli “Non suggerire più”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ何も除外されていません。結果を右クリックして「今後提案しない」を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 제외된 항목이 없습니다. 결과를 오른쪽 클릭하고 ‘다시 제안하지 않음’을 선택하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതുവരെ ഒന്നും ഒഴിവാക്കിയിട്ടില്ല. ഏതെങ്കിലും ഫലത്തിൽ റൈറ്റ്-ക്ലിക്ക് ചെയ്ത് “ഇത് ഇനി നിർദ്ദേശിക്കരുത്” തിരഞ്ഞെടുക്കുക."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niets uitgesloten. Klik met de rechtermuisknop op een resultaat en kies ‘Stel niet meer voor’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic jeszcze nie wykluczono. Kliknij prawym przyciskiem dowolny wynik i wybierz Nie sugeruj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma exceção ainda. Clique com o botão direito em qualquer resultado e escolha Não Sugerir Mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока ничего не исключено. Нажмите любой результат правой кнопкой мыши и выберите «Больше не предлагать»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga undantag än. Högerklicka på ett resultat och välj Föreslå inte igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இதுவரை எதுவும் விலக்கப்படவில்லை. ஏதேனும் ஒரு முடிவை வலது-கிளிக் செய்து “இதை இனி பரிந்துரைக்க வேண்டாம்” என்பதைத் தேர்வுசெய்யவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีรายการที่ยกเว้น คลิกขวาที่ผลลัพธ์ใดก็ได้แล้วเลือก “ไม่ต้องแนะนำรายการนี้อีก”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz hiçbir şey hariç tutulmadı. Herhangi bir sonucu sağ tıklayıp Bunu Bir Daha Önerme'yi seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки нічого не виключено. Клацніть будь-який результат правою кнопкою й виберіть «Більше не пропонувати»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa loại trừ mục nào. Bấm chuột phải vào kết quả bất kỳ và chọn “Không đề xuất mục này nữa”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未排除任何内容。右键点按任意结果并选择“不再建议此项”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未排除任何項目。在任一結果上按右鍵並選擇「不再建議此項目」。"
          }
        }
      }
    },
    "Nothing has been removed. Open a tool to review its results.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتم إزالة أي شيء. افتح أداة لمراجعة نتائجها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde nichts entfernt. Öffne ein Werkzeug, um seine Ergebnisse zu prüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha eliminado nada. Abre una herramienta para revisar sus resultados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'a été supprimé. Ouvrez un outil pour examiner ses résultats."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी हटाया नहीं गया है। किसी टूल के परिणामों की समीक्षा करने के लिए उसे खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang dihapus. Buka alat untuk meninjau hasilnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato rimosso nulla. Apri uno strumento per esaminarne i risultati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ何も削除されていません。ツールを開いて結果を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 제거되지 않았습니다. 도구를 열어 결과를 검토하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒന്നും നീക്കം ചെയ്തിട്ടില്ല. ഒരു ടൂളിന്റെ ഫലങ്ങൾ അവലോകനം ചെയ്യാൻ അത് തുറക്കുക."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is niets verwijderd. Open een tool om de resultaten te beoordelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie zostało usunięte. Otwórz narzędzie, aby przejrzeć jego wyniki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi removido. Abra uma ferramenta para revisar os resultados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не удалено. Откройте инструмент, чтобы просмотреть его результаты."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget har tagits bort. Öppna ett verktyg för att granska resultaten."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எதுவும் அகற்றப்படவில்லை. ஒரு கருவியின் முடிவுகளை மதிப்பாய்வு செய்ய அதைத் திறக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีสิ่งใดถูกเอาออก เปิดเครื่องมือเพื่อตรวจทานผลลัพธ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey kaldırılmadı. Sonuçlarını incelemek için bir araç açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не видалено. Відкрийте інструмент, щоб переглянути його результати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có gì bị gỡ bỏ. Hãy mở một công cụ để xem lại kết quả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未移除任何内容。打开某个工具以审阅其结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未移除任何項目。打開工具即可檢閱其結果。"
          }
        }
      }
    },
    "Nothing in Downloads fits “%@”. Try another filter.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد في التنزيلات ما يطابق «%@». جرّب عامل تصفية آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts in Downloads passt zu „%@“. Probiere einen anderen Filter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada en Descargas coincide con «%@». Prueba con otro filtro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien dans Téléchargements ne correspond à « %@ ». Essayez un autre filtre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डाउनलोड में कुछ भी “%@” से मेल नहीं खाता। कोई दूसरा फ़िल्टर आज़माएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada di Unduhan yang cocok dengan “%@”. Coba filter lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente in Download corrisponde a “%@”. Prova un altro filtro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードフォルダに「%@」に該当する項目はありません。別のフィルタを試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드에 ‘%@’와(과) 일치하는 항목이 없습니다. 다른 필터를 사용해 보세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഡൗൺലോഡുകളിൽ “%@” എന്നതിന് യോജിക്കുന്നതൊന്നുമില്ല. മറ്റൊരു ഫിൽട്ടർ പരീക്ഷിക്കുക."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets in Downloads past bij ‘%@’. Probeer een ander filter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic w katalogu Pobrane rzeczy nie pasuje do filtra „%@”. Wypróbuj inny filtr."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada em Downloads corresponde a “%@”. Tente outro filtro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В папке «Загрузки» нет ничего для фильтра «%@». Попробуйте другой фильтр."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget i Hämtade filer matchar ”%@”. Prova ett annat filter."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிவிறக்கங்களில் “%@” க்குப் பொருந்துவது எதுவும் இல்லை. வேறு வடிப்பானை முயலவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีสิ่งใดในดาวน์โหลดที่ตรงกับ “%@” ลองใช้ตัวกรองอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilenler klasöründe “%@” ile eşleşen bir şey yok. Başka bir filtre deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У папці «Викачане» немає нічого для фільтра «%@». Спробуйте інший фільтр."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì trong Tải về khớp với “%@”. Hãy thử bộ lọc khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“下载”中没有符合“%@”的项目。请尝试其他筛选条件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「下載項目」中沒有符合「%@」的項目。請嘗試其他篩選條件。"
          }
        }
      }
    },
    "Nothing in your plan yet": {
      "localizations": {
        "ar": {
          "stringUnit": {

        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートの準備ファイルや作業出力など、Claude または Claude Code の一時ファイルです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트 준비 파일이나 임시 출력 등 Claude 또는 Claude Code의 임시 파일입니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അപ്‌ഡേറ്റ് സ്റ്റേജിംഗ്, സ്ക്രാച്ച് ഔട്ട്‌പുട്ട് പോലുള്ള, Claude-ൽ നിന്നോ Claude Code-ൽ നിന്നോ ഉള്ള താൽക്കാലിക ഫയലുകൾ."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdelijke bestanden van Claude of Claude Code, zoals klaargezette updates en kladuitvoer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki tymczasowe z Claude lub Claude Code, takie jak pliki przygotowania uaktualnień i robocze wyniki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos temporários do Claude ou do Claude Code, como preparação de atualizações e saída de rascunho."
          }
        },
        "ru": {
          "stringUnit": {

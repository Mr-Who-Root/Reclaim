            "state": "translated",
            "value": "Mac を確認しています。何も変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac을 확인하는 중입니다. 아무것도 변경되지 않습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ Mac പരിശോധിക്കുന്നു. ഒന്നും മാറ്റുന്നില്ല."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Mac wordt gecontroleerd. Er wordt niets gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzanie Maca. Nic nie jest zmieniane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificando o Mac. Nada está sendo alterado."
          }
        },
        "ru": {

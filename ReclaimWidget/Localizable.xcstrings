    "Free space, what the last scan found, and a one-click Smart Scan.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المساحة المتاحة، وما وجده آخر فحص، والفحص الذكي بنقرة واحدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freier Speicher, die Funde des letzten Scans und Smart Scan mit einem Klick."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espacio libre, lo que encontró el último análisis y un Análisis inteligente con un clic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'espace libre, les résultats de la dernière analyse et l'analyse intelligente en un clic."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ख़ाली जगह, पिछले स्कैन में क्या मिला, और एक क्लिक में स्मार्ट स्कैन।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruang kosong, temuan pemindaian terakhir, dan Pindai Cerdas sekali klik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio libero, i risultati dell'ultima scansione e la scansione intelligente con un clic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空き容量、前回のスキャン結果、ワンクリックのスマートスキャン。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여유 공간, 마지막 스캔 결과, 원클릭 스마트 스캔."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒഴിവുള്ള സ്ഥലം, അവസാന സ്കാനിൽ കണ്ടെത്തിയത്, ഒറ്റ ക്ലിക്കിൽ സ്മാർട്ട് സ്കാൻ."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrije ruimte, wat de laatste scan vond en Smart Scan met één klik."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wolne miejsce, wyniki ostatniego skanowania i inteligentne skanowanie jednym kliknięciem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espaço livre, o que a última análise encontrou e a Análise Inteligente com um clique."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свободное место, находки последнего сканирования и умное сканирование в один клик."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ledigt utrymme, vad den senaste skanningen hittade och Smart Scan med ett klick."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காலி இடம், கடைசி ஸ்கேனில் கண்டறிந்தவை, ஒரே கிளிக்கில் ஸ்மார்ட் ஸ்கேன்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นที่ว่าง สิ่งที่พบจากการสแกนล่าสุด และสแกนอัจฉริยะในคลิกเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boş alan, son taramanın bulguları ve tek tıkla Akıllı Tarama."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вільне місце, знахідки останнього сканування й розумне сканування в один клік."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dung lượng trống, kết quả lần quét gần nhất và Quét thông minh chỉ với một cú nhấp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用空间、上次扫描的发现，以及一键智能扫描。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可用空間、上次掃描的結果，以及一鍵智慧型掃描。"
          }
        }
      }
    },

    "Nothing to reclaim": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء لاستعادته"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts freizugeben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada que recuperar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à récupérer"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वापस पाने को कुछ नहीं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang perlu dikosongkan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente da recuperare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解放できる容量はありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확보할 공간 없음"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വീണ്ടെടുക്കാൻ ഒന്നുമില്ല"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets vrij te maken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic do odzyskania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada para recuperar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нечего освобождать"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget att frigöra"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீட்டெடுக்க எதுவும் இல்லை"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีพื้นที่ให้เรียกคืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri kazanılacak bir şey yok"
          }
        },
        "uk": {
